+static PrototypePieces conventionSignature(Architecture *arch) {
+  PrototypePieces signature;
+  signature.model = arch->defaultfp;
+  signature.outtype = arch->types->getBase(2,TYPE_UINT,"PresenceWord");
+  signature.intypes.push_back(signature.outtype);
+  signature.innames.push_back("input");
+  signature.firstVarArgSlot = -1;
+  return signature;
+}
+
+TEST(callback_convention_presence_identity) {
+  IdentityEnvironment env;
+  TypeFactory *factory = env.arch->types;
+  PrototypePieces signature = conventionSignature(env.arch);
+  TypeCode *absent = factory->getTypeCode(signature);
+  signature.modelDeclared = true;
+  TypeCode *declared = factory->getTypeCode(signature);
+  ASSERT_NOT_EQUALS(absent,declared);
+  ASSERT_NOT_EQUALS(absent->compareBasic(declared),0);
+  ASSERT_NOT_EQUALS(absent->compareDependency(*declared),0);
+  ASSERT_EQUALS(absent->getPrototype()->isModelDeclared(),false);
+  ASSERT_EQUALS(declared->getPrototype()->isModelDeclared(),true);
+  ASSERT_EQUALS(absent->getPrototype()->isModelLocked(),declared->getPrototype()->isModelLocked());
+  ASSERT_EQUALS(absent->getPrototype()->isInputLocked(),declared->getPrototype()->isInputLocked());
+  ASSERT_EQUALS(absent->getPrototype()->isOutputLocked(),declared->getPrototype()->isOutputLocked());
+  ASSERT_EQUALS(absent->getPrototype()->getParam(0)->getAddress(),declared->getPrototype()->getParam(0)->getAddress());
+  ASSERT(absent->getPrototype()->isCompatible(*declared->getPrototype()));
+  ASSERT(declared->getPrototype()->isCompatible(*absent->getPrototype()));
+  PrototypePieces recovered;
+  declared->getPrototype()->getPieces(recovered);
+  ASSERT(recovered.modelDeclared);
+  ASSERT_EQUALS(factory->getTypeCode(recovered),declared);
+  FuncProto copy;
+  copy.copy(*declared->getPrototype());
+  ASSERT(copy.isModelDeclared());
+  signature.modelDeclared = false;
+  copy.setPieces(signature);
+  ASSERT_EQUALS(copy.isModelDeclared(),false);
+  copy.setModelLock(false);
+  copy.setInputLock(true);
+  copy.setOutputLock(true);
+  ASSERT_EQUALS(copy.isModelDeclared(),false);
+  ASSERT(copy.isModelLocked());
+}
