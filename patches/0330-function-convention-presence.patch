+template<typename Encode,typename Decode> static void conventionPresenceRoundTrip(void) {
+  IdentityEnvironment source;
+  TypeFactory *factory = source.arch->types;
+  PrototypePieces signature = conventionSignature(source.arch);
+  vector<TypeCode *> cases = {factory->getTypeCode(signature)};
+  signature.modelDeclared = true;
+  cases.push_back(factory->getTypeCode(signature));
+  signature.model = source.arch->getModel("__cdecl16far");
+  cases.push_back(factory->getTypeCode(signature));
+  signature.modelDeclared = false;
+  cases.push_back(factory->getTypeCode(signature));
+  signature.modelDeclared = true;
+  cases.push_back(factory->getTypeCode(signature,"PresenceCallback",701));
+  cases.push_back((TypeCode *)factory->getTypedef(cases[4],"PresenceAlias",702,0));
+  Datatype *qualified = factory->getQualifiedType(factory->getTypePointer(4,cases[2],1),Datatype::qualifier_const);
+  ostringstream output;
+  Encode encoder(output);
+  encoder.openElement(ELEM_DATA);
+  factory->encode(encoder);
+  for(TypeCode *code : cases)
+    code->encodeRef(encoder);
+  qualified->encodeRef(encoder);
+  encoder.closeElement(ELEM_DATA);
+  IdentityEnvironment restored;
+  TypeFactory *target = restored.arch->types;
+  istringstream input(output.str());
+  Decode decoder(restored.arch);
+  decoder.ingestStream(input);
+  uint4 data = decoder.openElement(ELEM_DATA);
+  target->decode(decoder);
+  vector<TypeCode *> actual;
+  for(TypeCode *code : cases) {
+    TypeCode *result = (TypeCode *)target->decodeType(decoder);
+    actual.push_back(result);
+    ASSERT_EQUALS(result->getName(),code->getName());
+    ASSERT_EQUALS(result->getId(),code->getId());
+    const FuncProto *prototype = result->getPrototype();
+    const FuncProto *original = code->getPrototype();
+    ASSERT_EQUALS(prototype->isModelDeclared(),original->isModelDeclared());
+    ASSERT_EQUALS(prototype->getModelName(),original->getModelName());
+    ASSERT_EQUALS(prototype->isModelLocked(),original->isModelLocked());
+    ASSERT_EQUALS(prototype->isInputLocked(),original->isInputLocked());
+    ASSERT_EQUALS(prototype->isOutputLocked(),original->isOutputLocked());
+    ASSERT_EQUALS(prototype->getParam(0)->getAddress().getOffset(),original->getParam(0)->getAddress().getOffset());
+    PrototypePieces recovered;
+    prototype->getPieces(recovered);
+    ASSERT_EQUALS(target->getTypeCode(recovered)->getPrototype()->isModelDeclared(),original->isModelDeclared());
+  }
+  Datatype *restoredQualified = target->decodeType(decoder);
+  decoder.closeElement(data);
+  ASSERT_NOT_EQUALS(actual[0],actual[1]);
+  ASSERT_NOT_EQUALS(actual[2],actual[3]);
+  ASSERT(actual[0]->getPrototype()->isCompatible(*actual[1]->getPrototype()));
+  ASSERT(actual[2]->getPrototype()->isCompatible(*actual[3]->getPrototype()));
+  ASSERT_EQUALS(actual[2]->getPrototype()->getParam(0)->getAddress().getOffset(),4);
+  ASSERT_EQUALS(actual[5]->getTypedef(),actual[4]);
+  ASSERT(restoredQualified->isConst());
+  ASSERT_EQUALS(((TypePointer *)restoredQualified)->getPtrTo(),actual[2]);
+}
+
+TEST(callback_convention_presence_xml_roundtrip) { conventionPresenceRoundTrip<XmlEncode,XmlDecode>(); }
+TEST(callback_convention_presence_packed_roundtrip) { conventionPresenceRoundTrip<PackedEncode,PackedDecode>(); }
