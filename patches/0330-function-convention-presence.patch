+TEST(callback_convention_presence_rendering) {
+  IdentityEnvironment env;
+  TypeFactory *factory = env.arch->types;
+  PrototypePieces signature = conventionSignature(env.arch);
+  TypeCode *absent = factory->getTypeCode(signature);
+  signature.modelDeclared = true;
+  TypeCode *declared = factory->getTypeCode(signature);
+  AttributeIdentityPrinter printer(env.arch);
+  printer.setMaxLineSize(200);
+  printer.setConvention(true);
+  ASSERT_EQUALS(printer.declaration(factory->getTypePointer(2,absent,1)),"PresenceWord (*value)(PresenceWord)");
+  ASSERT_EQUALS(printer.declaration(factory->getTypePointer(2,declared,1)),"PresenceWord (__attribute__((r2_cc(\"__stdcall16near\"))) *value)(PresenceWord)");
+  ASSERT_EQUALS(printer.declaration(declared),"PresenceWord __attribute__((r2_cc(\"__stdcall16near\"))) value(PresenceWord)");
+  signature.model = env.arch->getModel("__cdecl16far");
+  signature.modelDeclared = false;
+  ASSERT_EQUALS(printer.declaration(factory->getTypePointer(4,factory->getTypeCode(signature),1)),"PresenceWord (*value)(PresenceWord)");
+}
