+TEST(callback_convention_presence_native_parser) {
+  IdentityEnvironment env;
+  PrototypePieces absent;
+  istringstream absentInput("void ordinary(void);");
+  parse_protopieces(absent,absentInput,env.arch);
+  PrototypePieces declared;
+  istringstream declaredInput("void __stdcall16near supplied(void);");
+  parse_protopieces(declared,declaredInput,env.arch);
+  ASSERT_EQUALS(absent.model,declared.model);
+  ASSERT_EQUALS(absent.modelDeclared,false);
+  ASSERT(declared.modelDeclared);
+  string name;
+  istringstream callbackInput("void __stdcall16near (*callback)(void)");
+  TypePointer *callback = (TypePointer *)parse_type(callbackInput,name,env.arch);
+  ASSERT_EQUALS(callback->getMetatype(),TYPE_PTR);
+  ASSERT(((TypeCode *)callback->getPtrTo())->getPrototype()->isModelDeclared());
+}
