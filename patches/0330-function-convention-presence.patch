+class AttributeIdentityPrinter : public IdentityPrinter {
+protected:
+  virtual void emitTypeModel(const FuncProto *prototype) {
+    if (!option_convention || !prototype->isModelDeclared()) return;
+    emit->print("__attribute__((r2_cc(\"" + prototype->getModelName() + "\")))",Emit::keyword_color);
+    emit->spaces(1);
+  }
+public:
+  AttributeIdentityPrinter(Architecture *arch) : IdentityPrinter(arch) {}
+};
