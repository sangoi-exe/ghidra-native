+static ParameterPieces installHiddenReturn(SegmentedEnvironment &env,bool fixed,bool sourceInput = false) {
+  TypeFactory *factory = env.arch->types;
+  Datatype *word = factory->getBase(8,TYPE_UINT);
+  TypeStruct *big = factory->getTypeStruct("Big");
+  factory->setFields({TypeField(0,0,"words",factory->getTypeArray(3,word))},{},big,24,8,0);
+  PrototypePieces signature;
+  signature.model = env.arch->defaultfp;
+  signature.outtype = big;
+  signature.firstVarArgSlot = -1;
+  if (sourceInput) {
+    signature.intypes.push_back(word);
+    signature.innames.push_back("value");
+  }
+  vector<ParameterPieces> pieces;
+  signature.model->assignParameterStorage(signature,pieces,false);
+  ASSERT_EQUALS(pieces.size(),sourceInput ? 3 : 2);
+  ASSERT((pieces[0].flags & ParameterPieces::indirectstorage) != 0);
+  ASSERT((pieces[1].flags & ParameterPieces::hiddenretparm) != 0);
+  ASSERT((pieces[1].flags & ParameterPieces::typelock) == 0);
+  ASSERT_EQUALS(pieces[1].addr,env.arch->translate->getRegister("RDI").getAddr());
+  ASSERT_EQUALS(pieces[1].type->getMetatype(),TYPE_PTR);
+  ASSERT_EQUALS(((TypePointer *)pieces[1].type)->getPtrTo(),big);
+  FuncProto &prototype = env.fd->getFuncProto();
+  if (fixed)
+    prototype.setPieces(signature);
+  else {
+    prototype.setModel(signature.model);
+    prototype.setOutput(pieces[0]);
+    prototype.setOutputLock(true);
+    prototype.setParam(0,"rethidden",pieces[1]);
+  }
+  ASSERT_EQUALS(prototype.isInputLocked(),fixed);
+  return pieces[1];
+}
+
+static void assertHiddenReturn(SegmentedEnvironment &env,const ParameterPieces &expected,bool fixed) {
+  FuncProto &prototype = env.fd->getFuncProto();
+  ASSERT(prototype.isOutputLocked());
+  ASSERT_EQUALS(prototype.isInputLocked(),fixed);
+  ASSERT(!prototype.isDotdotdot());
+  ASSERT(prototype.numParams() >= 1);
+  ProtoParameter *hidden = prototype.getParam(0);
+  ASSERT(hidden->isHiddenReturn());
+  ASSERT_EQUALS(hidden->getType(),expected.type);
+  ASSERT_EQUALS(hidden->getAddress(),expected.addr);
+  ASSERT_EQUALS(hidden->isTypeLocked(),fixed);
+  Varnode *input = env.fd->findVarnodeInput(expected.type->getSize(),expected.addr);
+  ASSERT(input != (Varnode *)0);
+  ASSERT(input->isLockedInput());
+  ASSERT_EQUALS(input->getType(),expected.type);
+}
+
+static void checkHiddenReturnRecovery(const string &bytes,bool fixed,bool sourceInput) {
+  SegmentedEnvironment env(false,"x86:LE:64:default:gcc",bytes);
+  ParameterPieces hidden = installHiddenReturn(env,fixed,fixed && sourceInput);
+  env.arch->allacts.getCurrent()->reset(*env.fd);
+  ASSERT(env.arch->allacts.getCurrent()->perform(*env.fd) >= 0);
+  assertHiddenReturn(env,hidden,fixed);
+  FuncProto &prototype = env.fd->getFuncProto();
+  ASSERT_EQUALS(prototype.numParams(),sourceInput ? 2 : 1);
+  if (sourceInput) {
+    ProtoParameter *source = prototype.getParam(1);
+    ASSERT(!source->isHiddenReturn());
+    ASSERT_EQUALS(source->getAddress(),env.arch->translate->getRegister("RSI").getAddr());
+    ASSERT_EQUALS(source->getSize(),8);
+    ASSERT_EQUALS(source->isTypeLocked(),fixed);
+    if (fixed)
+      ASSERT_EQUALS(source->getName(),"value");
+  }
+}
+
+TEST(open_hidden_return_recovery) {
+  checkHiddenReturnRecovery("48c7070100000048c747080200000048c74710030000004889f8c3",false,false);
+  checkHiddenReturnRecovery("c3",false,false);
+  checkHiddenReturnRecovery("4889374889f8c3",false,true);
+}
+
+TEST(fixed_hidden_return_recovery) {
+  checkHiddenReturnRecovery("c3",true,false);
+  checkHiddenReturnRecovery("4889374889f8c3",true,true);
+}
+
+TEST(open_hidden_return_without_type_recovery) {
+  SegmentedEnvironment env(true,"x86:LE:64:default:gcc","c3",false);
+  ParameterPieces hidden = installHiddenReturn(env,false);
+  FuncProto &prototype = env.fd->getFuncProto();
+  ParameterPieces hint;
+  hint.addr = env.arch->translate->getRegister("RSI").getAddr();
+  hint.type = env.arch->types->getBase(8,TYPE_UINT);
+  hint.flags = 0;
+  prototype.setParam(1,"old_hint",hint);
+  prototype.clearUnlockedInput();
+  ASSERT_EQUALS(prototype.numParams(),1);
+  ASSERT(prototype.getParam(0)->isHiddenReturn());
+  Varnode *source = env.fd->newVarnode(8,hint.addr);
+  source = env.fd->setInputVarnode(source);
+  env.op(CPUI_COPY,{source},env.arch->types->getBase(8,TYPE_UNKNOWN));
+  ActionPrototypeTypes force("hidden-return-test");
+  ASSERT_EQUALS(force.apply(*env.fd),0);
+  ActionInputPrototype recover("hidden-return-test");
+  ASSERT_EQUALS(recover.apply(*env.fd),0);
+  ASSERT(!env.fd->isHighOn());
+  assertHiddenReturn(env,hidden,false);
+  ASSERT_EQUALS(prototype.numParams(),2);
+  ASSERT_EQUALS(prototype.getParam(1)->getAddress(),hint.addr);
+  ASSERT_EQUALS(prototype.getParam(1)->getType()->getMetatype(),TYPE_UNKNOWN);
+  prototype.setOutputLock(false);
+  prototype.clearUnlockedInput();
+  ASSERT_EQUALS(prototype.numParams(),0);
+}

