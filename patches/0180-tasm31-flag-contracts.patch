+// Source-qualified RF08/TI04 storage/effects, separate from the decoded-body/caller tests below.
+static void checkTasm31Prototypes(const string &language)
+
+{
+  SegmentedEnvironment::initialize();
+  istringstream image("<binaryimage arch=\"x86:LE:16:" + language + ":default\"><bytechunk space=\"ram\" offset=\"0x1000\" readonly=\"true\">c3</bytechunk></binaryimage>");
+  DocumentStorage store;
+  Document *doc = store.parseDocument(image);
+  store.registerTag(doc->getRoot());
+  unique_ptr<Architecture> arch(ArchitectureCapability::getCapability("xml")->buildArchitecture("", "", &cout));
+  arch->init(store);
+  Datatype *byte = arch->types->getBase(1,TYPE_UINT);
+  Datatype *word = arch->types->getBase(2,TYPE_UINT);
+  Datatype *signState = qualifiedRecord(arch.get(),"Tasm31SignExtensionState5",5,{TypeField(0,0,"reject_cf",byte),TypeField(1,1,"ax",word),TypeField(2,3,"dx",word)});
+  Datatype *currentState = qualifiedRecord(arch.get(),"Tasm31CurrentState2",2,{TypeField(0,0,"zero_zf",byte),TypeField(1,1,"al",byte)});
+  Datatype *paddingState = qualifiedRecord(arch.get(),"Tasm31PaddingState5",5,{TypeField(0,0,"zero_zf",byte),TypeField(1,1,"ds",word),TypeField(2,3,"es",word)});
+  QualifiedPrototype sign(arch.get(),"tasm31_sign_extension_state_16near",2,signState,{word,word,word,word});
+  sign.expectRegister(1,"AX");
+  sign.expectRegister(2,"DX");
+  sign.expectRegister(3,"DS");
+  sign.expectRegister(4,"ES");
+  sign.expectJoin(0,{"DX","AX","CF"});
+  sign.expectEffects({"BX","CX","SP","BP","SI","DI","DS","ES","SS","CS","DF"},{"AX","DX","CF","PF","AF","ZF","SF","OF"});
+  QualifiedPrototype current(arch.get(),"tasm31_current_state_16near",2,currentState,{byte,word});
+  current.expectRegister(1,"AL");
+  current.expectRegister(2,"DS");
+  current.expectJoin(0,{"AL","ZF"});
+  current.expectEffects({"AH","BX","CX","DX","SP","BP","SI","DI","DS","ES","SS","CS","DF"},{"AL","CF","PF","AF","ZF","SF","OF"});
+  QualifiedPrototype padding(arch.get(),"tasm31_padding_state_16near",2,paddingState,{word,word});
+  padding.expectRegister(1,"DS");
+  padding.expectRegister(2,"ES");
+  padding.expectJoin(0,{"ES","DS","ZF"});
+  padding.expectEffects({"BX","CX","DX","SP"},{"AL","CF","PF","AF","ZF","SF","OF"});
+  QualifiedPrototype leaf(arch.get(),"tasm31_conditional_store_16far",4,arch->types->getTypeVoid(),{word});
+  leaf.expectRegister(1,"DS");
+  leaf.expectEffects({"AX","BX","CX","DX","SP","BP","SI","DI","DS","ES","SS","CS","DF"},{"CF","PF","AF","ZF","SF","OF"});
+  ProtoModel *model = arch->getModel("tasm31_padding_state_16near");
+  for(const char *name : {"AH","SI","BP","DI","DS","ES","SS","CS","DF"}) {
+    const VarnodeData &reg(arch->translate->getRegister(name));
+    ASSERT_EQUALS(model->hasEffect(reg.getAddr(),reg.size),EffectRecord::unknown_effect);
+  }
+}
+
+TEST(tasm31_prototypes_protected) {
+  checkTasm31Prototypes("Protected Mode");
+}
+
+TEST(tasm31_prototypes_real) {
+  checkTasm31Prototypes("Real Mode");
+}
