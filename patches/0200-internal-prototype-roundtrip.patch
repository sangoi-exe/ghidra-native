+
+static void assertInternalParameterRoundTrip(const ProtoParameter *expected,const ProtoParameter *actual) {
+  ASSERT_EQUALS(actual->getName(),expected->getName());
+  ASSERT_EQUALS(actual->getType()->getName(),expected->getType()->getName());
+  ASSERT_EQUALS(actual->getType()->getSize(),expected->getType()->getSize());
+  ASSERT_EQUALS(actual->getType()->getMetatype(),expected->getType()->getMetatype());
+  ASSERT_EQUALS(actual->isTypeLocked(),expected->isTypeLocked());
+  ASSERT_EQUALS(actual->isNameLocked(),expected->isNameLocked());
+  ASSERT_EQUALS(actual->isThisPointer(),expected->isThisPointer());
+  ASSERT_EQUALS(actual->isIndirectStorage(),expected->isIndirectStorage());
+  ASSERT_EQUALS(actual->isHiddenReturn(),expected->isHiddenReturn());
+  Address expectedAddress = expected->getAddress();
+  Address actualAddress = actual->getAddress();
+  ASSERT_EQUALS(actualAddress.isInvalid(),expectedAddress.isInvalid());
+  if (!expectedAddress.isInvalid()) {
+    ASSERT_EQUALS(actualAddress.getSpace()->getName(),expectedAddress.getSpace()->getName());
+    ASSERT_EQUALS(actualAddress.getOffset(),expectedAddress.getOffset());
+  }
+}
+
+static void assertInternalPrototypeRoundTrip(const Datatype *original) {
+  SegmentedEnvironment restored;
+  ASSERT_EQUALS(original->getId(),0);
+  ostringstream output;
+  XmlEncode encoder(output);
+  original->encodeRef(encoder);
+  istringstream input(output.str());
+  XmlDecode decoder(restored.arch);
+  decoder.ingestStream(input);
+  Datatype *decoded = restored.arch->types->decodeType(decoder);
+  ASSERT_EQUALS(decoded->getMetatype(),original->getMetatype());
+  ASSERT_EQUALS(decoded->getSize(),original->getSize());
+  if (original->getMetatype() == TYPE_PTR) {
+    const TypePointer *expectedPointer = (const TypePointer *)original;
+    const TypePointer *actualPointer = (const TypePointer *)decoded;
+    ASSERT_EQUALS(actualPointer->getWordSize(),expectedPointer->getWordSize());
+    original = expectedPointer->getPtrTo();
+    decoded = actualPointer->getPtrTo();
+  }
+  ASSERT_EQUALS(original->getId(),0);
+  ASSERT_EQUALS(original->getMetatype(),TYPE_CODE);
+  ASSERT_EQUALS(decoded->getMetatype(),TYPE_CODE);
+  const FuncProto *expected = ((const TypeCode *)original)->getPrototype();
+  const FuncProto *actual = ((const TypeCode *)decoded)->getPrototype();
+  ASSERT_EQUALS(actual->numParams(),expected->numParams());
+  ASSERT(actual->hasMatchingModel(restored.arch->getModel(expected->getModelName())));
+  ASSERT_EQUALS(actual->getExtraPop(),expected->getExtraPop());
+  ASSERT_EQUALS(actual->isModelLocked(),expected->isModelLocked());
+  ASSERT_EQUALS(actual->isInputLocked(),expected->isInputLocked());
+  ASSERT_EQUALS(actual->isOutputLocked(),expected->isOutputLocked());
+  assertInternalParameterRoundTrip(expected->getOutput(),actual->getOutput());
+  for(int4 i=0;i<expected->numParams();++i)
+    assertInternalParameterRoundTrip(expected->getParam(i),actual->getParam(i));
+  ASSERT(output.str().find("<returnsym") != string::npos);
+  ASSERT(output.str().find("<retparam") == string::npos);
+}
+
+TEST(internal_prototype_roundtrip) {
+  SegmentedEnvironment env;
+  TypeFactory *factory = env.arch->types;
+  PrototypePieces signature;
+  signature.model = env.arch->getModel("__cdecl16near");
+  signature.outtype = factory->getBase(2,TYPE_INT);
+  signature.intypes.push_back(signature.outtype);
+  signature.innames.push_back("value");
+  signature.firstVarArgSlot = -1;
+  TypeCode *function = factory->getTypeCode(signature);
+  function->getPrototype()->getParam(0)->setNameLock(true);
+  assertInternalPrototypeRoundTrip(function);
+  assertInternalPrototypeRoundTrip(factory->getTypePointer(2,function,1));
+
+  signature.intypes.push_back(factory->getBase(1,TYPE_UINT));
+  signature.innames.push_back("mode");
+  function = factory->getTypeCode(signature);
+  function->getPrototype()->getParam(0)->setNameLock(true);
+  function->getPrototype()->getParam(1)->setTypeLock(false);
+  assertInternalPrototypeRoundTrip(function);
+  assertInternalPrototypeRoundTrip(factory->getTypePointer(4,function,1));
+
+  signature.intypes.clear();
+  signature.innames.clear();
+  function = factory->getTypeCode(signature);
+  assertInternalPrototypeRoundTrip(function);
+  assertInternalPrototypeRoundTrip(factory->getTypePointer(2,function,1));
 }

