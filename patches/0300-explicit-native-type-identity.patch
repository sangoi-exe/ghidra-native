+template<typename Encode,typename Decode> static void identityCodecRoundTrip(void) {
+  IdentityEnvironment source;
+  IdentityTypes types(source.arch);
+  IdentityEnvironment restored;
+  TypeFactory *target = restored.arch->types;
+  vector<Datatype *> actual;
+  for(int4 phase=0;phase<2;++phase) {
+    if (phase == 1)
+      types.complete();
+    ostringstream output;
+    Encode encoder(output);
+    encoder.openElement(ELEM_DATA);
+    types.factory->encode(encoder);
+    for(Datatype *type : types.cases) {
+      type->encodeRef(encoder);
+      type->encode(encoder);
+    }
+    encoder.closeElement(ELEM_DATA);
+    istringstream input(output.str());
+    Decode decoder(restored.arch);
+    decoder.ingestStream(input);
+    uint4 data = decoder.openElement(ELEM_DATA);
+    target->decode(decoder);
+    for(uint4 i=0;i<types.cases.size();++i) {
+      Datatype *type = types.cases[i];
+      Datatype *result = target->decodeType(decoder);
+      Datatype *definition = target->decodeType(decoder);
+      ASSERT_EQUALS(definition,result);
+      if (phase == 0)
+        actual.push_back(result);
+      else
+        ASSERT_EQUALS(actual[i],result);
+      ASSERT_EQUALS(result->getName(),type->getName());
+      ASSERT_EQUALS(result->getId(),type->getId());
+      ASSERT_EQUALS(result->getMetatype(),type->getMetatype());
+      ASSERT_EQUALS(result->getDisplayName(),type->getDisplayName());
+      ASSERT_EQUALS(result->getQualifiers(),type->getQualifiers());
+      ASSERT_EQUALS(result->getSize(),type->getSize());
+      ASSERT_EQUALS(result->isIncomplete(),type->isIncomplete());
+      IdentityPrinter originalPrinter(source.arch);
+      IdentityPrinter restoredPrinter(restored.arch);
+      ASSERT_EQUALS(restoredPrinter.declaration(result),originalPrinter.declaration(type));
+    }
+    decoder.closeElement(data);
+    ASSERT_EQUALS(actual[1]->getTypedef(),actual[0]);
+    ASSERT_EQUALS(actual[3]->getUnqualified(),actual[2]);
+    ASSERT_EQUALS(actual[4]->getTypedef(),actual[3]);
+    ASSERT_EQUALS(actual[5]->getUnqualified(),actual[4]);
+    ASSERT_EQUALS(actual[9]->getTypedef(),actual[8]);
+    ASSERT_EQUALS(actual[12]->getUnqualified(),actual[11]);
+    ASSERT(((TypeEnum *)actual[11])->hasNamedValue(1));
+    ASSERT_EQUALS(actual[15]->getTypedef(),actual[13]);
+    for(int4 i : {13,14,15}) {
+      const FuncProto *prototype = ((TypeCode *)actual[i])->getPrototype();
+      ASSERT_EQUALS(prototype->getModelName(),i == 14 ? "__stdcall16near" : "__cdecl16far");
+      ASSERT_EQUALS(prototype->numParams(),1);
+      ASSERT_EQUALS(prototype->getOutputType(),actual[0]);
+      ASSERT_EQUALS(((TypePointer *)prototype->getParam(0)->getType())->getPtrTo(),actual[3]);
+      ASSERT_EQUALS(prototype->getParam(0)->getAddress().getOffset(),i == 14 ? 2 : 4);
+    }
+  }
+  ASSERT_EQUALS(actual[2]->getDisplayName(),"struct Alias");
+  ASSERT_EQUALS(((TypePointer *)actual[2]->getDepend(1))->getPtrTo(),actual[3]);
+}
