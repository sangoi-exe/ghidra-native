+TEST(explicit_native_identity_xml_roundtrip) { identityCodecRoundTrip<XmlEncode,XmlDecode>(); }
+TEST(explicit_native_identity_packed_roundtrip) { identityCodecRoundTrip<PackedEncode,PackedDecode>(); }
+
+template<typename Encode,typename Decode> static void typedefLabelRoundTrip(void) {
+  IdentityEnvironment source;
+  IdentityTypes types(source.arch);
+  istringstream definition("<def name=\"LabeledAlias\" id=\"501\" label=\"AliasView\"><typeref name=\"Alias\" id=\"102\"/></def>");
+  XmlDecode inputDecoder(source.arch);
+  inputDecoder.ingestStream(definition);
+  Datatype *alias = types.factory->decodeType(inputDecoder);
+  ASSERT_EQUALS(alias->getTypedef(),types.record);
+  ASSERT_EQUALS(alias->getDisplayName(),"AliasView");
+  Datatype *qualifiedAlias = types.factory->getQualifiedType(alias,Datatype::qualifier_const);
+  types.complete();
+  ASSERT_EQUALS(alias->isIncomplete(),false);
+  ostringstream output;
+  Encode encoder(output);
+  encoder.openElement(ELEM_DATA);
+  types.factory->encode(encoder);
+  qualifiedAlias->encodeRef(encoder);
+  encoder.closeElement(ELEM_DATA);
+  IdentityEnvironment restored;
+  istringstream input(output.str());
+  Decode decoder(restored.arch);
+  decoder.ingestStream(input);
+  uint4 data = decoder.openElement(ELEM_DATA);
+  restored.arch->types->decode(decoder);
+  Datatype *actual = restored.arch->types->decodeType(decoder);
+  decoder.closeElement(data);
+  ASSERT_EQUALS(actual->getName(),"LabeledAlias");
+  ASSERT_EQUALS(actual->getDisplayName(),"AliasView");
+  ASSERT_EQUALS(actual->getUnqualified()->getId(),501);
+  ASSERT_EQUALS(actual->getUnqualified()->getTypedef()->getId(),102);
+  ASSERT_EQUALS(actual->getUnqualified()->getTypedef()->getDisplayName(),"struct Alias");
+  ASSERT_EQUALS(actual->isIncomplete(),false);
+  IdentityPrinter printer(restored.arch);
+  ASSERT_EQUALS(printer.declaration(actual),"const AliasView value");
+}
+
+TEST(explicit_native_typedef_label_xml_roundtrip) { typedefLabelRoundTrip<XmlEncode,XmlDecode>(); }
+TEST(explicit_native_typedef_label_packed_roundtrip) { typedefLabelRoundTrip<PackedEncode,PackedDecode>(); }
+
