@@ -0,0 +1,345 @@
+#include "architecture.hh"
+#include "libdecomp.hh"
+#include "printc.hh"
+#include "test.hh"
+
+namespace ghidra {
+
+class IdentityEnvironment {
+public:
+  Architecture *arch;
+  IdentityEnvironment(void) {
+    startDecompilerLibrary(getenv("SLEIGHHOME"));
+    istringstream input("<binaryimage arch=\"x86:LE:16:Protected Mode:default\"><bytechunk space=\"ram\" offset=\"0x1000\" readonly=\"true\">cb</bytechunk></binaryimage>");
+    DocumentStorage store;
+    Document *document = store.parseDocument(input);
+    store.registerTag(document->getRoot());
+    arch = ArchitectureCapability::getCapability("xml")->buildArchitecture("","",&cout);
+    arch->init(store);
+  }
+  ~IdentityEnvironment(void) { delete arch; }
+};
+
+class IdentityPrinter : public PrintC {
+public:
+  IdentityPrinter(Architecture *arch) : PrintC(arch) { initializeFromArchitecture(); }
+  string declaration(const Datatype *type) {
+    ostringstream output;
+    clear();
+    setOutputStream(&output);
+    pushTypeStart(type,false);
+    pushAtom(Atom("value",syntax,EmitMarkup::no_color));
+    pushTypeEnd(type);
+    recurse();
+    emit->flush();
+    setOutputStream((ostream *)0);
+    return output.str();
+  }
+};
+
+static Datatype *identityNameReference(TypeFactory *factory,const string &name) {
+  ostringstream output;
+  XmlEncode encoder(output);
+  encoder.openElement(ELEM_TYPEREF);
+  encoder.writeString(ATTRIB_NAME,name);
+  encoder.closeElement(ELEM_TYPEREF);
+  istringstream input(output.str());
+  XmlDecode decoder(factory->getArch());
+  decoder.ingestStream(input);
+  return factory->decodeType(decoder);
+}
+
+class IdentityTypes {
+public:
+  TypeFactory *factory;
+  Datatype *word;
+  TypeStruct *record;
+  TypeUnion *choice;
+  TypeEnum *mode;
+  TypeCode *callback;
+  TypeCode *nearCallback;
+  vector<Datatype *> cases;
+  IdentityTypes(Architecture *arch) {
+    factory = arch->types;
+    word = factory->getBase(2,TYPE_UINT,"IdentityWord");
+    Datatype *ordinaryRecord = factory->getTypedef(word,"Alias",101,0);
+    record = factory->getTypeStruct("Alias",102,"struct Alias");
+    Datatype *qualifiedRecord = factory->getQualifiedType(record,Datatype::qualifier_const);
+    Datatype *recordAlias = factory->getTypedef(qualifiedRecord,"RecordAlias",103,0);
+    Datatype *qualifiedAlias = factory->getQualifiedType(recordAlias,Datatype::qualifier_volatile);
+    Datatype *ordinaryChoice = factory->getTypedef(word,"Choice",201,0);
+    choice = factory->getTypeUnion("Choice",202,"union Choice");
+    Datatype *qualifiedChoice = factory->getQualifiedType(choice,Datatype::qualifier_volatile);
+    Datatype *choiceAlias = factory->getTypedef(qualifiedChoice,"ChoiceAlias",203,0);
+    Datatype *ordinaryMode = factory->getTypedef(word,"Mode",301,0);
+    mode = factory->getTypeEnum("Mode",302,"enum Mode");
+    factory->setEnumValues({{1,"enabled"}},mode);
+    Datatype *qualifiedMode = factory->getQualifiedType(mode,Datatype::qualifier_const);
+    PrototypePieces signature;
+    signature.model = arch->getModel("__cdecl16far");
+    signature.name = "not_the_datatype_name";
+    signature.outtype = word;
+    signature.intypes.push_back(factory->getTypePointer(2,qualifiedRecord,1));
+    signature.innames.push_back("input");
+    signature.firstVarArgSlot = -1;
+    callback = factory->getTypeCode(signature,"Callback",401);
+    Datatype *callbackAlias = factory->getTypedef(callback,"CallbackAlias",403,0);
+    signature.model = arch->getModel("__stdcall16near");
+    nearCallback = factory->getTypeCode(signature,"Callback",402);
+    cases = {word,ordinaryRecord,record,qualifiedRecord,recordAlias,qualifiedAlias,
+      ordinaryChoice,choice,qualifiedChoice,choiceAlias,ordinaryMode,mode,qualifiedMode,
+      callback,nearCallback,callbackAlias};
+  }
+  void complete(void) {
+    Datatype *qualifiedRecord = cases[3];
+    vector<TypeField> fields = {TypeField(0,0,"value",word),
+      TypeField(1,2,"next",factory->getTypePointer(2,qualifiedRecord,1))};
+    factory->setFields(fields,{},record,4,2,0);
+    factory->setFields({TypeField(0,0,"value",word)},choice,2,2,0);
+  }
+};
+
+TEST(explicit_native_identity) {
+  IdentityEnvironment env;
+  IdentityTypes types(env.arch);
+  TypeFactory *factory = env.arch->types;
+  ASSERT_EQUALS(types.record->getId(),102);
+  ASSERT_EQUALS(types.record->getName(),"Alias");
+  ASSERT_EQUALS(types.record->getTypedef(),(Datatype *)0);
+  ASSERT_EQUALS(types.cases[1]->getName(),"Alias");
+  ASSERT_EQUALS(types.cases[1]->getId(),101);
+  ASSERT_EQUALS(types.cases[1]->getTypedef(),types.word);
+  ASSERT_EQUALS(types.cases[1]->getMetatype(),TYPE_UINT);
+  ASSERT_NOT_EQUALS(types.record,types.cases[1]);
+  ASSERT_EQUALS(factory->getTypeStruct("Alias",102,"struct Alias"),types.record);
+  ASSERT_EQUALS(factory->getTypeUnion("Choice",202,"union Choice"),types.choice);
+  ASSERT_EQUALS(types.mode->getId(),302);
+  ASSERT_EQUALS(types.mode->getMetatype(),TYPE_UINT);
+  ASSERT(types.mode->isEnumType());
+  ASSERT(types.mode->hasNamedValue(1));
+  TypeStruct *other = factory->getTypeStruct("Alias",104,"struct OtherAlias");
+  ASSERT_NOT_EQUALS(other,types.record);
+  ASSERT_EQUALS(other->getId(),104);
+  bool rejected = false;
+  try {
+    factory->getTypeUnion("Alias",102,"union Alias");
+  }
+  catch(LowlevelError &) {
+    rejected = true;
+  }
+  ASSERT(rejected);
+  TypeStruct *defaultRecord = factory->getTypeStruct("DefaultRecord");
+  ASSERT_EQUALS(identityNameReference(factory,"DefaultRecord"),defaultRecord);
+  ASSERT_EQUALS(defaultRecord->getDisplayName(),"DefaultRecord");
+  ASSERT_EQUALS(factory->getTypeStruct("DefaultRecord",0,""),defaultRecord);
+  TypeUnion *defaultUnion = factory->getTypeUnion("DefaultUnion");
+  ASSERT_EQUALS(identityNameReference(factory,"DefaultUnion"),defaultUnion);
+  ASSERT_EQUALS(defaultUnion->getDisplayName(),"DefaultUnion");
+  TypeEnum *defaultEnum = factory->getTypeEnum("DefaultEnum");
+  ASSERT_EQUALS(identityNameReference(factory,"DefaultEnum"),defaultEnum);
+  ASSERT_EQUALS(defaultEnum->getDisplayName(),"DefaultEnum");
+  IdentityPrinter printer(env.arch);
+  ASSERT_EQUALS(printer.declaration(types.cases[1]),"Alias value");
+  ASSERT_EQUALS(printer.declaration(types.record),"struct Alias value");
+  ASSERT_EQUALS(printer.declaration(types.choice),"union Choice value");
+  ASSERT_EQUALS(printer.declaration(types.mode),"enum Mode value");
+  ASSERT_EQUALS(printer.declaration(types.cases[3]),"const struct Alias value");
+  ASSERT_EQUALS(printer.declaration(types.cases[4]),"RecordAlias value");
+  types.complete();
+  for(int4 i : {2,3,4,5,7,8,9}) {
+    ASSERT_EQUALS(types.cases[i]->isIncomplete(),false);
+  }
+  ASSERT_EQUALS(types.cases[3]->getUnqualified(),types.record);
+  ASSERT_EQUALS(types.cases[4]->getTypedef(),types.cases[3]);
+  ASSERT_EQUALS(types.cases[5]->getUnqualified(),types.cases[4]);
+  ASSERT_EQUALS(types.cases[3]->getDisplayName(),"struct Alias");
+  ASSERT_EQUALS(types.cases[4]->getDisplayName(),"RecordAlias");
+  ASSERT_EQUALS(types.cases[5]->getDisplayName(),"RecordAlias");
+  ASSERT_EQUALS(types.cases[8]->getDisplayName(),"union Choice");
+  ASSERT_EQUALS(types.cases[9]->getDisplayName(),"ChoiceAlias");
+  ASSERT_EQUALS(((TypePointer *)types.record->getDepend(1))->getPtrTo(),types.cases[3]);
+  ASSERT_EQUALS(printer.declaration(types.cases[3]),"const struct Alias value");
+}
+
+TEST(explicit_native_enum_width) {
+  IdentityEnvironment env;
+  IdentityTypes types(env.arch);
+  TypeFactory *factory = env.arch->types;
+  TypeEnum *wideMode = factory->getTypeEnum("WideMode",304,"enum WideMode",4);
+  TypeEnum *byteMode = factory->getTypeEnum("ByteMode",303,"enum ByteMode",1);
+  ASSERT_EQUALS(byteMode->getSize(),1);
+  ASSERT_EQUALS(byteMode->getName(),"ByteMode");
+  ASSERT_EQUALS(byteMode->getId(),303);
+  ASSERT_EQUALS(byteMode->getDisplayName(),"enum ByteMode");
+  ASSERT_EQUALS(wideMode->getSize(),4);
+  ASSERT_EQUALS(wideMode->getName(),"WideMode");
+  ASSERT_EQUALS(wideMode->getId(),304);
+  ASSERT_EQUALS(wideMode->getDisplayName(),"enum WideMode");
+  ASSERT_EQUALS(factory->getTypeEnum("ByteMode",303,"enum ByteMode",1),byteMode);
+  ASSERT_EQUALS(factory->getTypeEnum("WideMode",304,"enum WideMode",4),wideMode);
+  for(TypeEnum *mode : {byteMode,wideMode}) {
+    ASSERT(mode->isEnumType());
+    ASSERT_EQUALS(mode->getMetatype(),types.mode->getMetatype());
+    factory->setEnumValues({{1,"enabled"}},mode);
+    ASSERT(mode->hasNamedValue(1));
+    ASSERT_EQUALS(mode->beginEnum()->first,1);
+    ASSERT_EQUALS(mode->beginEnum()->second,"enabled");
+  }
+  TypeEnum *defaultMode = factory->getTypeEnum("DefaultAfter");
+  TypeEnum *zeroMode = factory->getTypeEnum("DefaultZero",0,"",0);
+  ASSERT_EQUALS(defaultMode->getSize(),types.mode->getSize());
+  ASSERT_EQUALS(defaultMode->getMetatype(),types.mode->getMetatype());
+  ASSERT_EQUALS(defaultMode->getId(),Datatype::hashName("DefaultAfter"));
+  ASSERT_EQUALS(defaultMode->getDisplayName(),"DefaultAfter");
+  ASSERT_EQUALS(zeroMode->getSize(),types.mode->getSize());
+  ASSERT_EQUALS(zeroMode->getMetatype(),types.mode->getMetatype());
+  ASSERT_EQUALS(zeroMode->getId(),Datatype::hashName("DefaultZero"));
+  ASSERT_EQUALS(zeroMode->getDisplayName(),"DefaultZero");
+}
+
+TEST(explicit_native_code_identity) {
+  IdentityEnvironment env;
+  IdentityTypes types(env.arch);
+  TypeFactory *factory = env.arch->types;
+  ASSERT_EQUALS(types.callback->getMetatype(),TYPE_CODE);
+  ASSERT_EQUALS(types.callback->getName(),"Callback");
+  ASSERT_EQUALS(types.callback->getId(),401);
+  ASSERT_EQUALS(types.callback->getTypedef(),(Datatype *)0);
+  ASSERT_EQUALS(types.callback->getPrototype()->getModelName(),"__cdecl16far");
+  ASSERT_EQUALS(types.nearCallback->getName(),"Callback");
+  ASSERT_EQUALS(types.nearCallback->getId(),402);
+  ASSERT_EQUALS(types.nearCallback->getPrototype()->getModelName(),"__stdcall16near");
+  ASSERT_EQUALS(types.callback->getPrototype()->getParam(0)->getAddress().getOffset(),4);
+  ASSERT_EQUALS(types.nearCallback->getPrototype()->getParam(0)->getAddress().getOffset(),2);
+  ASSERT_NOT_EQUALS(types.callback,types.nearCallback);
+  ASSERT_EQUALS(types.cases[15]->getTypedef(),types.callback);
+  ASSERT_EQUALS(types.cases[15]->getDisplayName(),"CallbackAlias");
+  PrototypePieces signature;
+  signature.model = env.arch->getModel("__cdecl16far");
+  signature.name = "ignored_for_anonymous_identity";
+  signature.outtype = types.word;
+  signature.intypes.push_back(factory->getTypePointer(2,types.cases[3],1));
+  signature.innames.push_back("input");
+  signature.firstVarArgSlot = -1;
+  ASSERT_EQUALS(factory->getTypeCode(signature,"Callback",401),types.callback);
+  TypeCode *anonymous = factory->getTypeCode(signature);
+  ASSERT_EQUALS(anonymous->getName(),"");
+  ASSERT_EQUALS(anonymous->getId(),0);
+  ASSERT_EQUALS(factory->getTypeCode(signature),anonymous);
+  ASSERT_NOT_EQUALS(anonymous,types.callback);
+  ASSERT_EQUALS(factory->getTypeCode()->getPrototype(),(const FuncProto *)0);
+  ASSERT_NOT_EQUALS(factory->getTypeCode(),anonymous);
+  TypeCode *namedDefault = factory->getTypeCode(signature,"NamedDefault");
+  ASSERT_EQUALS(identityNameReference(factory,"NamedDefault"),namedDefault);
+  ASSERT_EQUALS(namedDefault->getDisplayName(),"NamedDefault");
+  ASSERT_EQUALS(namedDefault->getPrototype()->getModelName(),"__cdecl16far");
+}
