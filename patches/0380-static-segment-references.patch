+  ASSERT(!env.segment()->resolveReference(*env.fd,selector,reassembledOffset,target));
+  ASSERT(!env.segment()->resolveReference(*env.fd,changedSelector,near,target));
+  ASSERT(!env.segment()->resolveReference(*env.fd,selector,unrelated,target));
+  ASSERT(!env.segment()->resolveReference(*env.fd,selector,env.fd->newConstant(2,0x1234),target));
+  ASSERT(!env.segment()->resolveReference(*env.fd,written,near,target));
+  ASSERT(!env.segment()->resolveReference(*env.fd,load,near,target));
+}
+
+TEST(segment_reference_initial_memory_and_prior_writes) {
+  for(const string &prefix : {"","c70600200000","8907"}) {
+    ReferenceEnvironment env("8cc88ed8"+prefix+"a100208ed8a10030c3");
+    env.image->facts[{0x100002000ULL,2}] = {selector_reference,0x200000000ULL};
+    env.image->callPreserved.insert(make_pair(Address(env.ram(),0x100002000ULL),2));
+    env.arch->symboltab->getGlobalScope()->addSymbol("qualified_initial_target",env.arch->types->getBase(2,TYPE_UINT),Address(env.ram(),0x200003000ULL),Address());
+    env.analyze();
+    ASSERT_EQUALS(env.print().find("qualified_initial_target") != string::npos,prefix.empty());
+  }
+}
