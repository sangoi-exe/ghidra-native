+class BoundFarImage : public LoadImageXml {
+  bool bound;
+public:
+  BoundFarImage(const Element *image,bool supplied) : LoadImageXml("bound-far",image),bound(supplied) {}
+  virtual bool getInstructionField(const InstructionField &field) const {
+    return bound && !field.bigEndian && field.bitOffset == 0 && field.bitSize == 16 && field.size == 2 &&
+        (field.source.getOffset() == 0x100000914ULL || field.source.getOffset() == 0x100000916ULL);
+  }
+  virtual bool getInitialReference(const Address &storage,int4 size,InitialReferenceUse use,Address &target) const {
+    if (!bound || storage.getOffset() != 0x100000914ULL || size != 4 || use != complete_pointer_reference)
+      return false;
+    target = Address(storage.getSpace(),0x100000994ULL);
+    return true;
+  }
+  virtual void getReadonly(RangeList &list) const {}
+};
+
+class BoundFarArchitecture : public XmlArchitecture {
+  bool bound;
+  virtual void buildLoader(DocumentStorage &store) {
+    collectSpecFiles(*errorstream);
+    loader = new BoundFarImage(store.getTag("binaryimage"),bound);
+  }
+public:
+  BoundFarArchitecture(bool supplied) : XmlArchitecture("","",&cout),bound(supplied) {}
+};
