+// Controlled facts from executed INSTR.EXE ne.reloc.1.10, not a synthetic Windows instruction oracle.
+TEST(segment_reference_bound_and_unbound_far) {
+  for(const string &bytes : {"9a00000400","9affff0000","9a94090100"}) {
+    bool bound = bytes != "9a00000400";
+    startDecompilerLibrary(getenv("SLEIGHHOME"));
+    istringstream input("<binaryimage arch=\"x86:LE:16:Protected Mode:default\"><bytechunk space=\"ram\" offset=\"0x100000913\">"+bytes+"c3</bytechunk></binaryimage>");
+    DocumentStorage store;
+    Document *document = store.parseDocument(input);
+    store.registerTag(document->getRoot());
+    unique_ptr<Architecture> arch(new BoundFarArchitecture(bound));
+    arch->init(store);
+    AddrSpace *ram = arch->getDefaultCodeSpace();
+    Scope *global = arch->symboltab->getGlobalScope();
+    global->addFunction(Address(ram,0x100000994ULL),"justified_target");
+    global->addFunction(Address(ram,0x400000000ULL),"unjustified_numeric_target");
+    Funcdata *fd = global->addFunction(Address(ram,0x100000913ULL),"far_source")->getFunction();
+    ReferencePcodeEmit emit;
+    ASSERT_EQUALS(arch->translate->oneInstruction(emit,fd->getAddress()),5);
+    ASSERT_EQUALS(emit.directCalls,0);
+    ASSERT_EQUALS(emit.indirectCalls,1);
+    ASSERT_EQUALS(emit.sourceComponents,bound ? 3 : 0);
+    arch->allacts.getCurrent()->reset(*fd);
+    ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
+    ASSERT_EQUALS(fd->numCalls(),1);
+    FuncCallSpecs *call = fd->getCallSpecs(0);
+    if (bound) {
+      ASSERT_EQUALS(call->getOp()->code(),CPUI_CALL);
+      ASSERT_EQUALS(call->getEntryAddress(),Address(ram,0x100000994ULL));
+    }
+    else {
+      ASSERT_EQUALS(call->getOp()->code(),CPUI_CALLIND);
+      ASSERT_NOT_EQUALS(call->getEntryAddress(),Address(ram,0x400000000ULL));
+    }
+  }
+}
