+class ReferencePcodeEmit : public PcodeEmit {
+public:
+  int4 directCalls = 0;
+  int4 indirectCalls = 0;
+  int4 sourceComponents = 0;
+  virtual void dump(const Address &address,OpCode opcode,VarnodeData *out,VarnodeData *inputs,int4 size) {
+    if (opcode == CPUI_CALL) ++directCalls;
+    if (opcode == CPUI_CALLIND) {
+      ASSERT_EQUALS(inputs[0].size,6);
+      ASSERT_EQUALS(inputs[0].space->getType(),IPTR_INTERNAL);
+      ++indirectCalls;
+    }
+    for(int4 i=0;i<size;++i) {
+      if (inputs[i].space != address.getSpace() || inputs[i].size != 2) continue;
+      if (inputs[i].offset == 0x100000914ULL) sourceComponents |= 1;
+      if (inputs[i].offset == 0x100000916ULL) sourceComponents |= 2;
+    }
+  }
+};
