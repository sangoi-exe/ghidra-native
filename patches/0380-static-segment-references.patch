+/// \param nm is the low-level name of the segment operation
+/// \param g is the owning Architecture for this instance of the segment operation
+/// \param ind is the constant id identifying the specific CALLOTHER variant
+SegmentOp::SegmentOp(const string &nm,Architecture *g,int4 ind)
+  : TermPatternOp(nm,g,segment,ind)
+{
+  constresolve.space = (AddrSpace *)0;
+}
+
+bool SegmentOp::unify(Funcdata &data,PcodeOp *op,
+				 vector<Varnode *> &bindlist) const
+{
+  Varnode *basevn,*innervn;
+
+  // Segmenting is done by a user defined p-code op, so this is what we look for
+  // The op must have innervn and basevn (if base is present) as inputs
+  // so there isn't much to follow. The OpFollow arrays are no
+  // longer needed for unification but are needed to provide
+  // a definition for the userop
+  if (op->code() != CPUI_CALLOTHER) return false;
+  if (op->getIn(0)->getOffset() != useropindex) return false;
+  if (op->numInput() != 3) return false;
+  innervn = op->getIn(1);
+  if (baseinsize != 0) {
+    basevn = op->getIn(1);
+    innervn = op->getIn(2);
+    if (basevn->isConstant())
+      basevn = data.newConstant(baseinsize,basevn->getOffset());
+    bindlist[0] = basevn;
+  }
+  else
+    bindlist[0] = (Varnode *)0;
+  bindlist[1] = innervn;
+  return true;
+}
+
+uintb SegmentOp::execute(const vector<uintb> &input) const
+
+{
+  if (usesStaticReferences())
+    throw LowlevelError("Numeric selector evaluation is unavailable in a static segmented address space");
+  ExecutablePcode *pcodeScript = (ExecutablePcode *)glb->pcodeinjectlib->getPayload(injectId);
+  return pcodeScript->evaluate(input);
+}
+
+void SegmentOp::decode(Decoder &decoder)
+
+{
+  uint4 elemId = decoder.openElement(ELEM_SEGMENTOP);
+  spc = (AddrSpace *)0;
+  injectId = -1;
+  baseinsize = 0;
+  innerinsize = 0;
+  supportsfarpointer = false;
+  name = "segment"; 		// Default name, might be overridden by userop attribute
+  for(;;) {
+    uint4 attribId = decoder.getNextAttributeId();
+    if (attribId == 0) break;
+    if (attribId == ATTRIB_SPACE)
+      spc = decoder.readSpace();
+    else if (attribId == ATTRIB_FARPOINTER)
+      supportsfarpointer = true;
+    else if (attribId == ATTRIB_USEROP) {	// Based on existing sleigh op
+      name = decoder.readString();
+    }
+  }
+  if (spc == (AddrSpace *)0)
+    throw LowlevelError("<segmentop> expecting space attribute");
+  UserPcodeOp *otherop = glb->userops.getOp(name);
+  if (otherop == (UserPcodeOp *)0)
+    throw LowlevelError("<segmentop> unknown userop " + name);
+  useropindex = otherop->getIndex();
+  if (dynamic_cast<UnspecializedPcodeOp *>(otherop) == (UnspecializedPcodeOp *)0)
+    throw LowlevelError("Redefining userop "+name);
+
+  for(;;) {
+    uint4 subId = decoder.peekElement();
+    if (subId == 0) break;
+    if (subId==ELEM_CONSTRESOLVE) {
+      int4 sz;
+      decoder.openElement();
+      if (decoder.peekElement() != 0) {
+	Address addr = Address::decode(decoder,sz);
+	constresolve.space = addr.getSpace();
+	constresolve.offset = addr.getOffset();
+	constresolve.size = sz;
+      }
+      decoder.closeElement(subId);
+    }
+    else if (subId == ELEM_PCODE) {
+      string nm = name + "_pcode";
+      string source = "cspec";
+      injectId = glb->pcodeinjectlib->decodeInject(source, nm, InjectPayload::EXECUTABLEPCODE_TYPE, decoder);
+    }
+  }
+  decoder.closeElement(elemId);
+  if (injectId < 0)
+    throw LowlevelError("Missing <pcode> child in <segmentop> tag");
+  InjectPayload *payload = glb->pcodeinjectlib->getPayload(injectId);
+  if (payload->sizeOutput() != 1)
+    throw LowlevelError("<pcode> child of <segmentop> tag must declare one <output>");
+  if (payload->sizeInput() == 1) {
+    innerinsize = payload->getInput(0).getSize();
+  }
+  else if (payload->sizeInput() == 2) {
+    baseinsize = payload->getInput(0).getSize();
+    innerinsize = payload->getInput(1).getSize();
+  }
+  else
+    throw LowlevelError("<pcode> child of <segmentop> tag must declare one or two <input> tags");
+}
+
+bool SegmentOp::usesStaticReferences(void) const
+
+{
+  return supportsfarpointer && baseinsize == 2 && innerinsize == 4 && spc->getAddrSize() == 6;
+}
+
+Address SegmentOp::composeReference(const Address &segment,uintb offset) const
+
+{
+  if (!usesStaticReferences() || segment.getSpace() != spc || offset > calc_mask(innerinsize))
+    throw LowlevelError("Invalid static segment coordinate");
+  uintb base = segment.getOffset() & ~calc_mask(innerinsize);
+  return Address(spc,base | offset);
+}
+
+namespace {
+
+// An exact initial storage slice and, independently, a justified selector identity.
+struct SegmentReference {
+  Address source;
+  Address segment;
+  int4 selectorOffset;
+  uintb changedMask; ///< Bits of this slice possibly changed from its initial source
+  SegmentReference(void) : selectorOffset(0),changedMask(0) {}
+};
+
+class SegmentReferenceQuery {
+  typedef pair<Varnode *,pair<int4,int4> > Field;
+  Funcdata &data;
+  const SegmentOp &segment;
+  map<Field,SegmentReference> results;
+  set<Field> active;
+  SegmentReference inputReference(Varnode *vn,int4 offset,int4 size) {
+    SegmentReference result;
+    if (data.findVarnodeInput(vn->getSize(),vn->getAddr()) != vn || !data.isHeritaged(vn))
+      return result;
+    const VarnodeData &cs = data.getArch()->translate->getRegister("CS");
+    if (vn->getSpace() == cs.space && vn->getOffset() == cs.offset && vn->getSize() == cs.size && cs.size == 2) {
+      const Address &entry = data.getAddress();
+      if (entry.getSpace() == segment.getSpace()) {
+        result.segment = segment.composeReference(entry,0);
+        result.selectorOffset = offset;
+      }
+      return result;
+    }
+    if (vn->getSpace() != segment.getSpace())
+      return result;
+    int4 byteOffset = vn->getSpace()->isBigEndian() ? vn->getSize()-offset-size : offset;
+    result.source = vn->getAddr()+byteOffset;
+    if (vn->getSize() == 2) {
+      Address target;
+      if (data.getArch()->loader->getInitialReference(vn->getAddr(),2,selector_reference,target) &&
+          !target.isInvalid() && target.getSpace() == segment.getSpace() &&
+          (target.getOffset() & calc_mask(segment.getInnerSize())) == 0) {
+        result.segment = target;
+        result.selectorOffset = offset;
+      }
+    }
+    return result;
+  }
+  SegmentReference follow(Varnode *vn,int4 offset,int4 size) {
+    SegmentReference unknown;
+    if (vn->isInput())
+      return inputReference(vn,offset,size);
+    if (!vn->isWritten())
+      return unknown;
+    PcodeOp *op = vn->getDef();
+    switch(op->code()) {
+    case CPUI_COPY:
+      return trace(op->getIn(0),offset,size);
+    case CPUI_SUBPIECE:
+      if (!op->getIn(1)->isConstant()) return unknown;
+      if (op->getIn(1)->getOffset() > (uintb)op->getIn(0)->getSize()) return unknown;
+      return trace(op->getIn(0),offset + op->getIn(1)->getOffset(),size);
+    case CPUI_INT_ZEXT:
+      return trace(op->getIn(0),offset,size);
+    case CPUI_PIECE: {
+      int4 lowSize = op->getIn(1)->getSize();
+      if (offset >= lowSize)
+        return trace(op->getIn(0),offset-lowSize,size);
+      if (offset+size <= lowSize)
+        return trace(op->getIn(1),offset,size);
+      SegmentReference low = trace(op->getIn(1),offset,lowSize-offset);
+      SegmentReference high = trace(op->getIn(0),0,offset+size-lowSize);
+      SegmentReference result;
+      int4 lowBytes = lowSize-offset;
+      int4 highBytes = size-lowBytes;
+      result.changedMask = low.changedMask | (high.changedMask << (8*lowBytes));
+      if (!low.source.isInvalid() && !high.source.isInvalid()) {
+        if (segment.getSpace()->isBigEndian()) {
+          if (high.source+highBytes == low.source) result.source = high.source;
+        }
+        else if (low.source+lowBytes == high.source)
+          result.source = low.source;
+      }
+      if (!low.segment.isInvalid() && low.segment == high.segment && high.selectorOffset == low.selectorOffset+lowBytes) {
+        result.segment = low.segment;
+        result.selectorOffset = low.selectorOffset;
+      }
+      return result;
+    }
+    case CPUI_MULTIEQUAL: {
+      SegmentReference result;
+      for(int4 i=0;i<op->numInput();++i) {
+        SegmentReference next = trace(op->getIn(i),offset,size);
+        if (i == 0)
+          result = next;
+        else {
+          result.changedMask |= next.changedMask;
+          if (result.source != next.source) result.source = Address();
+          if (result.segment != next.segment || result.selectorOffset != next.selectorOffset)
+            result.segment = Address();
+        }
+      }
+      return result;
+    }
+    case CPUI_INT_AND:
+    case CPUI_INT_OR:
+      if (vn->getSize() != 2) return unknown;
+      for(int4 i=0;i<2;++i) {
+        Varnode *other = op->getIn(1-i);
+        if (op->code() == CPUI_INT_AND) {
+          if (!other->isConstant() || (other->getOffset() & 0xfffc) != 0xfffc) continue;
+        }
+        else if ((other->getNZMask() & 0xfffc) != 0)
+          continue;
+        SegmentReference result = trace(op->getIn(i),0,2);
+        uintb changed = op->code() == CPUI_INT_AND ? ~other->getOffset() : other->getNZMask();
+        result.changedMask |= changed & 0xffff;
+        if (!result.source.isInvalid())
+          result.source = result.source + (segment.getSpace()->isBigEndian() ? 2-offset-size : offset);
+        if (!result.segment.isInvalid() && result.selectorOffset == 0 && (result.changedMask & 0xfffc) == 0)
+          result.selectorOffset = offset;
+        else
+          result.segment = Address();
+        result.changedMask = (result.changedMask >> (8*offset)) & calc_mask(size);
+        return result;
+      }
+      return unknown;
+    default:
+      // LOAD must first pass through normal memory/heritage handling; INDIRECT is not a copy.
+      return unknown;
+    }
+  }
+public:
+  SegmentReferenceQuery(Funcdata &fd,const SegmentOp &op) : data(fd),segment(op) {}
+  SegmentReference trace(Varnode *vn,int4 offset,int4 size) {
+    SegmentReference unknown;
+    if (offset < 0 || size <= 0 || offset > vn->getSize() || size > vn->getSize()-offset)
+      return unknown;
+    Field field = make_pair(vn,make_pair(offset,size));
+    auto found = results.find(field);
+    if (found != results.end()) return found->second;
+    if (active.size() >= 256 || !active.insert(field).second)
+      return unknown;
+    SegmentReference result = follow(vn,offset,size);
+    active.erase(field);
+    results.insert(make_pair(field,result));
+    return result;
+  }
+};
+
+} // End anonymous namespace
+
+bool SegmentOp::resolveReference(Funcdata &data,Varnode *base,Varnode *inner,Address &target) const
+
+{
+  if (!usesStaticReferences() || data.getHeritagePass() == 0 || base->getSize() != 2)
+    return false;
+  SegmentReferenceQuery query(data,*this);
+  SegmentReference reference = query.trace(base,0,2);
+  if ((reference.changedMask & 0xfffc) != 0) return false;
+  Address selector = reference.segment;
+  if (selector.isInvalid() && !reference.source.isInvalid()) {
+    if (!glb->loader->getInitialReference(reference.source,2,selector_reference,selector))
+      selector = Address();
+  }
+  if (inner->isConstant() && inner->getSize() <= innerinsize && reference.selectorOffset == 0 &&
+      !selector.isInvalid() && selector.getSpace() == spc && (selector.getOffset() & calc_mask(innerinsize)) == 0) {
+    target = composeReference(selector,inner->getOffset());
+    return true;
+  }
+  if (reference.source.isInvalid()) return false;
+  for(int4 offsetSize : {2,4}) {
+    if (inner->getSize() < offsetSize) continue;
+    if (inner->getSize() > offsetSize && (inner->getNZMask() & ~calc_mask(offsetSize)) != 0) {
+      Varnode *extension = inner;
+      set<Varnode *> visited;
+      while (extension->getSize() > offsetSize && extension->isWritten() && visited.insert(extension).second) {
+        OpCode code = extension->getDef()->code();
+        if (code != CPUI_COPY && code != CPUI_INT_ZEXT) break;
+        extension = extension->getDef()->getIn(0);
+      }
+      if (extension->getSize() > offsetSize) continue;
+    }
+    SegmentReference low = query.trace(inner,0,offsetSize);
+    if (low.source.isInvalid() || low.changedMask != 0) continue;
+    Address start;
+    if (spc->isBigEndian()) {
+      if (reference.source+2 != low.source) continue;
+      start = reference.source;
+    }
+    else {
+      if (low.source+offsetSize != reference.source) continue;
+      start = low.source;
+    }
+    Address resolved;
+    if (glb->loader->getInitialReference(start,offsetSize+2,complete_pointer_reference,resolved) &&
+        !resolved.isInvalid() && resolved.getSpace() == spc) {
+      target = resolved;
+      return true;
+    }
+  }
+  return false;
+}
