+    PcodeOp *call = fd->getCallSpecs(0)->getOp();
+    ASSERT_EQUALS(call->code(),CPUI_CALLIND);
+    Varnode *target = call->getIn(0);
+    ASSERT_EQUALS(target->getSize(),6);
