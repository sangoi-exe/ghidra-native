+// Normal FAR-return observation: callerCS1557/file3 -> calleeCS154f/file4 -> callerCS1557/file3.
+TEST(segment_reference_far_caller_and_callee_entry) {
+  ReferenceEnvironment caller("9a000004008cc88ed8a1150ac3",0x300000023ULL);
+  caller.arch->symboltab->getGlobalScope()->addFunction(Address(caller.ram(),0x400000000ULL),"captured_callee");
+  caller.arch->symboltab->getGlobalScope()->addSymbol("caller_code_word",caller.arch->types->getBase(2,TYPE_UINT),Address(caller.ram(),0x300000a15ULL),Address());
+  caller.analyze();
+  ASSERT_EQUALS(caller.fd->numCalls(),1);
+  ASSERT(caller.print().find("caller_code_word") != string::npos);
+  ReferenceEnvironment callee("8cc88ed8a1150acb",0x400000000ULL);
+  callee.arch->symboltab->getGlobalScope()->addSymbol("callee_code_word",callee.arch->types->getBase(2,TYPE_UINT),Address(callee.ram(),0x400000a15ULL),Address());
+  callee.analyze();
+  ASSERT(callee.print().find("callee_code_word") != string::npos);
+}
