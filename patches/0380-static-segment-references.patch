+class ReferenceEnvironment {
+public:
+  Architecture *arch;
+  InitialReferenceImage *image;
+  Funcdata *fd;
+  BlockBasic *block;
+  ReferenceEnvironment(const string &bytes = "c3",uintb entry = 0x100001000ULL) {
+    startDecompilerLibrary(getenv("SLEIGHHOME"));
+    ostringstream xml;
+    xml << "<binaryimage arch=\"x86:LE:16:Protected Mode:default\"><bytechunk space=\"ram\" offset=\"0x" << hex << entry;
+    xml << "\" readonly=\"true\">" << bytes << "</bytechunk></binaryimage>";
+    istringstream input(xml.str());
+    DocumentStorage store;
+    Document *document = store.parseDocument(input);
+    store.registerTag(document->getRoot());
+    arch = ArchitectureCapability::getCapability("xml")->buildArchitecture("","",&cout);
+    arch->init(store);
+    image = new InitialReferenceImage(arch->loader);
+    arch->loader = image;
+    fd = arch->symboltab->getGlobalScope()->addFunction(Address(ram(),entry),"reference_test")->getFunction();
+    block = (BlockBasic *)0;
+  }
+  ~ReferenceEnvironment(void) { delete arch; }
+  AddrSpace *ram(void) const { return arch->getDefaultCodeSpace(); }
+  SegmentOp *segment(void) const { return arch->getSegmentOp(ram()); }
+  void synthetic(void) {
+    fd->startProcessing();
+    block = (BlockBasic *)fd->getBasicBlocks().getBlock(0);
+  }
+  Varnode *input(int4 size,const Address &address) { return fd->setInputVarnode(fd->newVarnode(size,address)); }
+  Varnode *cs(void) { return input(2,arch->translate->getRegister("CS").getAddr()); }
+  Varnode *op(OpCode code,int4 size,const vector<Varnode *> &inputs,const Address &output = Address()) {
+    PcodeOp *op = fd->newOp(inputs.size(),fd->getAddress());
+    fd->opSetOpcode(op,code);
+    for(int4 i=0;i<inputs.size();++i)
+      fd->opSetInput(op,inputs[i],i);
+    Varnode *result = output.isInvalid() ? fd->newUniqueOut(size,op) : fd->newVarnodeOut(size,output,op);
+    fd->opInsertBefore(op,block->lastOp());
+    return result;
+  }
+  void heritage(void) { for(int4 i=0;i<4;++i) fd->opHeritage(); }
+  void analyze(void) {
+    PrototypePieces proto;
+    proto.model = arch->getModel("__cdecl16near");
+    proto.outtype = arch->types->getBase(2,TYPE_UINT);
+    proto.firstVarArgSlot = -1;
+    fd->getFuncProto().setPieces(proto);
+    arch->allacts.getCurrent()->reset(*fd);
+    ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
+  }
+  string print(void) {
+    ostringstream output;
+    arch->print->setOutputStream(&output);
+    arch->print->docFunction(fd);
+    arch->print->setOutputStream((ostream *)0);
+    return output.str();
+  }
+};
