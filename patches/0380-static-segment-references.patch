+class InitialReferenceImage : public LoadImage {
+  LoadImage *image;
+public:
+  map<pair<uintb,int4>,pair<InitialReferenceUse,uintb> > facts;
+  set<pair<Address,int4> > callPreserved;
+  mutable int4 queries;
+  InitialReferenceImage(LoadImage *original) : LoadImage("initial-references"),image(original),queries(0) {}
+  virtual ~InitialReferenceImage(void) { delete image; }
+  virtual void loadFill(uint1 *ptr,int4 size,const Address &addr) { image->loadFill(ptr,size,addr); }
+  virtual bool getInitialReference(const Address &storage,int4 size,InitialReferenceUse use,Address &target) const {
+    ++queries;
+    auto found = facts.find(make_pair(storage.getOffset(),size));
+    if (found == facts.end() || found->second.first != use) return false;
+    target = Address(storage.getSpace(),found->second.second);
+    return true;
+  }
+  virtual bool isCallPreservedStorage(const Address &storage,int4 size) const {
+    return callPreserved.count(make_pair(storage,size)) != 0;
+  }
+  virtual void getReadonly(RangeList &list) const { image->getReadonly(list); }
+  virtual string getArchType(void) const { return image->getArchType(); }
+  virtual void adjustVma(long adjust) { image->adjustVma(adjust); }
+};
