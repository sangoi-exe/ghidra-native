+static void checkLoadCrossingStore(bool convert) {
+  QualifiedAccessEnvironment env("8b07c7070100000083c002c3");
+  env.setInput(env.arch->types->getTypePointer(8,env.arch->types->getBase(4,TYPE_UINT),1));
+  env.analyze();
+  PcodeOp *load = memoryAccessAt(env,0x1000,CPUI_LOAD);
+  PcodeOp *store = memoryAccessAt(env,0x1002,CPUI_STORE);
+  Varnode *loaded = load->getOut();
+  ASSERT_EQUALS(load->code(),CPUI_LOAD);
+  ASSERT_EQUALS(store->code(),CPUI_STORE);
+  ASSERT_EQUALS(load->getIn(1),store->getIn(1));
+  ASSERT(loaded->getCover()->contain(store,2));
+  if (convert)
+    env.fd->replaceVolatile(store);
+  loaded->clearImplied();
+  loaded->clearExplicit();
+  ActionMarkImplied action("base");
+  action.apply(*env.fd);
+  ASSERT(loaded->isExplicit());
+  ASSERT(!loaded->isImplied());
+  ASSERT_EQUALS(returnedDefinitions(env.fd).count(load),1);
+  string text = env.print();
+  size_t read = text.find("*input");
+  size_t write = text.find("*input = 1;");
+  ASSERT(read != string::npos && write != string::npos && read < write);
+  ASSERT(write < text.find("return"));
+}
+
+TEST(qualified_ordinary_load_crossing_store) { checkLoadCrossingStore(false); }
+TEST(qualified_ordinary_load_crossing_volatile_store) { checkLoadCrossingStore(true); }
