+TEST(qualified_volatile_derived_accesses) {
+  for(int4 kind=0;kind<5;++kind) {
+    // COPY to RAX, then a member/array offset, two unused reads and two writes to the same object.
+    QualifiedAccessEnvironment env("4889f84883c0020fb7100fb71066c700010066c70002000fb700c3");
+    TypeFactory *factory = env.arch->types;
+    Datatype *word = factory->getBase(2,TYPE_UINT);
+    Datatype *vol = factory->getQualifiedType(word,Datatype::qualifier_volatile);
+    Datatype *object = kind == 4 ? word : vol;
+    if (kind == 1)
+      object = factory->getQualifiedType(factory->getTypeArray(4,word),Datatype::qualifier_volatile);
+    else if (kind == 2 || kind == 3) {
+      TypeStruct *record = factory->getTypeStruct("AccessRecord");
+      vector<TypeField> fields = {TypeField(0,0,"first",word),TypeField(1,2,"value",kind == 2 ? word : vol)};
+      factory->setFields(fields,{},record,4,2,0);
+      object = kind == 2 ? factory->getQualifiedType(record,Datatype::qualifier_volatile) : record;
+      ASSERT_EQUALS(record->getDepend(1),kind == 2 ? word : vol);
+    }
+    env.setInput(factory->getTypePointer(8,object,1));
+    env.analyze();
+    ASSERT_EQUALS(env.effects(UserPcodeOp::volatile_read),kind == 4 ? 0 : 3);
+    ASSERT_EQUALS(env.effects(UserPcodeOp::volatile_write),kind == 4 ? 0 : 2);
+    ASSERT_EQUALS(env.loads(),kind == 4 ? 1 : 0);
+    string text = env.print();
+    ASSERT(text.find("read_volatile") == string::npos);
+    ASSERT(text.find("write_volatile") == string::npos);
+    ASSERT(text.find(" = 1;") != string::npos);
+    ASSERT(text.find(" = 2;") != string::npos);
+    ASSERT(text.find("volatile") != string::npos || kind >= 3);
+  }
+}
