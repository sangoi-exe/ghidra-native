+static void checkStoreDependencies(bool convert) {
+  QualifiedAccessEnvironment env("558bec83ec10c745f401000000c74524020000008d5df4837d080075038d5d24c703030000008b45f4034524c9c3","x86:LE:32:default:gcc");
+  env.analyze();
+  PcodeOp *store = memoryAccessAt(env,0x1020,CPUI_STORE);
+  ASSERT_EQUALS(store->code(),CPUI_STORE);
+  ASSERT_EQUALS(store->getIn(2)->getOffset(),3);
+  const LoadGuard *guard = env.fd->getStoreGuard(store);
+  ASSERT(guard != (const LoadGuard *)0);
+  ASSERT(guard->isValid(CPUI_STORE));
+  ASSERT(store->usesSpacebasePtr());
+  vector<PcodeOp *> indirects;
+  for(PcodeOp *op : returnedDefinitions(env.fd)) {
+    if (op->code() != CPUI_INDIRECT || PcodeOp::getOpFromConst(op->getIn(1)->getAddr()) != store) continue;
+    ASSERT(guard->mayAlias(op->getOut()->getAddr(),op->getOut()->getSize()));
+    ASSERT(!op->getOut()->hasNoLocalAlias());
+    indirects.push_back(op);
+  }
+  ASSERT_EQUALS(indirects.size(),2);
+  Varnode *pointer = store->getIn(1);
+  Varnode *value = store->getIn(2);
+  RuleIndirectCollapse rule("base");
+  for(PcodeOp *op : indirects)
+    ASSERT_EQUALS(rule.applyOp(op,*env.fd),0);
+  if (convert) {
+    env.fd->replaceVolatile(store);
+    ASSERT_EQUALS(store->code(),CPUI_CALLOTHER);
+    ASSERT_EQUALS(env.arch->userops.getOp(store->getIn(0)->getOffset())->getType(),UserPcodeOp::volatile_write);
+    ASSERT_EQUALS(store->getIn(1),pointer);
+    ASSERT_EQUALS(store->getIn(2),value);
+    ASSERT(store->usesSpacebasePtr());
+  }
+  ASSERT_EQUALS(store->getMemoryAccess(),CPUI_STORE);
+  ASSERT_EQUALS(store->getMemorySpace(),env.arch->getDefaultDataSpace());
+  ASSERT(guard->isValid(CPUI_STORE));
+  ASSERT(!guard->isValid(CPUI_LOAD));
+  for(PcodeOp *op : indirects)
+    ASSERT_EQUALS(rule.applyOp(op,*env.fd),0);
+  set<uintb> offsets = returnedStoreOffsets(env.fd,store);
+  ASSERT_EQUALS(offsets.size(),2);
+  ASSERT_EQUALS(offsets.count(0xfffffff0),1);
+  ASSERT_EQUALS(offsets.count(0x20),1);
+}
+
+TEST(qualified_ordinary_store_dependencies) { checkStoreDependencies(false); }
+TEST(qualified_volatile_store_dependencies) { checkStoreDependencies(true); }
