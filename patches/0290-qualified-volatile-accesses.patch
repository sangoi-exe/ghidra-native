+TEST(qualified_volatile_nonconstant_store_value) {
+  // Compute source+1 in AX, store it through RDI, and return that same nonconstant value.
+  QualifiedAccessEnvironment env("6689f06683c0016689070fb7c0c3");
+  TypeFactory *factory = env.arch->types;
+  Datatype *word = factory->getBase(2,TYPE_UINT);
+  env.setInput(factory->getTypePointer(8,factory->getQualifiedType(word,Datatype::qualifier_volatile),1));
+  PrototypePieces pieces;
+  env.fd->getFuncProto().getPieces(pieces);
+  pieces.intypes.push_back(word);
+  pieces.innames.push_back("source");
+  env.fd->getFuncProto().setPieces(pieces);
+  env.analyze();
+  ASSERT_EQUALS(env.effects(UserPcodeOp::volatile_write),1);
+  ASSERT_EQUALS(env.effects(UserPcodeOp::volatile_read),0);
+  PcodeOp *store = (PcodeOp *)0;
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (!op->isDead() && op->code() == CPUI_CALLOTHER && env.arch->userops.getOp(op->getIn(0)->getOffset())->getType() == UserPcodeOp::volatile_write)
+      store = op;
+  }
+  ASSERT(store != (PcodeOp *)0);
+  Varnode *value = store->getIn(2);
+  ASSERT(!value->isConstant());
+  ASSERT(!value->isTypeLock());
+  Varnode *source = env.fd->findVarnodeInput(2,env.arch->translate->getRegister("SI").getAddr());
+  ASSERT(source != (Varnode *)0);
+  ASSERT(source->isTypeLock());
+  Datatype *valueType = value->getHighTypeReadFacing(store);
+  string text = env.print();
+  ASSERT_EQUALS(source->getType(),word);
+  ASSERT_EQUALS(store->inputTypeLocal(2)->getQualifiers(),0);
+  ASSERT_EQUALS(value->getType()->getQualifiers(),0);
+  ASSERT_EQUALS(valueType->getQualifiers(),0);
+  ASSERT(text.find("volatile",text.find("volatile")+1) == string::npos);
+}
