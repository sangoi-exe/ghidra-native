+TEST(qualified_volatile_store_merge_interference) {
+  // Preserve a decoded external read across the conditional stack write and its returned sum.
+  QualifiedAccessEnvironment env("558bec83ec10c745f401000000c74524020000008b7d0c8b378d5df4837d080075038d5d24c703030000008b45f403452401f0c9c3","x86:LE:32:default:gcc");
+  env.analyze();
+  PcodeOp *load = memoryAccessAt(env,0x1017,CPUI_LOAD);
+  PcodeOp *store = memoryAccessAt(env,0x1025,CPUI_STORE);
+  const LoadGuard *guard = env.fd->getStoreGuard(store);
+  ASSERT(guard != (const LoadGuard *)0);
+  Varnode *aliased = (Varnode *)0;
+  for(PcodeOp *op : returnedDefinitions(env.fd)) {
+    if (op->code() == CPUI_INDIRECT && op->getOut()->getSpace() == env.arch->getStackSpace() &&
+        op->getOut()->getOffset() == 0xfffffff0 && PcodeOp::getOpFromConst(op->getIn(1)->getAddr()) == store)
+      aliased = op->getOut();
+  }
+  ASSERT(aliased != (Varnode *)0);
+  ASSERT(guard->mayAlias(aliased->getAddr(),aliased->getSize()));
+  Varnode *outside = env.fd->newVarnode(4,Address(env.arch->getStackSpace(),0x100));
+  ASSERT(!guard->mayAlias(outside->getAddr(),outside->getSize()));
+  Cover *crossing = load->getOut()->getCover();
+  ASSERT(crossing->contain(store,2));
+  ASSERT_EQUALS(crossing->getCoverBlock(store->getParent()->getIndex()).boundary(store),0);
+  for(int4 converted=0;converted<2;++converted) {
+    if (converted != 0)
+      env.fd->replaceVolatile(store);
+    StackAffectingOps affecting(*env.fd);
+    affecting.populate();
+    ASSERT(crossing->intersect(affecting,aliased));
+    ASSERT(!crossing->intersect(affecting,outside));
+  }
+}
