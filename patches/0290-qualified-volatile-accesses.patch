+static void checkQualifiedStackStore(bool negativeFirst) {
+  string pointerChoice = negativeFirst ? "8d5df4837d080075038d5d24" : "8d5d24837d080075038d5df4";
+  QualifiedAccessEnvironment env("558bec83ec10c745f401000000c7452402000000" + pointerChoice + "895df88b5df8c703030000008b45f4034524c9c3","x86:LE:32:default:gcc");
+  TypeFactory *factory = env.arch->types;
+  Datatype *word = factory->getQualifiedType(factory->getBase(4,TYPE_UINT),Datatype::qualifier_volatile);
+  TypePointer *pointer = factory->getTypePointer(4,word,1);
+  Scope *scope = env.fd->getScopeLocal();
+  Symbol *symbol = scope->addSymbol("selected",pointer,Address(env.arch->getStackSpace(),0xfffffff4),Address())->getSymbol();
+  scope->setAttribute(symbol,Varnode::typelock | Varnode::namelock);
+  env.analyze();
+  PcodeOp *store = memoryAccessAt(env,0x1026,CPUI_STORE);
+  ASSERT_EQUALS(store->code(),CPUI_CALLOTHER);
+  ASSERT_EQUALS(env.effects(UserPcodeOp::volatile_write),1);
+  ASSERT_EQUALS(store->getIn(2)->getOffset(),3);
+  set<uintb> offsets = returnedStoreOffsets(env.fd,store);
+  ASSERT_EQUALS(offsets.size(),2);
+  ASSERT_EQUALS(offsets.count(0xfffffff0),1);
+  ASSERT_EQUALS(offsets.count(0x20),1);
+}
