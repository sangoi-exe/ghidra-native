+bool ActionVolatile::hasVolatileComponent(Datatype *type)
+
+{
+  vector<Datatype *> worklist(1,type);
+  set<Datatype *> visited;
+  while(!worklist.empty()) {
+    Datatype *current = worklist.back();
+    worklist.pop_back();
+    if (!visited.insert(current).second || current->getMetatype() == TYPE_CODE) continue;
+    if (current->isVolatile()) return true;
+    for(int4 i=0;i<current->numDepend();++i)
+      worklist.push_back(current->getDepend(i));
+  }
+  return false;
+}
+
+int4 ActionVolatile::apply(Funcdata &data)
+
+{
+  vector<Varnode *> worklist;
+  for(VarnodeLocSet::const_iterator iter=data.beginLoc();iter!=data.endLoc();++iter) {
+    Varnode *vn = *iter;
+    if (!vn->isAnnotation() && !vn->isFree() && vn->getType()->getMetatype() == TYPE_PTR &&
+        hasVolatileComponent(((TypePointer *)vn->getType())->getPtrTo()))
+      worklist.push_back(vn);
+  }
+  // Follow established pointer types using the same opcode semantics as later type recovery.
+  while(!worklist.empty()) {
+    Varnode *vn = worklist.back();
+    worklist.pop_back();
+    for(list<PcodeOp *>::const_iterator iter=vn->beginDescend();iter!=vn->endDescend();++iter) {
+      PcodeOp *op = *iter;
+      Varnode *out = op->getOut();
+      if (out == (Varnode *)0 || out->isTypeLock()) continue;
+      Datatype *type;
+      if (op->code() == CPUI_INT_ADD || op->code() == CPUI_PTRADD || op->code() == CPUI_PTRSUB)
+        type = TypeOpIntAdd::propagateAddIn2Out(vn->getType(),data.getArch()->types,op,op->getSlot(vn),false);
+      else
+        type = op->getOpcode()->propagateType(vn->getType(),op,vn,out,op->getSlot(vn),-1);
+      if (type == (Datatype *)0 || type->getMetatype() != TYPE_PTR || type->getSize() != out->getSize()) continue;
+      if (type->typeOrder(*out->getType()) < 0 && out->updateType(type))
+        worklist.push_back(out);
+    }
+  }
+  for(PcodeOpTree::const_iterator iter=data.beginOpAll();iter!=data.endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead() || (op->code() != CPUI_LOAD && op->code() != CPUI_STORE)) continue;
+    int4 size = op->code() == CPUI_LOAD ? op->getOut()->getSize() : op->getIn(2)->getSize();
+    Datatype *type = TypeOp::propagateFromPointer(data.getArch()->types,op->getIn(1)->getType(),size);
+    if (type != (Datatype *)0 && type->isVolatile()) {
+      data.replaceVolatile(op);
+      count += 1;
+    }
+  }
+  return 0;
+}
