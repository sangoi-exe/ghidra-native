+class QualifiedAccessEnvironment {
+public:
+  unique_ptr<Architecture> arch;
+  Funcdata *fd;
+  QualifiedAccessEnvironment(const string &bytes,const string &language = "x86:LE:64:default:gcc",uintb entry = 0x1000) {
+    startDecompilerLibrary(getenv("SLEIGHHOME"));
+    ostringstream image;
+    image << "<binaryimage arch=\"" << language << "\"><bytechunk space=\"ram\" offset=\"0x" << hex << entry << "\" readonly=\"true\">" << bytes << "</bytechunk></binaryimage>";
+    istringstream input(image.str());
+    DocumentStorage store;
+    Document *document = store.parseDocument(input);
+    store.registerTag(document->getRoot());
+    arch.reset(ArchitectureCapability::getCapability("xml")->buildArchitecture("","",&cout));
+    arch->init(store);
+    fd = arch->symboltab->getGlobalScope()->addFunction(Address(arch->getDefaultCodeSpace(),entry),"access")->getFunction();
+  }
+  void setInput(Datatype *type,const string &model = "",int4 returnSize = 4) {
+    PrototypePieces pieces;
+    pieces.model = model.empty() ? arch->defaultfp : arch->getModel(model);
+    ASSERT(pieces.model != (ProtoModel *)0);
+    pieces.outtype = arch->types->getBase(returnSize,TYPE_UINT);
+    pieces.intypes.push_back(type);
+    pieces.innames.push_back("input");
+    pieces.firstVarArgSlot = -1;
+    fd->getFuncProto().setPieces(pieces);
+  }
+  void analyze(void) {
+    arch->allacts.getCurrent()->reset(*fd);
+    ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
+  }
+  int4 effects(uint4 type,bool indirect = true) {
+    int4 result = 0;
+    for(PcodeOpTree::const_iterator iter=fd->beginOpAll();iter!=fd->endOpAll();++iter) {
+      PcodeOp *op = (*iter).second;
+      if (op->isDead() || op->code() != CPUI_CALLOTHER) continue;
+      if (arch->userops.getOp(op->getIn(0)->getOffset())->getType() != type) continue;
+      ASSERT_EQUALS(!op->getIn(1)->isAnnotation(),indirect);
+      if (indirect) {
+        ASSERT_EQUALS(op->getMemoryAccess(),type == UserPcodeOp::volatile_read ? CPUI_LOAD : CPUI_STORE);
+        ASSERT_EQUALS(op->numInput(),type == UserPcodeOp::volatile_read ? 3 : 4);
+        ASSERT_EQUALS(op->getIn(op->numInput()-1)->getOffset(),arch->getDefaultDataSpace()->getIndex());
+        ASSERT(op->getIn(1)->getType()->getMetatype() == TYPE_PTR);
+        ASSERT(!op->getIn(1)->isVolatile());
+      }
+      ++result;
+    }
+    return result;
+  }
+  int4 loads(void) {
+    int4 result = 0;
+    for(PcodeOpTree::const_iterator iter=fd->beginOpAll();iter!=fd->endOpAll();++iter) {
+      PcodeOp *op = (*iter).second;
+      if (!op->isDead() && op->code() == CPUI_LOAD)
+        ++result;
+    }
+    return result;
+  }
+  set<uintb> readOffsets(bool qualified) {
+    set<uintb> offsets;
+    for(PcodeOpTree::const_iterator iter=fd->beginOpAll();iter!=fd->endOpAll();++iter) {
+      PcodeOp *op = (*iter).second;
+      if (op->isDead()) continue;
+      if (qualified) {
+        if (op->code() != CPUI_CALLOTHER || arch->userops.getOp(op->getIn(0)->getOffset())->getType() != UserPcodeOp::volatile_read) continue;
+      }
+      else if (op->code() != CPUI_LOAD) continue;
+      offsets.insert(op->getAddr().getOffset());
+    }
+    return offsets;
+  }
+  string print(bool markup = false) {
+    ostringstream output;
+    arch->print->setOutputStream(&output);
+    arch->print->setMarkup(markup);
+    arch->print->docFunction(fd);
+    arch->print->setOutputStream((ostream *)0);
+    arch->print->setMarkup(false);
+    return output.str();
+  }
+};
+
+TEST(qualified_volatile_unused_read) {
+  for(int4 qualifiers : {0,(int4)Datatype::qualifier_const,(int4)Datatype::qualifier_volatile}) {
+    QualifiedAccessEnvironment env("0fb7070fb707c3");
+    TypeFactory *factory = env.arch->types;
+    Datatype *word = factory->getQualifiedType(factory->getBase(2,TYPE_UINT),qualifiers);
+    env.setInput(factory->getTypePointer(8,word,1));
+    env.analyze();
+    bool observable = qualifiers == Datatype::qualifier_volatile;
+    ASSERT_EQUALS(env.effects(UserPcodeOp::volatile_read),observable ? 2 : 0);
+    ASSERT_EQUALS(env.loads(),observable ? 0 : 1);
+    Varnode *input = env.fd->findVarnodeInput(8,env.arch->translate->getRegister("RDI").getAddr());
+    ASSERT(input != (Varnode *)0);
+    ASSERT(!input->isReadOnly());
+    ASSERT(!input->isVolatile());
+    string text = env.print();
+    ASSERT(text.find("read_volatile") == string::npos);
+    if (observable) {
+      ASSERT(text.find("volatile") != string::npos);
+      ASSERT(text.find("volatile",text.find("volatile")+1) == string::npos);
