+static set<PcodeOp *> returnedDefinitions(Funcdata *fd) {
+  vector<Varnode *> worklist;
+  set<PcodeOp *> definitions;
+  for(PcodeOpTree::const_iterator iter=fd->beginOpAll();iter!=fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (!op->isDead() && op->code() == CPUI_RETURN && op->numInput() == 2)
+      worklist.push_back(op->getIn(1));
+  }
+  while(!worklist.empty()) {
+    Varnode *value = worklist.back();
+    worklist.pop_back();
+    if (!value->isWritten()) continue;
+    PcodeOp *op = value->getDef();
+    if (!definitions.insert(op).second) continue;
+    for(int4 i=0;i<op->numInput();++i)
+      worklist.push_back(op->getIn(i));
+  }
+  return definitions;
+}
+
+static set<uintb> returnedStoreOffsets(Funcdata *fd,PcodeOp *effect) {
+  set<uintb> offsets;
+  for(PcodeOp *op : returnedDefinitions(fd)) {
+    if (op->code() == CPUI_INDIRECT && PcodeOp::getOpFromConst(op->getIn(1)->getAddr()) == effect &&
+        op->getOut()->getSpace() == fd->getArch()->getStackSpace() && op->getOut()->getSize() == 4)
+      offsets.insert(op->getOut()->getOffset());
+  }
+  return offsets;
+}
+
+static PcodeOp *memoryAccessAt(QualifiedAccessEnvironment &env,uintb address,OpCode access) {
+  PcodeOp *result = (PcodeOp *)0;
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead() || op->getAddr().getOffset() != address || op->getMemoryAccess() != access) continue;
+    ASSERT(result == (PcodeOp *)0);
+    result = op;
+  }
+  ASSERT(result != (PcodeOp *)0);
+  return result;
+}
