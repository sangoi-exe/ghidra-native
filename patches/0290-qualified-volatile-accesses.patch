+    Document *document = store.parseDocument(input);
+    store.registerTag(document->getRoot());
+    arch.reset(ArchitectureCapability::getCapability("xml")->buildArchitecture("","",&cout));
+    arch->init(store);
+    fd = arch->symboltab->getGlobalScope()->addFunction(Address(arch->getDefaultCodeSpace(),0x1000),"access")->getFunction();
+  }
+  void setInput(Datatype *type) {
+    PrototypePieces pieces;
+    pieces.model = arch->defaultfp;
+    pieces.outtype = arch->types->getBase(4,TYPE_UINT);
+    pieces.intypes.push_back(type);
+    pieces.innames.push_back("input");
+    pieces.firstVarArgSlot = -1;
+    fd->getFuncProto().setPieces(pieces);
+  }
+  void analyze(void) {
+    arch->allacts.getCurrent()->reset(*fd);
+    ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
