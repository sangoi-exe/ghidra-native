+/// Preserve an indirect memory access using the existing volatile userop and a pointer operand.
+void Funcdata::replaceVolatile(PcodeOp *op)
+
+{
+  bool read = op->code() == CPUI_LOAD;
+  UserPcodeOp *userop = glb->userops.registerBuiltin(read ? UserPcodeOp::BUILTIN_VOLATILE_READ : UserPcodeOp::BUILTIN_VOLATILE_WRITE);
+  vector<Varnode *> inputs;
+  inputs.push_back(newConstant(4,userop->getIndex()));
+  inputs.push_back(op->getIn(1));
+  if (!read)
+    inputs.push_back(op->getIn(2));
+  inputs.push_back(newConstant(4,op->getIn(0)->getSpaceFromConst()->getIndex())); // Serialize the space index, not an AddrSpace pointer.
+  opSetAllInput(op,inputs);
+  opSetOpcode(op,CPUI_CALLOTHER);
+  op->setAdditionalFlag(PcodeOp::special_prop);
+  if (read)
+    op->setHoldOutput();
+}
