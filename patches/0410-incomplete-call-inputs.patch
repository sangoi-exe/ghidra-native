+TEST(segmented_model_hole_storage_inputs) {
+  // Exact 72-byte saved-frame witness; the separate reused-cell case calls at 0x1010.
+  const string bytes = "5589e583e4f083ec10892c2490909090c744240407000000e8230000008b6c240089ec5dc30000000000000000000000000000000000000000000000000000008b44240883c003c3";
+  ASSERT_EQUALS(bytes.size(),144);
+  SegmentedEnvironment env(false,"x86:LE:32:default:gcc",bytes);
+  AddrSpace *ram = env.arch->getDefaultCodeSpace();
+  AddrSpace *stack = env.arch->getStackSpace();
+  Funcdata *callee = env.arch->symboltab->getGlobalScope()->addFunction(Address(ram,0x1040),"stack_argument_consumer")->getFunction();
+  callee->getFuncProto().setModel(env.arch->defaultfp);
+  ASSERT(callee->getObservedInputStorages().empty());
+  checkModelHoleCaller(env,callee,false);
+  env.arch->clearAnalysis(env.fd);
+  ASSERT_EQUALS(env.fd->numCalls(),0);
+  Action *root = env.arch->allacts.getCurrent();
+  root->reset(*callee);
+  ASSERT(root->perform(*callee) >= 0);
+  ASSERT(!callee->getFuncProto().isInputLocked());
+  ASSERT_EQUALS(callee->getObservedInputStorages().size(),1);
+  ASSERT(hasInputStorage(callee->getObservedInputStorages(),Address(stack,8),4));
+  ASSERT(!hasInputStorage(callee->getObservedInputStorages(),Address(stack,4),4));
+  Varnode *input = callee->findVarnodeInput(4,Address(stack,8));
+  ASSERT(input != (Varnode *)0);
+  bool consumed = false;
+  for(PcodeOpTree::const_iterator iter=callee->beginOpAll();iter!=callee->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead() || op->code() != CPUI_RETURN || op->numInput() != 2) continue;
+    Varnode *returned = op->getIn(1);
+    while(returned->isWritten() && (returned->getDef()->code() == CPUI_COPY || returned->getDef()->code() == CPUI_CAST))
+      returned = returned->getDef()->getIn(0);
+    ASSERT(returned->isWritten());
+    PcodeOp *add = returned->getDef();
+    ASSERT_EQUALS(add->code(),CPUI_INT_ADD);
+    ASSERT(tasm31DependsOn(add->getIn(0),input));
+    ASSERT(add->getIn(1)->isConstant());
+    ASSERT_EQUALS(add->getIn(1)->getOffset(),3);
+    consumed = true;
+  }
+  ASSERT(consumed);
+  FuncCallSpecs *spec = checkModelHoleCaller(env,callee,true);
+  env.arch->clearAnalysis(env.fd);
+  ASSERT_EQUALS(env.fd->numCalls(),0);
+  ASSERT(env.arch->commentdb->beginComment(env.fd->getAddress()) == env.arch->commentdb->endComment(env.fd->getAddress()));
+  spec = checkModelHoleCaller(env,callee,true);
+  env.arch->clearAnalysis(callee);
+  ASSERT(callee->getObservedInputStorages().empty());
+  env.arch->clearAnalysis(env.fd);
+  checkModelHoleCaller(env,callee,false);
+  env.arch->clearAnalysis(env.fd);
+  root->reset(*callee);
+  ASSERT(root->perform(*callee) >= 0);
+  spec = checkModelHoleCaller(env,callee,true);
+  PcodeOp *call = spec->getOp();
+  PcodeOp *copy = env.fd->cloneOp(call,SeqNum(call->getAddr(),0xf000));
+  env.fd->opInsertBefore(copy,call);
+  unique_ptr<FuncCallSpecs> clone(spec->clone(copy));
+  Varnode *oldTarget = copy->getIn(0);
+  Varnode *target = env.fd->newVarnodeCallSpecs(clone.get());
+  env.fd->opSetInput(copy,target,0);
+  env.fd->deleteVarnode(oldTarget);
+  ASSERT(clone->hasStorageInputs());
+  ASSERT_EQUALS(clone->getInputStorage(1)->getAddr(),Address(stack,8));
+  ASSERT_EQUALS(clone->getInputStorage(1)->size,4);
+  ASSERT(copy->getIn(1) != call->getIn(1));
+  env.fd->opSetInput(copy,env.fd->newConstant(4,17),1);
+  ASSERT_EQUALS(clone->getOp()->getIn(1)->getOffset(),17);
+  ASSERT_EQUALS(call->getIn(1)->getOffset(),7);
+  // An explicit storage contract replaces inferred mapping; a missing first storage still requests restart.
+  FuncProto contract;
+  contract.setInternal(env.arch->defaultfp,env.arch->types->getTypeVoid());
+  ParameterPieces parameter;
+  parameter.addr = Address(stack,8);
+  parameter.type = env.arch->types->getBase(4,TYPE_UINT);
+  parameter.flags = ParameterPieces::typelock;
+  contract.setParam(0,"supplied",parameter);
+  contract.setInputLock(true);
+  clone->forceSet(*env.fd,contract);
+  ASSERT(!env.fd->hasRestartPending());
+  ASSERT(!clone->hasStorageInputs());
+  ASSERT(clone->isInputLocked());
+  ASSERT_EQUALS(clone->getInputParameter(1)->getAddress(),Address(stack,8));
+  ASSERT_EQUALS(copy->getIn(1)->getOffset(),17);
+  ASSERT(clone->getUnresolvedInputStorages().empty());
+  parameter.addr = Address(stack,4);
+  contract.setParam(0,"missing",parameter);
+  spec->forceSet(*env.fd,contract);
+  ASSERT(env.fd->hasRestartPending());
+  ASSERT(spec->hasStorageInputs());
+  env.fd->opDestroy(copy);
+  env.fd->deleteVarnode(target);
+  env.arch->clearAnalysis(env.fd);
+  root->reset(*env.fd);
+  ASSERT(root->perform(*env.fd) >= 0);
+  ASSERT_EQUALS(env.fd->numCalls(),1);
+  spec = env.fd->getCallSpecs(0);
+  ASSERT(spec->isInputLocked());
+  ASSERT(!spec->hasStorageInputs());
+  ASSERT_EQUALS(spec->getOp()->numInput(),2);
+  ASSERT_EQUALS(spec->getInputParameter(1)->getAddress(),Address(stack,4));
+  ASSERT(spec->getUnresolvedInputStorages().empty());
+}
