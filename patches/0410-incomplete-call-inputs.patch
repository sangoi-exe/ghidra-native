+/// A completed positive-use snapshot is independent of formal model selection and establishes no negative facts.
+bool FuncCallSpecs::hasObservedInputUse(const ParamTrial &trial) const
+
+{
+  if (fd == (Funcdata *)0) return false;
+  const vector<VarnodeData> &observed(fd->getObservedInputStorages());
