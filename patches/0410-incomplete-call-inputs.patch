+TEST(segmented_observed_and_unselected_inputs) {
+  const string bytes = "5589e583e4f083ec10c744240407000000c744240809000000e82200000089ec5dc30000000000000000000000000000000000000000000000000000000000008b44240883c003c3";
+  ASSERT_EQUALS(bytes.size(),144);
+  SegmentedEnvironment env(false,"x86:LE:32:default:gcc",bytes);
+  AddrSpace *ram = env.arch->getDefaultCodeSpace();
+  AddrSpace *stack = env.arch->getStackSpace();
+  Funcdata *callee = env.arch->symboltab->getGlobalScope()->addFunction(Address(ram,0x1040),"stack_argument_consumer")->getFunction();
+  callee->getFuncProto().setModel(env.arch->defaultfp);
+  Action *root = env.arch->allacts.getCurrent();
+  root->reset(*callee);
+  ASSERT(root->perform(*callee) >= 0);
+  ASSERT_EQUALS(callee->getObservedInputStorages().size(),1);
+  ASSERT(hasInputStorage(callee->getObservedInputStorages(),Address(stack,8),4));
+  root->reset(*env.fd);
+  ASSERT(root->perform(*env.fd) >= 0);
+  ASSERT_EQUALS(env.fd->numCalls(),1);
+  FuncCallSpecs *spec = env.fd->getCallSpecs(0);
+  PcodeOp *call = spec->getOp();
+  ASSERT_EQUALS(call->getAddr(),Address(ram,0x1019));
+  ASSERT_EQUALS(spec->getEntryAddress(),callee->getAddress());
+  ASSERT(spec->hasStorageInputs());
+  ASSERT_EQUALS(call->numInput(),2);
+  ASSERT(call->getIn(1)->isConstant());
+  ASSERT_EQUALS(call->getIn(1)->getSize(),4);
+  ASSERT_EQUALS(call->getIn(1)->getOffset(),7);
+  const VarnodeData *storage = spec->getInputStorage(1);
+  ASSERT(storage != (const VarnodeData *)0);
+  ASSERT_EQUALS(storage->getAddr(),Address(stack,8));
+  ASSERT_EQUALS(storage->size,4);
+  ASSERT(!hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,4),4));
+  ASSERT(!hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,8),4));
+  ASSERT(hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,12),4));
+  bool storedSeven = false;
+  bool storedNine = false;
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead() || op->code() != CPUI_STORE) continue;
+    Varnode *value = op->getIn(2);
+    if (!value->isConstant() || value->getSize() != 4) continue;
+    if (value->getOffset() == 7 && op->getAddr() == Address(ram,0x1009)) storedSeven = true;
+    if (value->getOffset() == 9 && op->getAddr() == Address(ram,0x1011)) storedNine = true;
+  }
+  ASSERT(storedSeven);
+  ASSERT(storedNine);
+}
