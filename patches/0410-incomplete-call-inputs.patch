+/// Storage inputs are real operands, but their order is not a source argument list.
+void PrintC::opStorageCall(const PcodeOp *op,const FuncCallSpecs *fc)
+
+{
+  pushOp(&function_call,op);
+  pushAtom(Atom("__call_incomplete",optoken,EmitMarkup::no_color,op));
+  for(int4 i=1;i<op->numInput();++i)
+    pushOp(&comma,op);
+  if (op->code() == CPUI_CALLIND)
+    pushVn(op->getIn(0),op,mods);
+  else {
+    Funcdata *callee = fc->getFuncdata();
+    if (callee != (Funcdata *)0)
+      pushSymbolScope(callee->getSymbol());
+    string name = fc->getName().empty() ? genericFunctionName(fc->getEntryAddress()) : fc->getName();
+    pushAtom(Atom(name,functoken,EmitMarkup::funcname_color,op,(const Funcdata *)0));
+  }
+  for(int4 i=1;i<op->numInput();++i) {
+    const VarnodeData &storage(*fc->getInputStorage(i));
+    pushOp(&function_call,op);
+    pushAtom(Atom("__input_storage",optoken,EmitMarkup::no_color,op));
+    for(int4 j=0;j<3;++j)
+      pushOp(&comma,op);
+    pushAtom(Atom("\"" + storage.space->getName() + "\"",syntax,EmitMarkup::const_color));
+    ostringstream offset;
+    offset << "0x" << hex << storage.offset;
+    pushAtom(Atom(offset.str(),syntax,EmitMarkup::const_color));
+    pushAtom(Atom(to_string(storage.size),syntax,EmitMarkup::const_color));
+    pushVn(op->getIn(i),op,mods);
+  }
+}
