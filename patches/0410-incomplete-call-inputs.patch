+TEST(segmented_unselected_input_uncertainty) {
+  const string bytes = "5589e583e4f083ec1090909090909090c744240407000000e8230000009090909089ec5dc30000000000000000000000000000000000000000000000000000008b44240883c003c3";
+  ASSERT_EQUALS(bytes.size(),144);
+  SegmentedEnvironment env(false,"x86:LE:32:default:gcc",bytes);
+  AddrSpace *ram = env.arch->getDefaultCodeSpace();
+  AddrSpace *stack = env.arch->getStackSpace();
+  Funcdata *callee = env.arch->symboltab->getGlobalScope()->addFunction(Address(ram,0x1040),"stack_argument_consumer")->getFunction();
+  callee->getFuncProto().setModel(env.arch->defaultfp);
+  ASSERT(callee->getObservedInputStorages().empty());
+  Action *root = env.arch->allacts.getCurrent();
+  root->reset(*env.fd);
+  ASSERT(root->perform(*env.fd) >= 0);
+  ASSERT_EQUALS(env.fd->numCalls(),1);
+  FuncCallSpecs *spec = env.fd->getCallSpecs(0);
+  PcodeOp *call = spec->getOp();
+  ASSERT_EQUALS(call->getAddr(),Address(ram,0x1018));
+  ASSERT_EQUALS(spec->getEntryAddress(),callee->getAddress());
+  ASSERT_EQUALS(spec->getFuncdata(),callee);
+  ASSERT(!spec->isInputLocked());
+  ASSERT(!spec->hasStorageInputs());
+  ASSERT_EQUALS(call->numInput(),1);
+  bool storedSeven = false;
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead() || op->code() != CPUI_STORE) continue;
+    Varnode *value = op->getIn(2);
+    if (value->isConstant() && value->getSize() == 4 && value->getOffset() == 7) {
+      ASSERT_EQUALS(op->getAddr(),Address(ram,0x1010));
+      storedSeven = true;
+    }
+  }
+  ASSERT(storedSeven);
+  const vector<VarnodeData> &unresolved(spec->getUnresolvedInputStorages());
+  bool initialUnresolved = hasInputStorage(unresolved,Address(stack,8),4);
+  ASSERT(!hasInputStorage(unresolved,Address(stack,4),4));
+  ostringstream output;
+  env.arch->print->setOutputStream(&output);
+  env.arch->print->docFunction(env.fd);
+  bool initialWarning = output.str().find("Incomplete call input recovery") != string::npos && output.str().find("stack[0x8:4]") != string::npos;
+  env.arch->print->setOutputStream((ostream *)0);
+  env.arch->clearAnalysis(env.fd);
+  ASSERT_EQUALS(env.fd->numCalls(),0);
+  root->reset(*callee);
+  ASSERT(root->perform(*callee) >= 0);
+  ASSERT(!callee->getFuncProto().isInputLocked());
+  ASSERT_EQUALS(callee->getObservedInputStorages().size(),1);
+  ASSERT(hasInputStorage(callee->getObservedInputStorages(),Address(stack,8),4));
+  ASSERT(!hasInputStorage(callee->getObservedInputStorages(),Address(stack,4),4));
+  Varnode *input = callee->findVarnodeInput(4,Address(stack,8));
+  ASSERT(input != (Varnode *)0);
+  bool consumed = false;
+  for(PcodeOpTree::const_iterator iter=callee->beginOpAll();iter!=callee->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead() || op->code() != CPUI_RETURN || op->numInput() != 2) continue;
+    Varnode *returned = op->getIn(1);
+    while(returned->isWritten() && (returned->getDef()->code() == CPUI_COPY || returned->getDef()->code() == CPUI_CAST))
+      returned = returned->getDef()->getIn(0);
+    ASSERT(returned->isWritten());
+    PcodeOp *add = returned->getDef();
+    ASSERT_EQUALS(add->code(),CPUI_INT_ADD);
+    ASSERT(tasm31DependsOn(add->getIn(0),input));
+    ASSERT(add->getIn(1)->isConstant());
+    ASSERT_EQUALS(add->getIn(1)->getOffset(),3);
+    consumed = true;
+  }
+  ASSERT(consumed);
+  root->reset(*env.fd);
+  ASSERT(root->perform(*env.fd) >= 0);
+  ASSERT_EQUALS(env.fd->numCalls(),1);
+  spec = env.fd->getCallSpecs(0);
+  call = spec->getOp();
+  ASSERT_EQUALS(call->getAddr(),Address(ram,0x1018));
+  ASSERT(spec->hasStorageInputs());
+  ASSERT_EQUALS(call->numInput(),2);
+  ASSERT(call->getIn(1)->isConstant());
+  ASSERT_EQUALS(call->getIn(1)->getSize(),4);
+  ASSERT_EQUALS(call->getIn(1)->getOffset(),7);
+  const VarnodeData *storage = spec->getInputStorage(1);
+  ASSERT(storage != (const VarnodeData *)0);
+  ASSERT_EQUALS(storage->getAddr(),Address(stack,8));
+  ASSERT_EQUALS(storage->size,4);
+  ASSERT(spec->getInputStorage(2) == (const VarnodeData *)0);
+  ASSERT(!hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,8),4));
+  ASSERT(!hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,4),4));
+  ASSERT(initialUnresolved);
+  ASSERT(initialWarning);
+}
