+static FuncCallSpecs *checkModelHoleCaller(SegmentedEnvironment &env,Funcdata *callee,bool observed) {
+  AddrSpace *ram = env.arch->getDefaultCodeSpace();
+  AddrSpace *stack = env.arch->getStackSpace();
+  Action *root = env.arch->allacts.getCurrent();
+  root->reset(*env.fd);
+  ASSERT(root->perform(*env.fd) >= 0);
+  ASSERT_EQUALS(env.fd->numCalls(),1);
+  FuncCallSpecs *spec = env.fd->getCallSpecs(0);
+  PcodeOp *call = spec->getOp();
+  ASSERT_EQUALS(call->getAddr(),Address(ram,0x1018));
+  ASSERT_EQUALS(spec->getEntryAddress(),callee->getAddress());
+  ASSERT_EQUALS(spec->getFuncdata(),callee);
+  ASSERT(!spec->isInputLocked());
+  ASSERT(!spec->isInputActive());
+  ASSERT(!env.fd->hasRestartPending());
+  ASSERT_EQUALS(spec->hasStorageInputs(),observed);
+  ASSERT_EQUALS(call->numInput(),observed ? 2 : 1);
+  ASSERT(hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,4),4));
+  ASSERT(spec->getInputStorage(0) == (const VarnodeData *)0);
+  ASSERT(spec->getInputStorage(2) == (const VarnodeData *)0);
+  if (observed) {
+    const VarnodeData *storage = spec->getInputStorage(1);
+    ASSERT(storage != (const VarnodeData *)0);
+    ASSERT_EQUALS(storage->getAddr(),Address(stack,8));
+    ASSERT_EQUALS(storage->size,4);
+    ASSERT_EQUALS(call->getIn(1)->getSize(),storage->size);
+    ASSERT(call->getIn(1)->isConstant());
+    ASSERT_EQUALS(call->getIn(1)->getOffset(),7);
+    ASSERT(spec->getInputParameter(1) == (ProtoParameter *)0);
+    ASSERT_EQUALS(spec->getActiveInput()->getNumTrials(),0);
+    ASSERT_EQUALS(spec->getInputBytesConsumed(1),0);
+    ASSERT(!spec->setInputBytesConsumed(1,1));
+  }
+  bool storedSeven = false;
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead() || op->code() != CPUI_STORE) continue;
+    Varnode *value = op->getIn(2);
+    if (value->isConstant() && value->getSize() == 4 && value->getOffset() == 7) {
+      ASSERT_EQUALS(op->getAddr(),Address(ram,0x1010));
+      storedSeven = true;
+    }
+  }
+  ASSERT(storedSeven);
+  ostringstream output;
+  env.arch->print->setOutputStream(&output);
+  env.arch->print->docFunction(env.fd);
+  const string notation = "__call_incomplete(stack_argument_consumer,__input_storage(\"stack\",0x8,4,7))";
+  string compact;
+  for(char c : output.str()) {
+    if (!isspace((unsigned char)c)) compact += c;
+  }
+  ASSERT(compact.find("Incompletecallinputrecovery") != string::npos);
+  ASSERT(compact.find("stack[0x4:4]") != string::npos);
+  ASSERT_EQUALS(compact.find(notation) != string::npos,observed);
+  ASSERT_EQUALS(compact.find("stack_argument_consumer()") != string::npos,!observed);
+  output.str("");
+  env.arch->print->setMarkup(true);
+  env.arch->print->setPackedOutput(false);
+  env.arch->print->docFunction(env.fd);
+  istringstream xml(output.str());
+  DocumentStorage documents;
+  Document *doc = documents.parseDocument(xml);
+  vector<const Element *> pending(1,doc->getRoot());
+  bool operatorToken = false;
+  bool valueToken = false;
+  bool targetToken = false;
+  while(!pending.empty()) {
+    const Element *element = pending.back();
+    pending.pop_back();
+    if (element->getName() == "op" && element->getContent() == "__call_incomplete") {
+      ASSERT_EQUALS(std::stoull(element->getAttributeValue("opref"),(size_t *)0,0),call->getTime());
+      operatorToken = true;
+    }
+    if (observed && element->getName() == "variable" && element->getContent() == "7") {
+      if (std::stoull(element->getAttributeValue("varref"),(size_t *)0,0) == call->getIn(1)->getCreateIndex())
+        valueToken = true;
+    }
+    if (element->getName() == "funcname" && element->getContent() == "stack_argument_consumer") {
+      ASSERT_EQUALS(std::stoull(element->getAttributeValue("opref"),(size_t *)0,0),call->getTime());
+      targetToken = true;
+    }
+    const List &children(element->getChildren());
+    for(List::const_reverse_iterator iter=children.rbegin();iter!=children.rend();++iter)
+      pending.push_back(*iter);
+  }
+  ASSERT_EQUALS(operatorToken,observed);
+  ASSERT_EQUALS(valueToken,observed);
+  ASSERT(targetToken);
+  env.arch->print->setMarkup(false);
+  env.arch->print->setOutputStream((ostream *)0);
+  return spec;
+}
