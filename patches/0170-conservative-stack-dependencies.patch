+/// Check whether any byte of storage intersects a guard range, including circular storage.
+static bool guardRangesOverlap(const RangeList &ranges,const Address &addr,uintb size)
+
+{
+  AddrSpace *spc = addr.getSpace();
+  uintb first = addr.getOffset();
+  uintb last = spc->wrapOffset(first + size - 1);
+  for(set<Range>::const_iterator iter=ranges.begin();iter!=ranges.end();++iter) {
+    const Range &range(*iter);
+    if (range.getSpace() != spc) continue;
+    if (size - 1 >= spc->getHighest()) return true;
+    if (first <= last) {
+      if (first <= range.getLast() && last >= range.getFirst()) return true;
+    }
+    else if (first <= range.getLast() || last >= range.getFirst())
+      return true;
+  }
+  return false;
+}
