+TEST(segmented_finite_wrapping_stack_guard) {
+  // Native-generated stack p-code exercises the 16-bit circular solver hull without segment-selector encoding.
+  SegmentedEnvironment env(true);
+  AddrSpace *stack = env.arch->getStackSpace();
+  Varnode *sp = env.fd->constructSpacebaseInput(stack);
+  Datatype *word = env.arch->types->getBase(2,TYPE_UNKNOWN);
+  Datatype *boolean = env.arch->types->getBase(1,TYPE_BOOL);
+  Varnode *input = env.fd->setInputVarnode(env.fd->newVarnode(2,env.arch->translate->getRegister("AX").getAddr()));
+  Varnode *test = env.op(CPUI_INT_EQUAL,{input,env.constant(2,0)},boolean)->getOut();
+  Varnode *index = env.op(CPUI_INT_ZEXT,{test},word)->getOut();
+  Varnode *scaled = env.op(CPUI_INT_MULT,{index,env.constant(2,47)},word)->getOut();
+  Varnode *offset = env.op(CPUI_INT_ADD,{scaled,index},word)->getOut();
+  Varnode *base = env.op(CPUI_INT_ADD,{sp,env.constant(2,0xfff0)},word)->getOut();
+  Varnode *pointer = env.op(CPUI_INT_ADD,{base,offset},word)->getOut();
+  PcodeOp *store = env.op(CPUI_STORE,{env.fd->newVarnodeSpace(stack->getContain()),pointer,env.constant(1,3)});
+  for(int4 i=0;i<3;++i)
+    env.fd->opHeritage();
+  const LoadGuard *guard = env.fd->getStoreGuard(store);
+  ASSERT(guard != (const LoadGuard *)0);
+  ASSERT_EQUALS(guard->getMinimum(),0xfff0);
+  ASSERT_EQUALS(guard->getMaximum(),0xffff);
+  ASSERT(guard->mayAlias(Address(stack,0x20),1));
+  ASSERT(guard->mayAlias(Address(stack,0xfff0),1));
+  ASSERT(!guard->mayAlias(Address(stack,0x100),1));
+}
+
+TEST(flat_discarded_stack_guard) {
+  // The two pointer endpoints yield the solver hull [0x20,0x10020), discarded by layout recovery.
+  DecodedStackAccess env("x86:LE:32:default:gcc","558bec83ec10c74524070000008d5d24837d080075068d9d23000100c703030000008b4524c9c3");
+  ASSERT_EQUALS(env.storeGuard().getMinimum(),0x20);
+  ASSERT_EQUALS(env.storeGuard().getMaximum(),0x101f);
+  ASSERT(env.mayAlias(0x8020,1));
+  ASSERT(env.mayAlias(0x20,1));
+  ASSERT(!env.mayAlias(0x10024,1));
+  ASSERT(!env.storeGuard().mayAlias(Address(env.arch->getDefaultCodeSpace(),0x8020),1));
+}
+
+TEST(flat_large_finite_stack_guard) {
+  // The real solver supplies a finite range larger than the 0x1000 layout hint.
+  DecodedStackAccess env("x86:LE:32:default:gcc","558bec83ec10c74524070000008d5d24837d080075068d9d23000002c703030000008b4524c9c3");
+  ASSERT_EQUALS(env.storeGuard().getMinimum(),0x20);
+  ASSERT_EQUALS(env.storeGuard().getMaximum(),0x101f);
+  ASSERT(env.mayAlias(0x1800020,1));
+  ASSERT(!env.mayAlias(0x2000024,1));
+}
