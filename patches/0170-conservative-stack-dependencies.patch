+class DecodedStackAccess {
+public:
+  unique_ptr<Architecture> arch;
+  Funcdata *fd;
+  DecodedStackAccess(const string &language,const string &bytes) {
+    SegmentedEnvironment::initialize();
+    istringstream image("<binaryimage arch=\"" + language + "\"><bytechunk space=\"ram\" offset=\"0x1000\" readonly=\"true\">" + bytes + "</bytechunk></binaryimage>");
+    DocumentStorage store;
+    Document *doc = store.parseDocument(image);
+    store.registerTag(doc->getRoot());
+    arch.reset(ArchitectureCapability::getCapability("xml")->buildArchitecture("", "", &cout));
+    arch->init(store);
+    fd = arch->symboltab->getGlobalScope()->addFunction(Address(arch->getDefaultCodeSpace(),0x1000),"stack_access")->getFunction();
+    arch->allacts.getCurrent()->reset(*fd);
+    ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
+  }
+  const LoadGuard &storeGuard(void) const {
+    const LoadGuard *result = (const LoadGuard *)0;
+    const list<LoadGuard> &guards(fd->getStoreGuards());
+    for(list<LoadGuard>::const_iterator iter=guards.begin();iter!=guards.end();++iter) {
+      if (!(*iter).isValid(CPUI_STORE)) continue;
+      ASSERT(result == (const LoadGuard *)0);
+      result = &*iter;
+    }
+    ASSERT(result != (const LoadGuard *)0);
+    return *result;
+  }
+  bool mayAlias(uintb offset,int4 size) const {
+    return storeGuard().mayAlias(Address(arch->getStackSpace(),offset),size);
+  }
+  void checkReturnedStoreEffect(void) const {
+    PcodeOp *store = storeGuard().getOp();
+    vector<Varnode *> worklist;
+    set<Varnode *> visited;
+    for(PcodeOpTree::const_iterator iter=fd->beginOpAll();iter!=fd->endOpAll();++iter) {
+      PcodeOp *op = (*iter).second;
+      if (!op->isDead() && op->code() == CPUI_RETURN && op->numInput() == 2)
+        worklist.push_back(op->getIn(1));
+    }
+    while(!worklist.empty()) {
+      Varnode *value = worklist.back();
+      worklist.pop_back();
+      if (!value->isWritten() || !visited.insert(value).second) continue;
+      PcodeOp *def = value->getDef();
+      if (def->code() == CPUI_INDIRECT && PcodeOp::getOpFromConst(def->getIn(1)->getAddr()) == store)
+        return;
+      for(int4 i=0;i<def->numInput();++i)
+        worklist.push_back(def->getIn(i));
+    }
+    ASSERT(false);
+  }
+};
+
+static void checkFlatConditionalStackStore(const string &bytes)
+
+{
+  DecodedStackAccess env("x86:LE:32:default:gcc",bytes);
+  AddrSpace *stack = env.arch->getStackSpace();
+  PcodeOp *store = env.storeGuard().getOp();
+  ASSERT_EQUALS(store->getAddr().getOffset(),0x1020);
+  ASSERT_EQUALS(store->getIn(2)->getOffset(),3);
+  Varnode *negativeValue = (Varnode *)0;
+  Varnode *positiveValue = (Varnode *)0;
+  PcodeOp *returnOp = (PcodeOp *)0;
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead()) continue;
+    if (op->code() == CPUI_RETURN)
+      returnOp = op;
+    if (op->code() != CPUI_INDIRECT) continue;
+    if (PcodeOp::getOpFromConst(op->getIn(1)->getAddr()) != store) continue;
+    Varnode *value = op->getOut();
+    if (value->getSpace() != stack || value->getSize() != 4) continue;
+    if (value->getOffset() == 0xfffffff0)
+      negativeValue = value;
+    if (value->getOffset() == 0x20)
+      positiveValue = value;
+  }
+  ASSERT(negativeValue != (Varnode *)0);
+  ASSERT(positiveValue != (Varnode *)0);
+  ASSERT(returnOp != (PcodeOp *)0);
+  ASSERT_EQUALS(returnOp->numInput(),2);
+  ASSERT(returnOp->getIn(1)->isWritten());
+  PcodeOp *sum = returnOp->getIn(1)->getDef();
+  ASSERT_EQUALS(sum->code(),CPUI_INT_ADD);
+  ASSERT((sum->getIn(0) == negativeValue && sum->getIn(1) == positiveValue) ||
+      (sum->getIn(0) == positiveValue && sum->getIn(1) == negativeValue));
+  Varnode *beforeNegative = negativeValue->getDef()->getIn(0);
+  Varnode *beforePositive = positiveValue->getDef()->getIn(0);
+  ASSERT(beforeNegative->isWritten() && beforePositive->isWritten());
+  ASSERT_EQUALS(beforeNegative->getDef()->code(),CPUI_COPY);
+  ASSERT_EQUALS(beforePositive->getDef()->code(),CPUI_COPY);
+  ASSERT_EQUALS(beforeNegative->getDef()->getIn(0)->getOffset(),1);
+  ASSERT_EQUALS(beforePositive->getDef()->getIn(0)->getOffset(),2);
+}
+
+TEST(flat_conditional_stack_store_negative) {
+  checkFlatConditionalStackStore("558bec83ec10c745f401000000c74524020000008d5df4837d080075038d5d24c703030000008b45f4034524c9c3");
+}
+
+TEST(flat_conditional_stack_store_positive) {
+  checkFlatConditionalStackStore("558bec83ec10c745f401000000c74524020000008d5d24837d080075038d5df4c703030000008b45f4034524c9c3");
+}
