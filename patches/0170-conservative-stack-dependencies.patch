-  return true;
+  uintb extra = ((op->code() == CPUI_LOAD) ? op->getOut()->getSize() : op->getIn(2)->getSize()) - 1;
+  Address first(spc,spc->wrapOffset(addr.getOffset() - extra));
+  return guardRangesOverlap(pointerRanges,first,(uintb)size + extra);
