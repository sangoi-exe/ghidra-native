+/// Preserve circular solver bounds even when layout recovery discards or truncates them.
+void LoadGuard::setPointerRanges(const CircleRange &range)
+
+{
+  pointerRanges.clear();
+  if (range.isEmpty() || range.getMin() == range.getEnd() || range.getMask() != calc_mask(spc->getAddrSize())) {
+    pointerRanges.insertRange(spc,0,spc->getHighest());
+    return;
+  }
+  uintb first = AddrSpace::addressToByte(range.getMin(),spc->getWordSize());
+  uintb last = AddrSpace::addressToByte((range.getEnd() - 1) & range.getMask(),spc->getWordSize());
+  if (first <= last)
+    pointerRanges.insertRange(spc,first,last);
+  else {
+    pointerRanges.insertRange(spc,first,spc->getHighest());
+    pointerRanges.insertRange(spc,0,last);
+  }
+}
+
+/// Add byte coverage, including accesses that cross the end of the address space.
+void LoadGuard::addDependencyRanges(RangeList &ranges) const
+
+{
+  uintb extra = ((op->code() == CPUI_LOAD) ? op->getOut()->getSize() : op->getIn(2)->getSize()) - 1;
+  uintb highest = spc->getHighest();
+  for(std::set<Range>::const_iterator iter=pointerRanges.begin();iter!=pointerRanges.end();++iter) {
+    uintb first = (*iter).getFirst();
+    uintb last = (*iter).getLast();
+    if (extra >= highest - (last - first)) {
+      ranges.insertRange(spc,0,highest);
+      return;
+    }
+    last = spc->wrapOffset(last + extra);
+    if (first <= last)
+      ranges.insertRange(spc,first,last);
+    else {
+      ranges.insertRange(spc,first,highest);
+      ranges.insertRange(spc,0,last);
+    }
+  }
+}
+
