+class FunctionIdentityEmitter : public EmitPrettyPrint {
+public:
+  const Funcdata *function;
+  FunctionIdentityEmitter(void) : function((const Funcdata *)0) {}
+  virtual void tagFuncName(const string &name,syntax_highlight highlight,const Funcdata *fd,const PcodeOp *op) {
+    function = fd;
+    EmitPrettyPrint::tagFuncName(name,highlight,fd,op);
+  }
+};
+
+template<typename Printer> class FunctionDeclarationPrinter : public Printer {
+  FunctionIdentityEmitter *identityEmitter;
+public:
+  FunctionDeclarationPrinter(Architecture *arch) : Printer(arch) {
+    delete this->emit;
+    identityEmitter = new FunctionIdentityEmitter();
+    this->emit = identityEmitter;
+    this->initializeFromArchitecture();
+  }
+  string declaration(const Funcdata *fd,bool markup = false) {
+    ostringstream output;
+    this->clear();
+    this->setNamespaceStrategy(Printer::ALL_NAMESPACES);
+    this->setMod(Printer::hide_thisparam);
+    this->setOutputStream(&output);
+    this->setMarkup(markup);
+    this->setPackedOutput(false);
+    identityEmitter->function = (const Funcdata *)0;
+    uint4 savedMods = this->mods;
+    int4 function = this->emit->beginFunction(fd);
+    this->emitFunctionDeclaration(fd);
+    ASSERT_EQUALS(identityEmitter->function,fd);
+    ASSERT_EQUALS(this->curscope,fd->getScopeLocal());
+    this->popScope();
+    ASSERT_EQUALS(this->curscope,(const Scope *)0);
+    ASSERT_EQUALS(this->mods,savedMods);
+#ifdef CPUI_DEBUG
+    ASSERT(this->isStackEmpty());
+    ASSERT(this->isModStackEmpty());
+#endif
+    this->emit->endFunction(function);
+    this->emit->flush();
+    this->setMarkup(false);
+    this->setOutputStream((ostream *)0);
+    return output.str();
+  }
+};
+
+class FunctionDeclarationTreeHandler : public TreeHandler {
+  bool syntaxContent;
+public:
+  FunctionDeclarationTreeHandler(Element *root) : TreeHandler(root), syntaxContent(false) {}
+  virtual void startElement(const string &uri,const string &localName,const string &qualifiedName,const Attributes &attributes) {
+    TreeHandler::startElement(uri,localName,qualifiedName,attributes);
+    syntaxContent = localName == "syntax";
+  }
+  virtual void endElement(const string &uri,const string &localName,const string &qualifiedName) {
+    syntaxContent = false;
+    TreeHandler::endElement(uri,localName,qualifiedName);
+  }
+  virtual void ignorableWhitespace(const char *text,int4 start,int4 length) {
+    if (syntaxContent)
+      characters(text,start,length);
+  }
+};
+
+static string functionDeclarationText(const Element *element) {
+  string text = element->getContent();
+  for(const Element *child : element->getChildren())
+    text += functionDeclarationText(child);
+  return text;
+}
