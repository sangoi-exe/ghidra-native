+TEST(contextual_function_declaration) {
+  SegmentedEnvironment env;
+  Scope *tables = env.arch->symboltab->findCreateScope(0x1234,"Tables",env.arch->symboltab->getGlobalScope());
+  delete env.block;
+  env.fd = tables->addFunction(Address(env.arch->getDefaultCodeSpace(),0x1100),"returns_table")->getFunction();
+  env.fd->setHighLevel();
+  env.block = new BlockBasic(env.fd);
+  TypeFactory *factory = env.arch->types;
+  Datatype *word = factory->getBase(2,TYPE_UINT,"uint16_t");
+  Datatype *farPointer = factory->getTypePointer(4,word,1);
+  Datatype *array = factory->getTypeArray(3,farPointer);
+  Datatype *returnType = factory->getTypePointer(2,array,1);
+  FuncProto &prototype = env.fd->getFuncProto();
+  prototype.setModel(env.arch->getModel("__cdecl16far"));
+  ParameterPieces output;
+  output.addr = env.arch->translate->getRegister("AX").getAddr();
+  output.type = returnType;
+  output.flags = ParameterPieces::typelock;
+  prototype.setOutput(output);
+  ParameterPieces parameter;
+  parameter.addr = Address(env.arch->getStackSpace(),4);
+  parameter.type = factory->getTypePointer(2,word,1);
+  parameter.flags = ParameterPieces::typelock | ParameterPieces::namelock;
+  prototype.setParam(0,"self",parameter);
+  prototype.getParam(0)->setThisPointer(true);
+  parameter.addr = Address(env.arch->getStackSpace(),6);
+  parameter.type = word;
+  prototype.setParam(1,"slot",parameter);
+  Symbol *argument = prototype.getParam(1)->getSymbol();
+  ASSERT(argument != (Symbol *)0);
+  ASSERT_EQUALS(argument->getScope(),env.fd->getScopeLocal());
+  Varnode *returned = env.op(CPUI_COPY,{env.constant(2,0)},returnType)->getOut();
+  PcodeOp *returnOp = env.op(CPUI_RETURN,{env.constant(2,0),returned});
+  ASSERT_EQUALS(env.fd->getFirstReturnOp(),returnOp);
+  ASSERT_EQUALS(returnOp->getIn(1),returned);
+
+  FunctionDeclarationPrinter<PointerLayerPrintC> printer(env.arch);
+  string expected = "uint16_t far *(near * __cdecl16far Tables::returns_table(uint16_t slot)) [3]";
+  ASSERT_EQUALS(printer.declaration(env.fd),expected);
+  istringstream xml(printer.declaration(env.fd,true));
+  Document document;
+  FunctionDeclarationTreeHandler handler(&document);
+  int4 parsed = xml_parse(xml,&handler);
+  ASSERT_EQUALS(parsed,0);
+  ASSERT_EQUALS(functionDeclarationText(document.getRoot()),expected);
+  vector<const Element *> elements = {document.getRoot()};
+  int4 returnRegions = 0;
+  int4 argumentRegions = 0;
+  int4 argumentTokens = 0;
+  int4 functionNames = 0;
+  int4 conventions = 0;
+  string returnText;
+  while(!elements.empty()) {
+    const Element *element = elements.back();
+    elements.pop_back();
+    if (element->getName() == "return_type") {
+      ASSERT_EQUALS(std::stoull(element->getAttributeValue("varref"),(size_t *)0,0),returned->getCreateIndex());
+      string text = functionDeclarationText(element);
+      ASSERT(text.find("returns_table") == string::npos);
+      ASSERT(text.find("slot") == string::npos);
+      ASSERT(text.find("__cdecl16far") == string::npos);
+      returnText += text;
+      returnRegions += 1;
+    }
+    else if (element->getName() == "vardecl") {
+      ASSERT_EQUALS(std::stoull(element->getAttributeValue("symref"),(size_t *)0,0),argument->getId());
+      ASSERT_EQUALS(functionDeclarationText(element),"uint16_t slot");
+      argumentRegions += 1;
+    }
+    else if (element->getName() == "funcname") {
+      ASSERT_EQUALS(element->getContent(),"returns_table");
+      functionNames += 1;
+    }
+    else if (element->getName() == "variable" && element->getContent() == "slot") {
+      ASSERT_EQUALS(element->getParent()->getName(),"vardecl");
+      ASSERT_EQUALS(std::stoull(element->getParent()->getAttributeValue("symref"),(size_t *)0,0),argument->getId());
+      argumentTokens += 1;
+    }
+    else if (element->getContent() == "__cdecl16far") {
+      ASSERT_EQUALS(std::stoull(element->getAttributeValue("color"),(size_t *)0,0),Emit::keyword_color);
+      conventions += 1;
+    }
+    for(const Element *child : element->getChildren())
+      elements.push_back(child);
+  }
+  ASSERT_EQUALS(returnRegions,4);
+  ASSERT_EQUALS(argumentRegions,1);
+  ASSERT_EQUALS(argumentTokens,1);
+  ASSERT_EQUALS(functionNames,1);
+  ASSERT_EQUALS(conventions,1);
+  ASSERT(returnText.find("uint16_t") != string::npos);
+  ASSERT(returnText.find("far *") != string::npos);
+  ASSERT(returnText.find("near *") != string::npos);
+  ASSERT(returnText.find('3') != string::npos);
+
+  output.type = word;
+  prototype.setOutput(output);
+  returned->updateType(word,true,true);
+  FunctionDeclarationPrinter<PrintC> ordinary(env.arch);
+  ASSERT_EQUALS(ordinary.declaration(env.fd),"uint16_t __cdecl16far Tables::returns_table(uint16_t slot)");
 }

 static void assertInternalParameterRoundTrip(const ProtoParameter *expected,const ProtoParameter *actual) {
