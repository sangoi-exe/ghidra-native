+TEST(array_size_validation) {
+  SegmentedEnvironment env;
+  Datatype *word = env.arch->types->getBase(2,TYPE_UINT);
+  const int4 counts[] = {-1,0,3};
+  const int4 sizes[] = {0,2,4};
+  for(int4 i=0;i<3;++i) {
+    ostringstream output;
+    XmlEncode encoder(output);
+    encoder.openElement(ELEM_TYPE);
+    encoder.writeString(ATTRIB_NAME,"");
+    encoder.writeString(ATTRIB_METATYPE,"array");
+    encoder.writeSignedInteger(ATTRIB_SIZE,sizes[i]);
+    encoder.writeSignedInteger(ATTRIB_ARRAYSIZE,counts[i]);
+    word->encodeRef(encoder);
+    encoder.closeElement(ELEM_TYPE);
+    istringstream input(output.str());
+    XmlDecode decoder(env.arch);
+    decoder.ingestStream(input);
+    bool rejected = false;
+    try {
+      env.arch->types->decodeType(decoder);
+    }
+    catch(LowlevelError &err) {
+      rejected = true;
+    }
+    ASSERT(rejected);
+  }
+}

