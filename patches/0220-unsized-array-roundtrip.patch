+TEST(unsized_array_printing) {
+  SegmentedEnvironment env;
+  TypeFactory *factory = env.arch->types;
+  Datatype *word = factory->getBase(2,TYPE_UINT,"word");
+  TypeArray *unsized = factory->getTypeArray(0,word);
+  TypeArray *sized = factory->getTypeArray(3,word);
+  ostringstream rawUnsized;
+  unsized->printRaw(rawUnsized);
+  ASSERT_EQUALS(rawUnsized.str(),"word []");
+  ostringstream rawSized;
+  sized->printRaw(rawSized);
+  ASSERT_EQUALS(rawSized.str(),"word [3]");
+  PointerDeclarationPrinter<PrintC> printer(env.arch);
+  ASSERT_EQUALS(printer.declaration(unsized),"word value []");
+  ASSERT_EQUALS(printer.declaration(sized),"word value [3]");
+  ASSERT_EQUALS(printer.declaration(factory->getTypePointer(2,unsized,1)),"word (*value) []");
+}
+
+template<typename Encode,typename Decode> static void assertUnsizedArrayRoundTrip(void) {
+  SegmentedEnvironment original;
+  TypeFactory *factory = original.arch->types;
+  Datatype *word = factory->getBase(2,TYPE_UINT);
+  TypeArray *unsized = factory->getTypeArray(0,word);
+  TypeArray *sized = factory->getTypeArray(3,word);
+  TypeStruct *prefix = factory->getTypeStruct("UnsizedTail");
+  vector<TypeField> fields;
+  fields.emplace_back(11,0,"count",word);
+  fields.emplace_back(22,2,"samples",sized);
+  fields.emplace_back(33,8,"tail",unsized);
+  factory->setFields(fields,{},prefix,8,word->getAlignment(),0);
+  ostringstream output;
+  Encode encoder(output);
+  encoder.openElement(ELEM_TYPEGRP);
+  prefix->encode(encoder);
+  prefix->encodeRef(encoder);
+  encoder.closeElement(ELEM_TYPEGRP);
+
+  SegmentedEnvironment restored;
+  TypeFactory *restoredFactory = restored.arch->types;
+  istringstream input(output.str());
+  Decode decoder(restored.arch);
+  decoder.ingestStream(input);
+  uint4 element = decoder.openElement(ELEM_TYPEGRP);
+  Datatype *decoded = restoredFactory->decodeType(decoder);
+  ASSERT_EQUALS(decoded->getMetatype(),TYPE_STRUCT);
+  const TypeStruct *actual = (const TypeStruct *)decoded;
+  ASSERT_EQUALS(actual->getName(),prefix->getName());
+  ASSERT_EQUALS(actual->getId(),prefix->getId());
+  ASSERT_EQUALS(actual->isIncomplete(),false);
+  ASSERT_EQUALS(actual->getSize(),8);
+  ASSERT_EQUALS(actual->getAlignSize(),8);
+  ASSERT_EQUALS(actual->getAlignment(),word->getAlignment());
+  ASSERT_EQUALS(actual->numDepend(),3);
+  vector<TypeField>::const_iterator field = actual->beginField();
+  PointerDeclarationPrinter<PrintC> printer(restored.arch);
+  for(int4 i=0;i<fields.size();++i,++field) {
+    ASSERT_EQUALS(field->ident,fields[i].ident);
+    ASSERT_EQUALS(field->offset,fields[i].offset);
+    ASSERT_EQUALS(field->name,fields[i].name);
+    ASSERT_EQUALS(field->type->getSize(),fields[i].type->getSize());
+    ASSERT_EQUALS(field->type->getAlignment(),fields[i].type->getAlignment());
+    if (i == 0) {
+      ASSERT_EQUALS(field->type,restoredFactory->getBase(2,TYPE_UINT));
+      continue;
+    }
+    ASSERT_EQUALS(field->type->getMetatype(),TYPE_ARRAY);
+    const TypeArray *array = (const TypeArray *)field->type;
+    ASSERT_EQUALS(array->numElements(),i == 1 ? 3 : 0);
+    ASSERT_EQUALS(array->getBase(),restoredFactory->getBase(2,TYPE_UINT));
+    ASSERT_EQUALS(field->type,restoredFactory->getTypeArray(array->numElements(),array->getBase()));
+    ASSERT_EQUALS(printer.declaration(field->type,false,field->name),word->getName() + (i == 1 ? " samples [3]" : " tail []"));
+  }
+  ASSERT_EQUALS(restoredFactory->decodeType(decoder),decoded);
+  decoder.closeElement(element);
+}
+
+TEST(unsized_array_roundtrip) {
+  assertUnsizedArrayRoundTrip<XmlEncode,XmlDecode>();
+  assertUnsizedArrayRoundTrip<PackedEncode,PackedDecode>();
+}
