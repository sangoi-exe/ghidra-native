+TEST(segmented_call_unknown_selector) {
+  SegmentedEnvironment env(true);
+  AddrSpace *stack = env.arch->getStackSpace();
+  const VarnodeData &ss(env.arch->stackSegment);
+  PcodeOp *call = env.op(CPUI_CALL,{env.fd->newVarnode(4,Address(stack->getContain(),0x2000))});
+  Varnode *value = env.fd->opStackLoad(stack,4,2,call,(Varnode *)0,false);
+  env.fd->opInsertInput(call,value,1);
+  env.fd->opHeritage();
+  Varnode *selector = value->getDef()->getIn(1)->getDef()->getIn(1);
+  ASSERT(!selector->isConstant());
+  ASSERT(selector->isInput());
+  ASSERT_EQUALS(selector->getAddr(),ss.getAddr());
+  ASSERT_EQUALS(selector->getSize(),2);
+}
