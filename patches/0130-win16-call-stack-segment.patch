+// These retained bytes are the original SCRANTIC NE1 fill body/wrapper and the observed JMP/CALL_RETURN regression from segmented-c.xml.
+TEST(segmented_call_bytes) {
+  SegmentedEnvironment::initialize();
+  istringstream image(R"(<binaryimage arch="x86:LE:16:Protected Mode:default">
+<bytechunk space="ram" offset="0x100011f2" readonly="true">
+45558bec571e078b7e068b4e088a460a8ae0fcf7c701007404e309aa49d1e9f3ab7301aa5f5d4dcb
+45558bec568b76068a460850ff760a560ee8c4ff83c4068bc65e5d4dcb
+</bytechunk>
+<bytechunk space="ram" offset="0x10001000" readonly="true">e90d00</bytechunk>
+<bytechunk space="ram" offset="0x10001010" readonly="true">558bec8b46065dcb</bytechunk>
+</binaryimage>)");
+  DocumentStorage store;
+  Document *doc = store.parseDocument(image);
+  store.registerTag(doc->getRoot());
+  unique_ptr<Architecture> arch(ArchitectureCapability::getCapability("xml")->buildArchitecture("", "", &cout));
+  arch->init(store);
+  AddrSpace *ram = arch->getDefaultCodeSpace();
+  Scope *global = arch->symboltab->getGlobalScope();
+  global->addFunction(Address(ram,0x100011f2),"fill_body");
+  Funcdata *wrapper = global->addFunction(Address(ram,0x1000121a),"fill_wrapper")->getFunction();
+  global->addFunction(Address(ram,0x10001010),"jump_target");
+  Funcdata *thunk = global->addFunction(Address(ram,0x10001000),"jump_thunk")->getFunction();
+  const char *declarations[] = {
+    "extern uint2 __cdecl16far fill_body(uint2 destination,uint2 count,uint2 value);",
+    "extern uint2 __cdecl16far fill_wrapper(uint2 destination,uint2 value,uint2 count);",
+    "extern uint2 __cdecl16far jump_target(uint2 value);",
+    "extern uint2 __cdecl16far jump_thunk(uint2 value);"
+  };
+  for(int4 i=0;i<4;++i) {
+    istringstream declaration(declarations[i]);
+    parse_C(arch.get(),declaration);
+  }
+  arch->allacts.getCurrent()->reset(*wrapper);
+  ASSERT(arch->allacts.getCurrent()->perform(*wrapper) >= 0);
+  ASSERT_EQUALS(wrapper->numCalls(),1);
+  FuncCallSpecs *spec = wrapper->getCallSpecs(0);
+  ASSERT_EQUALS(spec->getEntryAddress(),Address(ram,0x100011f2));
+  PcodeOp *call = spec->getOp();
+  ASSERT_EQUALS(call->numInput(),4);
+  for(int4 slot=1;slot<=3;++slot) {
+    Varnode *argument = call->getIn(slot);
+    ASSERT_EQUALS(argument->getSize(),2);
+    ASSERT_EQUALS(argument->getDef()->code(),CPUI_LOAD);
+    Varnode *address = argument->getDef()->getIn(1);
+    ASSERT_EQUALS(address->getSize(),4);
+    if (address->getDef()->code() == CPUI_CAST)
+      address = address->getDef()->getIn(0);
+    ASSERT_EQUALS(address->getDef()->code(),CPUI_SEGMENTOP);
+    Varnode *near = address->getDef()->getIn(2);
+    ASSERT_EQUALS(near->getSize(),2);
+    ASSERT_EQUALS(near->getDef()->code(),CPUI_PTRSUB);
+    ASSERT_EQUALS(near->getDef()->getIn(1)->getOffset(),0xfff4 + slot * 2);
+    Varnode *selector = address->getDef()->getIn(1);
+    ASSERT(selector->isInput());
+    ASSERT_EQUALS(selector->getAddr(),arch->stackSegment.getAddr());
+  }
+  ostringstream output;
+  arch->print->setOutputStream(&output);
+  arch->print->setMaxLineSize(300);
+  arch->print->docFunction(wrapper);
+  string text = output.str();
+  ASSERT(text.find("fill_body(*(uint2 *)(xunknown1 *)segmentop(unaff_SS, &stack0xfff6), *(uint2 *)(xunknown1 *)segmentop(unaff_SS, &stack0xfff8), *(uint2 *)(xunknown1 *)segmentop(unaff_SS, &stack0xfffa))") != string::npos);
+  ASSERT(text.find("in_stack_0000fff6") == string::npos);
+  ASSERT(text.find("in_stack_0000fff8") == string::npos);
+  ASSERT(text.find("in_stack_0000fffa") == string::npos);
+  // Re-analyze the observed JMP with the native flow override, without a machine CALL stack write.
+  arch->allacts.getCurrent()->reset(*thunk);
+  ASSERT(arch->allacts.getCurrent()->perform(*thunk) >= 0);
+  thunk->getOverride().insertFlowOverride(Address(ram,0x10001000),"callreturn");
+  arch->clearAnalysis(thunk);
+  arch->allacts.getCurrent()->reset(*thunk);
+  ASSERT(arch->allacts.getCurrent()->perform(*thunk) >= 0);
+  ASSERT_EQUALS(thunk->numCalls(),1);
+  call = thunk->getCallSpecs(0)->getOp();
+  ASSERT_EQUALS(call->getAddr(),Address(ram,0x10001000));
+  ASSERT_EQUALS(thunk->getCallSpecs(0)->getEntryAddress(),Address(ram,0x10001010));
+  ASSERT_EQUALS(call->numInput(),2);
+  ASSERT_EQUALS(call->getIn(1)->getDef()->code(),CPUI_LOAD);
+  Varnode *address = call->getIn(1)->getDef()->getIn(1);
+  if (address->getDef()->code() == CPUI_CAST)
+    address = address->getDef()->getIn(0);
+  PcodeOp *segment = address->getDef();
+  ASSERT_EQUALS(segment->code(),CPUI_SEGMENTOP);
+  ASSERT_EQUALS(segment->getIn(1)->getAddr(),arch->stackSegment.getAddr());
+  ASSERT(segment->getIn(1)->isInput());
+  output.str("");
+  arch->print->docFunction(thunk);
+  text = output.str();
+  ASSERT(text.find("jump_target(*(uint2 *)segmentop(unaff_SS, &value))") != string::npos);
+  arch->print->setOutputStream((ostream *)0);
+}
