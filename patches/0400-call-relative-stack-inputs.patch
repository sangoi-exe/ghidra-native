+static void checkVariadicTail(SegmentedEnvironment &env,Funcdata *callee,bool observed) {
+  AddrSpace *ram = env.arch->getDefaultCodeSpace();
+  AddrSpace *stack = env.arch->getStackSpace();
+  ASSERT_EQUALS(env.fd->numCalls(),1);
+  FuncCallSpecs *spec = env.fd->getCallSpecs(0);
+  PcodeOp *call = spec->getOp();
+  ASSERT_EQUALS(call->getAddr(),Address(ram,0x1018));
+  ASSERT_EQUALS(spec->getEntryAddress(),callee->getAddress());
+  ASSERT_EQUALS(spec->getSpacebaseOffset(),FuncCallSpecs::offset_unknown);
+  ASSERT(spec->isInputLocked());
+  ASSERT(spec->isDotdotdot());
+  ASSERT_EQUALS(spec->numParams(),1);
+  ASSERT_EQUALS(spec->getParam(0)->getAddress(),Address(stack,4));
+  ASSERT_EQUALS(spec->getParam(0)->getName(),"first");
+  ASSERT_EQUALS(call->numInput(),observed ? 3 : 2);
+  ASSERT(call->getIn(1)->isConstant());
+  ASSERT_EQUALS(call->getIn(1)->getSize(),4);
+  ASSERT_EQUALS(call->getIn(1)->getOffset(),1);
+  ASSERT(!env.fd->getFuncProto().isInputLocked());
+  if (observed) {
+    ASSERT(call->getIn(2)->isConstant());
+    ASSERT_EQUALS(call->getIn(2)->getSize(),4);
+    ASSERT_EQUALS(call->getIn(2)->getOffset(),7);
+    ASSERT(spec->getUnresolvedInputStorages().empty());
+  }
+  else {
+    ASSERT_EQUALS(spec->getUnresolvedInputStorages().size(),1);
+    ASSERT(hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,8),4));
+    ASSERT_EQUALS(spec->getActiveInput()->whichTrial(Address(stack,8),4),-1);
+  }
+  bool warned = false;
+  CommentDatabase *comments = env.arch->commentdb;
+  for(CommentSet::const_iterator iter=comments->beginComment(env.fd->getAddress());iter!=comments->endComment(env.fd->getAddress());++iter) {
+    if ((*iter)->getText().find("Incomplete call input recovery") == string::npos) continue;
+    ASSERT_EQUALS((*iter)->getType(),Comment::warning);
+    ASSERT_EQUALS((*iter)->getAddr(),call->getAddr());
+    ASSERT((*iter)->getText().find("stack[0x8:4]") != string::npos);
+    warned = true;
+  }
+  ASSERT_EQUALS(warned,!observed);
+}
+
+static void checkVariadicReusedCell(bool observed,bool late) {
+  // Supplied 72-byte witness: fixed 1, reused tail 7, and a callee consuming entry-stack+8.
+  SegmentedEnvironment env(false,"x86:LE:32:default:gcc","5589e583e4f083ec10c7042401000000c744240407000000e8230000000344240489ec5dc30000000000000000000000000000000000000000000000000000008b44240883c003c3");
+  AddrSpace *ram = env.arch->getDefaultCodeSpace();
+  AddrSpace *stack = env.arch->getStackSpace();
+  Funcdata *callee = env.arch->symboltab->getGlobalScope()->addFunction(Address(ram,0x1040),"audited_varargs")->getFunction();
+  callee->getFuncProto().setModel(env.arch->defaultfp);
+  Action *root = env.arch->allacts.getCurrent();
+  if (observed) {
+    root->reset(*callee);
+    ASSERT(root->perform(*callee) >= 0);
+    ASSERT(!callee->getFuncProto().isInputLocked());
+    ASSERT_EQUALS(callee->getObservedInputStorages().size(),1);
+    ASSERT(hasInputStorage(callee->getObservedInputStorages(),Address(stack,8),4));
+    ASSERT(!hasInputStorage(callee->getObservedInputStorages(),Address(stack,4),4));
+  }
+  else
+    ASSERT(callee->getObservedInputStorages().empty());
+  if (late) {
+    root->reset(*env.fd);
+    ASSERT(root->setBreakPoint(Action::tmpbreak_start,"activeparam"));
+    ASSERT_EQUALS(root->perform(*env.fd),-1);
+    ASSERT_EQUALS(env.fd->numCalls(),1);
+    FuncCallSpecs *spec = env.fd->getCallSpecs(0);
+    ASSERT(spec->isInputActive());
+    ASSERT(!spec->isInputLocked());
+    FuncProto contract;
+    setVariadicPrefix(env,contract);
+    ASSERT(!spec->isInputLocked());
+    spec->forceSet(*env.fd,contract);
+    ASSERT(!env.fd->hasRestartPending());
+    Varnode *fixed = spec->getOp()->getIn(1);
+    spec->recoverCallRelativeInputs(*env.fd);
+    ASSERT_EQUALS(spec->getOp()->getIn(1),fixed);
+    ASSERT_EQUALS(hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,8),4),!observed);
+  }
+  else {
+    FuncProto *contract = new FuncProto();
+    setVariadicPrefix(env,*contract);
+    env.fd->getOverride().insertProtoOverride(Address(ram,0x1018),contract);
+    root->reset(*env.fd);
+  }
+  ASSERT(root->perform(*env.fd) >= 0);
+  checkVariadicTail(env,callee,observed);
+  env.arch->clearAnalysis(env.fd);
+  ASSERT_EQUALS(env.fd->numCalls(),0);
+  ASSERT(env.arch->commentdb->beginComment(env.fd->getAddress()) == env.arch->commentdb->endComment(env.fd->getAddress()));
+  root->reset(*env.fd);
+  ASSERT(root->perform(*env.fd) >= 0);
+  checkVariadicTail(env,callee,observed);
+}
