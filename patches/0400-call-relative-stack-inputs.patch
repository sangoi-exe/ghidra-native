+static void checkOpaqueCellContinuations(bool interblock,bool overwrite) {
+  string bytes;
+  if (interblock) {
+    bytes = "8d4c240483e4f0ff71fc5589e55183ec04c7042480100000e823000000";
+    if (overwrite) bytes += "894dfc";
+    bytes += "85d27403894dfc8d65fc595d8d61fcc3";
+  }
+  else
+    bytes = "8d4c240483e4f0ff71fc5589e55183ec04c7042480100000e823000000c7042490100000e8270000008d65fc595d8d61fcc3";
+  bytes.resize(0x40*2,'0');
+  bytes += "8b442404c3";
+  if (!interblock) {
+    bytes.resize(0x50*2,'0');
+    bytes += "8b442404c3";
+  }
+  bytes.resize(0x80*2,'0');
+  bytes += "4631320a00";
+  if (!interblock) {
+    bytes.resize(0x90*2,'0');
+    bytes += "463132620a00";
+  }
+  SegmentedEnvironment env(false,"x86:LE:32:default:gcc",bytes);
+  AddrSpace *ram = env.arch->getDefaultCodeSpace();
+  vector<Funcdata *> callees;
+  callees.push_back(env.arch->symboltab->getGlobalScope()->addFunction(Address(ram,0x1040),"consume_format")->getFunction());
+  if (!interblock)
+    callees.push_back(env.arch->symboltab->getGlobalScope()->addFunction(Address(ram,0x1050),"consume_second")->getFunction());
+  for(int4 i=0;i<callees.size();++i) {
+    callees[i]->getFuncProto().setModel(env.arch->defaultfp);
+    ASSERT(!callees[i]->getFuncProto().isInputLocked());
+    ASSERT_EQUALS(callees[i]->getFuncProto().numParams(),0);
+  }
+  ParameterPieces output;
+  output.addr = env.arch->translate->getRegister("EAX").getAddr();
+  output.type = env.arch->types->getBase(4,TYPE_UINT);
+  output.flags = ParameterPieces::typelock;
+  env.fd->getFuncProto().setOutput(output);
+  env.fd->getFuncProto().setOutputLock(true);
+  ASSERT(!env.fd->getFuncProto().isInputLocked());
+  auto calls = [&]() {
+    ASSERT_EQUALS(env.fd->numCalls(),callees.size());
+    vector<FuncCallSpecs *> result(callees.size(),(FuncCallSpecs *)0);
+    for(int4 i=0;i<env.fd->numCalls();++i) {
+      FuncCallSpecs *call = env.fd->getCallSpecs(i);
+      if (call->getOp()->getAddr() == Address(ram,0x1018)) result[0] = call;
+      else {
+        ASSERT(!interblock);
+        ASSERT_EQUALS(call->getOp()->getAddr(),Address(ram,0x1024));
+        result[1] = call;
+      }
+    }
+    for(int4 i=0;i<result.size();++i) {
+      ASSERT(result[i] != (FuncCallSpecs *)0);
+      ASSERT_EQUALS(result[i]->getEntryAddress(),callees[i]->getAddress());
+      ASSERT_EQUALS(result[i]->getModelName(),"__cdecl");
+      ASSERT(!result[i]->isInputLocked());
+      ASSERT_EQUALS(result[i]->getSpacebaseOffset(),FuncCallSpecs::offset_unknown);
+    }
+    return result;
+  };
+  Action *root = env.arch->allacts.getCurrent();
+  for(int4 i=0;i<callees.size();++i) {
+    root->reset(*callees[i]);
+    ASSERT(root->perform(*callees[i]) >= 0);
+    ASSERT_EQUALS(callees[i]->getObservedInputStorages().size(),1);
+    ASSERT_EQUALS(callees[i]->getObservedInputStorages()[0].getAddr(),Address(env.arch->getStackSpace(),4));
+  }
+  root->reset(*env.fd);
+  if (interblock && !overwrite) {
+    ASSERT(root->setBreakPoint(Action::tmpbreak_start,"activeparam"));
+    ASSERT_EQUALS(root->perform(*env.fd),-1);
+    BlockBasic *branch = calls()[0]->getOp()->getParent();
+    ASSERT_EQUALS(branch->sizeOut(),2);
+    ASSERT_EQUALS(branch->getFalseOut()->getStart(),Address(ram,0x1021));
+    ASSERT_EQUALS(branch->getTrueOut()->getStart(),Address(ram,0x1024));
+    ASSERT_EQUALS(branch->getFalseOut()->sizeOut(),1);
+    ASSERT_EQUALS(branch->getFalseOut()->getOut(0),branch->getTrueOut());
+    ASSERT_EQUALS(branch->getTrueOut()->sizeIn(),2);
+  }
+  ASSERT(root->perform(*env.fd) >= 0);
+  vector<FuncCallSpecs *> finalCalls(calls());
+  for(int4 i=0;i<finalCalls.size();++i) {
+    ASSERT(!finalCalls[i]->isInputActive());
+    const vector<VarnodeData> &unresolved(finalCalls[i]->getUnresolvedInputStorages());
+    bool savedCell = false;
+    for(int4 j=0;j<unresolved.size();++j) {
+      if (unresolved[j].getAddr() == Address(env.arch->getStackSpace(),8) && unresolved[j].size == 4)
+        savedCell = true;
+    }
+    if (i == 0) ASSERT_EQUALS(savedCell,!overwrite);
+  }
+  if (!overwrite) {
+    for(int4 i=0;i<finalCalls.size();++i) {
+      ASSERT_EQUALS(finalCalls[i]->getOp()->numInput(),2);
+      Varnode *format = finalCalls[i]->getOp()->getIn(1);
+      while(format->isWritten() && (format->getDef()->code() == CPUI_COPY || format->getDef()->code() == CPUI_CAST)) {
+        Varnode *input = format->getDef()->getIn(0);
+        ASSERT_EQUALS(input->getSize(),format->getSize());
+        format = input;
+      }
+      ASSERT(format->isConstant());
+      ASSERT_EQUALS(format->getSize(),4);
+      ASSERT_EQUALS(format->getOffset(),i == 0 ? 0x1080 : 0x1090);
+    }
+  }
+  Varnode *entry = env.fd->findVarnodeInput(4,env.arch->translate->getRegister("ESP").getAddr());
+  ASSERT(entry != (Varnode *)0);
+  bool alignment = false;
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead() || op->code() != CPUI_INT_AND || !op->getIn(1)->isConstant()) continue;
+    if (op->getIn(1)->getOffset() == 0xfffffff0 && tasm31DependsOn(op->getIn(0),entry)) alignment = true;
+  }
+  ASSERT(alignment);
+  ASSERT(!env.fd->getFuncProto().isInputLocked());
+  for(int4 i=0;i<callees.size();++i) {
+    ASSERT(!callees[i]->getFuncProto().isInputLocked());
+    ASSERT_EQUALS(callees[i]->getFuncProto().numParams(),1);
+  }
+}
