+static bool hasInputStorage(const vector<VarnodeData> &storages,const Address &addr,int4 size) {
+  for(int4 i=0;i<storages.size();++i) {
+    if (storages[i].getAddr() == addr && storages[i].size == size) return true;
+  }
+  return false;
+}
