+static Address packedInputSource(Varnode *value) {
+  int4 byteOffset = 0;
+  while(value->isWritten()) {
+    PcodeOp *def = value->getDef();
+    if (def->code() == CPUI_SUBPIECE) {
+      ASSERT(def->getIn(1)->isConstant());
+      byteOffset += def->getIn(1)->getOffset();
+    }
+    else if (def->code() == CPUI_INT_RIGHT) {
+      // RuleSubRight expresses an interior slice as a byte-aligned shift and low truncation.
+      ASSERT(def->getIn(1)->isConstant());
+      ASSERT_EQUALS(def->getIn(1)->getOffset()%8,0);
+      byteOffset += def->getIn(1)->getOffset()/8;
+    }
+    else {
+      ASSERT(def->code() == CPUI_COPY || def->code() == CPUI_CAST);
+    }
+    value = def->getIn(0);
+  }
+  ASSERT(byteOffset+4 <= value->getSize());
+  return value->getAddr()+byteOffset;
+}
