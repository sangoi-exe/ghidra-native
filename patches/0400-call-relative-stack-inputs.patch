+/// Strip only width-preserving constant displacements; nonlinear definitions remain opaque.
+static Varnode *callInputPointerBase(Varnode *vn,uintb &offset)
+
+{
+  int4 size = vn->getSize();
+  offset = 0;
+  while(vn->isWritten()) {
+    PcodeOp *def = vn->getDef();
+    Varnode *base;
+    if (def->code() == CPUI_COPY)
+      base = def->getIn(0);
+    else if (def->code() == CPUI_INT_ADD && def->getIn(1)->isConstant()) {
+      base = def->getIn(0);
+      offset += def->getIn(1)->getOffset();
+    }
+    else if (def->code() == CPUI_INT_ADD && def->getIn(0)->isConstant()) {
+      base = def->getIn(1);
+      offset += def->getIn(0)->getOffset();
+    }
+    else if (def->code() == CPUI_INT_SUB && def->getIn(1)->isConstant()) {
+      base = def->getIn(0);
+      offset -= def->getIn(1)->getOffset();
+    }
+    else
+      break;
+    if (base->getSize() != size)
+      return (Varnode *)0;
+    vn = base;
+  }
+  offset &= calc_mask(size);
+  if (!vn->isWritten() && !vn->isInput())
+    return (Varnode *)0;
+  return vn;
+}
