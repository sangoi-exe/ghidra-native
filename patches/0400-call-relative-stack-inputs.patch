+TEST(segmented_variadic_late_reused_cell_callee_input) {
+  checkVariadicReusedCell(true,true);
+}
+
+TEST(segmented_variadic_late_reused_cell_unresolved) {
+  checkVariadicReusedCell(false,true);
+}
