+static void checkIncompleteCallWarning(SegmentedEnvironment &env,FuncCallSpecs *spec,bool expected) {
+  bool found = false;
+  CommentDatabase *comments = env.arch->commentdb;
+  for(CommentSet::const_iterator iter=comments->beginComment(env.fd->getAddress());iter!=comments->endComment(env.fd->getAddress());++iter) {
+    const Comment *comment = *iter;
+    if (comment->getText().find("Incomplete call input recovery") == string::npos) continue;
+    ASSERT_EQUALS(comment->getType(),Comment::warning);
+    ASSERT_EQUALS(comment->getAddr(),spec->getOp()->getAddr());
+    ASSERT(comment->getText().find("stack[0x4:4]") != string::npos);
+    found = true;
+  }
+  ASSERT_EQUALS(found,expected);
+  ostringstream output;
+  env.arch->print->setOutputStream(&output);
+  env.arch->print->docFunction(env.fd);
+  ASSERT_EQUALS(output.str().find("Incomplete call input recovery") != string::npos,expected);
+  ASSERT(output.str().find(expected ? "reuse_callee()" : "reuse_callee(7)") != string::npos);
+  output.str("");
+  env.arch->print->setMarkup(true);
+  env.arch->print->setPackedOutput(false);
+  env.arch->print->docFunction(env.fd);
+  istringstream xml(output.str());
+  DocumentStorage storage;
+  Document *doc = storage.parseDocument(xml);
+  vector<const Element *> pending(1,doc->getRoot());
+  string commentText;
+  while(!pending.empty()) {
+    const Element *element = pending.back();
+    pending.pop_back();
+    if (element->getName() == "comment") {
+      commentText += element->getContent();
+      commentText += ' ';
+    }
+    const List &children(element->getChildren());
+    for(List::const_reverse_iterator iter=children.rbegin();iter!=children.rend();++iter)
+      pending.push_back(*iter);
+  }
+  ASSERT_EQUALS(commentText.find("Incomplete call input recovery") != string::npos,expected);
+  if (expected) ASSERT(commentText.find("stack[0x4:4]") != string::npos);
+  env.arch->print->setMarkup(false);
+  env.arch->print->setOutputStream((ostream *)0);
+}
