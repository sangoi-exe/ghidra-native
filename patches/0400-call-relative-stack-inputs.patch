+/// Collect locally reaching writes with no intervening overlapping read or write.
+static void callInputReachingStores(PcodeOp *before,AddrSpace *memory,Varnode *pointer,vector<PcodeOp *> &stores)
+
+{
+  uintb referenceOffset;
+  Varnode *base = callInputPointerBase(pointer,referenceOffset);
+  if (base == (Varnode *)0) return;
+  vector<pair<Address,int4> > blocked;
+  BlockBasic *block = before->getParent();
+  list<PcodeOp *>::iterator iter = before->getBasicIter();
+  while(iter != block->beginOp()) {
+    PcodeOp *cur = *--iter;
+    if (cur->isCall() || cur->isFlowBreak()) break;
+    if (cur->code() == CPUI_STORE || cur->code() == CPUI_LOAD) {
+      if (cur->getIn(0)->getSpaceFromConst() != memory) continue;
+      Varnode *ptr = cur->getIn(1);
+      if (ptr->getSize() != pointer->getSize()) break;
+      uintb offset;
+      if (callInputPointerBase(ptr,offset) != base) break;
+      bool isStore = cur->code() == CPUI_STORE;
+      Varnode *value = isStore ? cur->getIn(2) : cur->getOut();
+      if (value->isVolatile()) break;
+      int4 size = value->getSize();
+      Address addr(memory,memory->wrapOffset(AddrSpace::addressToByte(offset,memory->getWordSize())));
+      bool overlaps = false;
+      for(int4 i=0;i<blocked.size();++i) {
+        if (addr.overlap(0,blocked[i].first,blocked[i].second) >= 0 ||
+            blocked[i].first.overlap(0,addr,size) >= 0) {
+          overlaps = true;
+          break;
+        }
+      }
+      if (isStore && !overlaps)
+        stores.push_back(cur);
+      blocked.emplace_back(addr,size);
+    }
+    else {
+      Varnode *out = cur->getOut();
+      if (out != (Varnode *)0 && (out->getSpace() == memory || out->getSpace()->getType() == IPTR_SPACEBASE))
+        break;
+      bool memoryRead = false;
+      for(int4 i=0;i<cur->numInput();++i) {
+        AddrSpace *space = cur->getIn(i)->getSpace();
+        if (space == memory || space->getType() == IPTR_SPACEBASE) {
+          memoryRead = true;
+          break;
+        }
+      }
+      if (memoryRead) break;
+    }
+  }
+}
