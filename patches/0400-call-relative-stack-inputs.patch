+/// A competing read disqualifies opaque inference, without asserting contents survive the call.
+static bool callInputCompetingRead(PcodeOp *store,AddrSpace *memory,PcodeOp *call)
+
+{
+  Varnode *pointer = store->getIn(1);
+  uintb offset;
+  Varnode *base = callInputPointerBase(pointer,offset);
+  Address cell(memory,memory->wrapOffset(AddrSpace::addressToByte(offset,memory->getWordSize())));
+  int4 size = store->getIn(2)->getSize();
+  BlockBasic *block = call->getParent();
+  list<PcodeOp *>::iterator iter = call->getBasicIter();
+  while(++iter != block->endOp()) {
+    PcodeOp *cur = *iter;
+    if (cur->isCall() || cur->isFlowBreak()) return false;
+    if (cur->code() == CPUI_LOAD || cur->code() == CPUI_STORE) {
+      if (cur->getIn(0)->getSpaceFromConst() != memory) continue;
+      Varnode *ptr = cur->getIn(1);
+      if (ptr->getSize() != pointer->getSize()) return false;
+      uintb readOffset;
+      if (callInputPointerBase(ptr,readOffset) != base) return false;
+      Address addr(memory,memory->wrapOffset(AddrSpace::addressToByte(readOffset,memory->getWordSize())));
+      bool isLoad = cur->code() == CPUI_LOAD;
+      Varnode *value = isLoad ? cur->getOut() : cur->getIn(2);
+      if (value->isVolatile()) return false;
+      int4 readSize = value->getSize();
+      if (addr.overlap(0,cell,size) < 0 && cell.overlap(0,addr,readSize) < 0) continue;
+      if (!isLoad || addr != cell || readSize != size) return false;
+      if (!value->hasNoDescend()) return true;
+    }
+    else {
+      Varnode *out = cur->getOut();
+      if (out != (Varnode *)0 && (out->getSpace() == memory || out->getSpace()->getType() == IPTR_SPACEBASE))
+        return false;
+      for(int4 i=0;i<cur->numInput();++i) {
+        AddrSpace *space = cur->getIn(i)->getSpace();
+        if (space == memory || space->getType() == IPTR_SPACEBASE)
+          return false;
+      }
+    }
+  }
+  return false;
+}
