+/// Recover stack arguments relative to the actual call SP without assigning an entry-relative offset.
+void FuncCallSpecs::recoverCallRelativeInputs(Funcdata &data)
+
+{
+  if (!hasModel() || stackoffset != offset_unknown) return;
+  AddrSpace *stack = getSpacebase();
+  if (stack == (AddrSpace *)0) return;
+  if (isInputLocked()) {
+    for(int4 i=0;i<numParams() && i+1<op->numInput();++i) {
+      if (getParam(i)->getAddress().getSpace() != stack) continue;
+      Varnode *vn = op->getIn(i+1);
+      if (!vn->isWritten() || vn->isVolatile()) continue;
+      PcodeOp *load = vn->getDef();
+      if (load->code() != CPUI_LOAD) continue;
+      uintb canonicalOffset;
+      if (RuleLoadVarnode::checkSpacebase(data.getArch(),load,canonicalOffset) == stack) continue;
+      AddrSpace *memory = load->getIn(0)->getSpaceFromConst();
+      vector<PcodeOp *> stores;
+      callInputReachingStores(load,memory,load->getIn(1),stores);
+      uintb loadOffset;
+      callInputPointerBase(load->getIn(1),loadOffset);
+      for(int4 j=0;j<stores.size();++j) {
+        PcodeOp *store = stores[j];
+        uintb storeOffset;
+        callInputPointerBase(store->getIn(1),storeOffset);
+        Varnode *value = store->getIn(2);
+        if (storeOffset != loadOffset || value->getSize() != vn->getSize()) continue;
+        if (value->isConstant())
+          value = data.newConstant(value->getSize(),value->getOffset());
+        else if (value->isFree())
+          break;
+        data.opRemoveInput(load,1);
+        data.opSetOpcode(load,CPUI_COPY);
+        data.opSetInput(load,value,0);
+        break;
+      }
+    }
+  }
+  if (!isInputActive() || isInputLocked()) return;
+  Varnode *pointer = getSpacebaseRelative();
+  if (pointer == (Varnode *)0) return;
+  PcodeOp *placeholder = op->getIn(stackPlaceholderSlot)->getDef();
+  uintb canonicalOffset;
+  if (RuleLoadVarnode::checkSpacebase(data.getArch(),placeholder,canonicalOffset) == stack) return;
+  AddrSpace *memory = placeholder->getIn(0)->getSpaceFromConst();
+  if (memory != stack->getContain()) return;
+  uintb callOffset;
+  if (callInputPointerBase(pointer,callOffset) == (Varnode *)0) return;
+  vector<PcodeOp *> stores;
+  callInputReachingStores(op,memory,pointer,stores);
+  for(int4 i=0;i<stores.size();++i) {
+    PcodeOp *store = stores[i];
+    uintb offset;
+    callInputPointerBase(store->getIn(1),offset);
+    offset = (offset - callOffset) & calc_mask(pointer->getSize());
+    Address addr(stack,stack->wrapOffset(AddrSpace::addressToByte(offset,memory->getWordSize())));
+    Varnode *value = store->getIn(2);
+    int4 size = value->getSize();
+    if (characterizeAsInputParam(addr,size) != ParamEntry::contains_justified || activeinput.whichTrial(addr,size) >= 0)
+      continue;
+    if (value->isConstant())
+      value = data.newConstant(size,value->getOffset());
+    else if (value->isFree())
+      continue;
+    activeinput.registerTrial(addr,size);
+    ParamTrial &trial(activeinput.getTrial(activeinput.getNumTrials()-1));
+    if (callInputCompetingRead(store,memory,op))
+      trial.markNoUse();
+    else
+      trial.markActive();
+    data.opInsertInput(op,value,op->numInput());
+  }
 }
 
