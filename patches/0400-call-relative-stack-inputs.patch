+    for(int4 i=0;i<finalCalls.size();++i) {
+      ASSERT_EQUALS(finalCalls[i]->getOp()->numInput(),2);
+      Varnode *format = finalCalls[i]->getOp()->getIn(1);
+      while(format->isWritten() && (format->getDef()->code() == CPUI_COPY || format->getDef()->code() == CPUI_CAST)) {
+        Varnode *input = format->getDef()->getIn(0);
+        ASSERT_EQUALS(input->getSize(),format->getSize());
+        format = input;
+      }
+      ASSERT(format->isConstant());
+      ASSERT_EQUALS(format->getSize(),4);
+      ASSERT_EQUALS(format->getOffset(),i == 0 ? 0x1080 : 0x1090);
+    }
+  }
+  Varnode *entry = env.fd->findVarnodeInput(4,env.arch->translate->getRegister("ESP").getAddr());
+  ASSERT(entry != (Varnode *)0);
+  bool alignment = false;
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead() || op->code() != CPUI_INT_AND || !op->getIn(1)->isConstant()) continue;
+    if (op->getIn(1)->getOffset() == 0xfffffff0 && tasm31DependsOn(op->getIn(0),entry)) alignment = true;
+  }
+  ASSERT(alignment);
+  ASSERT(!env.fd->getFuncProto().isInputLocked());
+  for(int4 i=0;i<callees.size();++i) {
+    ASSERT(!callees[i]->getFuncProto().isInputLocked());
+    ASSERT_EQUALS(callees[i]->getFuncProto().numParams(),0);
+  }
+}
+
+TEST(segmented_opaque_two_call_saved_stack_not_arguments) {
+  checkOpaqueCellContinuations(false,false);
+}
+
+TEST(segmented_opaque_interblock_cell_read) {
+  checkOpaqueCellContinuations(true,false);
+}
+
+TEST(segmented_opaque_overwritten_cell_not_excluded) {
+  checkOpaqueCellContinuations(true,true);
+}
