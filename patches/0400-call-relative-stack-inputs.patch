+TEST(variadic_mixed_prefix_early) {
+  checkMixedVariadicCall(false,false);
+}
+
+TEST(variadic_mixed_prefix_late_order) {
+  checkMixedVariadicCall(true,false);
+}
+
+TEST(variadic_mixed_prefix_late_tail) {
+  checkMixedVariadicCall(true,true);
+}
