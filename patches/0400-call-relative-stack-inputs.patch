+TEST(segmented_opaque_saved_stack_not_arguments) {
+  string bytes = "8d4c240483e4f0ff71fc5589e55183ec04c7042480100000e8230000008d65fc595d8d61fcc3";
+  bytes.resize(0x40*2,'0');
+  bytes += "8b442404c3";
+  bytes.resize(0x80*2,'0');
+  bytes += "4631320a00";
+  SegmentedEnvironment env(false,"x86:LE:32:default:gcc",bytes);
+  AddrSpace *ram = env.arch->getDefaultCodeSpace();
+  Funcdata *callee = env.arch->symboltab->getGlobalScope()->addFunction(Address(ram,0x1040),"consume_format")->getFunction();
+  callee->getFuncProto().setModel(env.arch->defaultfp);
+  ParameterPieces output;
+  output.addr = env.arch->translate->getRegister("EAX").getAddr();
+  output.type = env.arch->types->getBase(4,TYPE_UINT);
+  output.flags = ParameterPieces::typelock;
+  env.fd->getFuncProto().setOutput(output);
+  env.fd->getFuncProto().setOutputLock(true);
+  ASSERT(!callee->getFuncProto().isInputLocked());
+  ASSERT_EQUALS(callee->getFuncProto().numParams(),0);
+  ASSERT(!env.fd->getFuncProto().isInputLocked());
+  Action *root = env.arch->allacts.getCurrent();
+  root->reset(*env.fd);
+  ASSERT(root->setBreakPoint(Action::tmpbreak_start,"activeparam"));
+  bool excluded = false;
+  int4 result = root->perform(*env.fd);
+  while(result == -1) {
+    ASSERT_EQUALS(env.fd->numCalls(),1);
+    FuncCallSpecs *call = env.fd->getCallSpecs(0);
+    ParamActive *active = call->getActiveInput();
+    int4 index = active->whichTrial(Address(env.arch->getStackSpace(),8),4);
+    if (index >= 0 && active->getTrial(index).isDefinitelyNotUsed()) {
+      const ParamTrial &trial(active->getTrial(index));
+      ASSERT(trial.isChecked());
+      ASSERT(!trial.isActive());
+      ASSERT(!trial.isUsed());
+      ASSERT(call->isInputActive());
+      ASSERT(!active->isFullyChecked());
+      ASSERT_EQUALS(call->getSpacebaseOffset(),FuncCallSpecs::offset_unknown);
+      excluded = true;
+      break;
+    }
+    ASSERT(root->setBreakPoint(Action::tmpbreak_start,"activeparam"));
+    result = root->perform(*env.fd);
+  }
+  ASSERT(excluded);
+  ASSERT(root->perform(*env.fd) >= 0);
+  ASSERT_EQUALS(env.fd->numCalls(),1);
+  FuncCallSpecs *call = env.fd->getCallSpecs(0);
+  ASSERT_EQUALS(call->getOp()->getAddr(),Address(ram,0x1018));
+  ASSERT_EQUALS(call->getModelName(),"__cdecl");
+  ASSERT(!call->isInputLocked());
+  ASSERT_EQUALS(call->getSpacebaseOffset(),FuncCallSpecs::offset_unknown);
+  ASSERT_EQUALS(call->getOp()->numInput(),2);
+  Varnode *format = call->getOp()->getIn(1);
+  while(format->isWritten() && (format->getDef()->code() == CPUI_COPY || format->getDef()->code() == CPUI_CAST)) {
+    Varnode *input = format->getDef()->getIn(0);
+    ASSERT_EQUALS(input->getSize(),format->getSize());
+    format = input;
+  }
+  ASSERT(format->isConstant());
+  ASSERT_EQUALS(format->getOffset(),0x1080);
+  ASSERT_EQUALS(format->getSize(),4);
+  Varnode *entry = env.fd->findVarnodeInput(4,env.arch->translate->getRegister("ESP").getAddr());
+  ASSERT(entry != (Varnode *)0);
+  bool alignment = false;
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead() || op->code() != CPUI_INT_AND || !op->getIn(1)->isConstant()) continue;
+    if (op->getIn(1)->getOffset() == 0xfffffff0 && tasm31DependsOn(op->getIn(0),entry))
+      alignment = true;
+  }
+  ASSERT(alignment);
+  ASSERT(!callee->getFuncProto().isInputLocked());
+  ASSERT_EQUALS(callee->getFuncProto().numParams(),0);
+}
