+    SegmentedEnvironment env(false,"x86:LE:32:default:gcc",bytes);
+    AddrSpace *ram = env.arch->getDefaultCodeSpace();
+    AddrSpace *stack = env.arch->getStackSpace();
+    Funcdata *callee = env.arch->symboltab->getGlobalScope()->addFunction(Address(ram,0x1040),"consume_format")->getFunction();
+    callee->getFuncProto().setModel(env.arch->defaultfp);
+    Action *root = env.arch->allacts.getCurrent();
+    root->reset(*env.fd);
+    ASSERT(root->setBreakPoint(Action::tmpbreak_start,"activeparam"));
+    ASSERT_EQUALS(root->perform(*env.fd),-1);
+    ASSERT_EQUALS(env.fd->numCalls(),1);
+    FuncCallSpecs *spec = env.fd->getCallSpecs(0);
+    spec->recoverCallRelativeInputs(*env.fd);
+    ASSERT(spec->isInputActive());
+    ASSERT(hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,8),4));
+    ASSERT(!spec->isInputLocked());
+    ASSERT_EQUALS(spec->numParams(),0);
+    FuncProto contract;
+    if (kind == 0) {
+      contract.copy(*spec);
+      contract.setModelLock(true);
+    }
+    else {
+      istringstream declaration(kind == 1 ? "uint4 fixed_inputs(uint4 format);" : "uint4 open_tail(uint4 format,...);");
+      PrototypePieces pieces;
+      parse_protopieces(pieces,declaration,env.arch);
+      // A proposed contract must not edit the receiver's symbol-backed input store.
+      contract.setInternal(pieces.model,env.arch->types->getTypeVoid());
+      contract.setPieces(pieces);
+      ASSERT(contract.isInputLocked());
+      ASSERT_EQUALS(contract.isDotdotdot(),kind == 2);
+    }
+    ASSERT(!spec->isInputLocked());
+    ASSERT_EQUALS(spec->numParams(),0);
+    ASSERT(!spec->isDotdotdot());
+    ASSERT_EQUALS(callee->getFuncProto().numParams(),0);
+    if (kind == 0) {
+      vector<Varnode *> inputs,outputs;
+      ASSERT(spec->lateRestriction(contract,inputs,outputs));
+    }
+    else
+      spec->forceSet(*env.fd,contract);
+    ASSERT_EQUALS(spec->isInputLocked(),kind != 0);
+    ASSERT_EQUALS(spec->isDotdotdot(),kind == 2);
+    ASSERT(!env.fd->hasRestartPending());
+    ASSERT_EQUALS(hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,8),4),kind != 1);
+    ASSERT(root->perform(*env.fd) >= 0);
+    ASSERT_EQUALS(env.fd->numCalls(),1);
+    spec = env.fd->getCallSpecs(0);
+    ASSERT_EQUALS(hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,8),4),kind != 1);
+    bool warned = false;
+    CommentDatabase *comments = env.arch->commentdb;
+    for(CommentSet::const_iterator iter=comments->beginComment(env.fd->getAddress());iter!=comments->endComment(env.fd->getAddress());++iter) {
+      if ((*iter)->getText().find("Incomplete call input recovery") != string::npos) {
+        ASSERT_EQUALS((*iter)->getAddr(),spec->getOp()->getAddr());
+        warned = true;
+      }
+    }
+    ASSERT_EQUALS(warned,kind != 1);
+  }
+}
