+static void checkPackedFixedArguments(FuncCallSpecs *spec,Funcdata *callee,bool sliced) {
+  ASSERT_EQUALS(spec->getEntryAddress(),callee->getAddress());
+  ASSERT(spec->isInputLocked());
+  ASSERT(spec->isDotdotdot());
+  ASSERT_EQUALS(spec->numParams(),2);
+  ASSERT_EQUALS(spec->getParam(0)->getName(),"first");
+  ASSERT_EQUALS(spec->getParam(1)->getName(),"second");
+  ASSERT_EQUALS(spec->getSpacebaseOffset(),FuncCallSpecs::offset_unknown);
+  PcodeOp *call = spec->getOp();
+  ASSERT_EQUALS(call->numInput(),3);
+  ASSERT(call->getIn(1) != call->getIn(2));
+  for(int4 i=0;i<2;++i) {
+    Varnode *arg = call->getIn(i+1);
+    ASSERT_EQUALS(arg->getSize(),4);
+    ASSERT(arg->isWritten());
+    if (sliced) {
+      ASSERT_EQUALS(packedInputSource(arg),Address(callee->getAddress().getSpace(),0x1080+4*i));
+    }
+    else {
+      ASSERT_EQUALS(arg->getDef()->code(),CPUI_LOAD);
+    }
+  }
+}
