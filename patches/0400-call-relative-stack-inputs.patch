+/// A competing read disqualifies opaque inference, without asserting contents survive the call.
+static bool callInputCompetingRead(PcodeOp *store,AddrSpace *memory,PcodeOp *call,Funcdata &data)
+
+{
+  Varnode *pointer = store->getIn(1);
+  uintb offset;
+  Varnode *base = callInputPointerBase(pointer,offset);
+  Address cell(memory,memory->wrapOffset(AddrSpace::addressToByte(offset,memory->getWordSize())));
+  int4 size = store->getIn(2)->getSize();
+  auto continuesCall = [&data](PcodeOp *op) {
+    if (op->code() != CPUI_CALL && op->code() != CPUI_CALLIND) return false;
+    FuncCallSpecs *spec = data.getCallSpecs(op);
+    if (spec == (FuncCallSpecs *)0 || spec->isNoReturn() || op->getHaltType() != 0) return false;
+    BlockBasic *block = op->getParent();
+    list<PcodeOp *>::iterator next = op->getBasicIter();
+    ++next;
+    return next != block->endOp() ? (*next)->getHaltType() == 0 : block->sizeOut() != 0;
+  };
+  if (!continuesCall(call)) return false;
+  PcodeOp *baseDefinition = base->isWritten() ? base->getDef() : (PcodeOp *)0;
+  vector<pair<BlockBasic *,PcodeOp *> > pending;
+  pending.emplace_back(call->getParent(),call);
+  set<BlockBasic *> visited;
+  size_t position = 0;
+  while(position < pending.size()) {
+    pair<BlockBasic *,PcodeOp *> state = pending[position++];
+    BlockBasic *block = state.first;
+    list<PcodeOp *>::iterator iter;
+    if (state.second != (PcodeOp *)0) {
+      iter = state.second->getBasicIter();
+      ++iter;
+    }
+    else {
+      if (!visited.insert(block).second) continue;
+      iter = block->beginOp();
+    }
+    bool follow = true;
+    for(;iter!=block->endOp();++iter) {
+      PcodeOp *cur = *iter;
+      if (cur == baseDefinition) {
+        follow = false;
+        break;
+      }
+      if (cur->code() == CPUI_CALL || cur->code() == CPUI_CALLIND) {
+        Varnode *out = cur->getOut();
+        if (!continuesCall(cur) || (out != (Varnode *)0 &&
+            (out->getSpace() == memory || out->getSpace()->getType() == IPTR_SPACEBASE))) {
+          follow = false;
+          break;
+        }
+        continue;
+      }
+      if (cur->getHaltType() != 0 || cur->code() == CPUI_CALLOTHER || cur->code() == CPUI_RETURN || cur->isCall()) {
+        follow = false;
+        break;
+      }
+      if (cur->isBranch()) {
+        // The target is control flow; other inputs can still read memory.
+        for(int4 i=1;i<cur->numInput();++i) {
+          AddrSpace *space = cur->getIn(i)->getSpace();
+          if (space == memory || space->getType() == IPTR_SPACEBASE) {
+            follow = false;
+            break;
+          }
+        }
+        break;
+      }
+      if (cur->code() == CPUI_LOAD || cur->code() == CPUI_STORE) {
+        if (cur->getIn(0)->getSpaceFromConst() != memory) continue;
+        Varnode *ptr = cur->getIn(1);
+        uintb readOffset;
+        if (ptr->getSize() != pointer->getSize() || callInputPointerBase(ptr,readOffset) != base) {
+          follow = false;
+          break;
+        }
+        Address addr(memory,memory->wrapOffset(AddrSpace::addressToByte(readOffset,memory->getWordSize())));
+        bool isLoad = cur->code() == CPUI_LOAD;
+        Varnode *value = isLoad ? cur->getOut() : cur->getIn(2);
+        if (value->isVolatile()) {
+          follow = false;
+          break;
+        }
+        int4 readSize = value->getSize();
+        if (addr.overlap(0,cell,size) < 0 && cell.overlap(0,addr,readSize) < 0) continue;
+        if (!isLoad || addr != cell || readSize != size) {
+          follow = false;
+          break;
+        }
+        if (!value->hasNoDescend()) return true;
+      }
+      else {
+        Varnode *out = cur->getOut();
+        if (out != (Varnode *)0 && (out->getSpace() == memory || out->getSpace()->getType() == IPTR_SPACEBASE)) {
+          follow = false;
+          break;
+        }
+        for(int4 i=0;i<cur->numInput();++i) {
+          AddrSpace *space = cur->getIn(i)->getSpace();
+          if (space == memory || space->getType() == IPTR_SPACEBASE) {
+            follow = false;
+            break;
+          }
+        }
+        if (!follow) break;
+      }
+    }
+    if (follow) {
+      for(int4 i=0;i<block->sizeOut();++i)
+        pending.emplace_back((BlockBasic *)block->getOut(i),(PcodeOp *)0);
+    }
+  }
+  return false;
+}
