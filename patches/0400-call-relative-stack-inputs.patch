+static void checkReusedCellCaller(SegmentedEnvironment &env,Funcdata *callee,bool observed) {
+  AddrSpace *ram = env.arch->getDefaultCodeSpace();
+  AddrSpace *stack = env.arch->getStackSpace();
+  Action *root = env.arch->allacts.getCurrent();
+  root->reset(*env.fd);
+  ASSERT(root->perform(*env.fd) >= 0);
+  ASSERT_EQUALS(env.fd->numCalls(),1);
+  FuncCallSpecs *spec = env.fd->getCallSpecs(0);
+  PcodeOp *call = spec->getOp();
+  ASSERT_EQUALS(call->getAddr(),Address(ram,0x1010));
+  ASSERT_EQUALS(spec->getEntryAddress(),callee->getAddress());
+  ASSERT_EQUALS(spec->getSpacebaseOffset(),FuncCallSpecs::offset_unknown);
+  ASSERT(!spec->isInputLocked());
+  ASSERT(!env.fd->getFuncProto().isInputLocked());
+  ASSERT(!spec->isInputActive());
+  ASSERT_EQUALS(call->numInput(),observed ? 2 : 1);
+  if (observed) {
+    ASSERT(call->getIn(1)->isConstant());
+    ASSERT_EQUALS(call->getIn(1)->getSize(),4);
+    ASSERT_EQUALS(call->getIn(1)->getOffset(),7);
+    ASSERT(spec->getUnresolvedInputStorages().empty());
+  }
+  else {
+    ASSERT(hasInputStorage(spec->getUnresolvedInputStorages(),Address(stack,4),4));
+    ASSERT_EQUALS(spec->getActiveInput()->whichTrial(Address(stack,4),4),-1);
+    PcodeOp *selected = env.fd->newOp(2,call->getAddr());
+    env.fd->opSetOpcode(selected,CPUI_CALL);
+    Varnode *target = env.fd->newVarnodeCallSpecs(spec);
+    env.fd->opSetInput(selected,target,0);
+    env.fd->opSetInput(selected,env.fd->newConstant(2,7),1);
+    env.fd->opInsertBefore(selected,call);
+    unique_ptr<FuncCallSpecs> clone(spec->clone(selected));
+    Varnode *annotation = env.fd->newVarnodeCallSpecs(clone.get());
+    env.fd->opSetInput(selected,annotation,0);
+    env.fd->deleteVarnode(target);
+    ASSERT(hasInputStorage(clone->getUnresolvedInputStorages(),Address(stack,4),4));
+    // Controlled finalizer inputs: a partial overlap must not erase the original unresolved cell.
+    ParamActive *active = clone->getActiveInput();
+    active->registerTrial(Address(stack,4),2);
+    active->getTrial(0).markUsed();
+    clone->buildInputFromTrials(*env.fd);
+    ASSERT(hasInputStorage(clone->getUnresolvedInputStorages(),Address(stack,4),4));
+    active->clear();
+    active->registerTrial(Address(stack,4),4);
+    active->getTrial(0).markUsed();
+    env.fd->opSetInput(selected,env.fd->newConstant(4,7),1);
+    clone->buildInputFromTrials(*env.fd);
+    ASSERT(clone->getUnresolvedInputStorages().empty());
+    env.fd->opDestroy(selected);
+    env.fd->deleteVarnode(annotation);
+  }
+  Varnode *returned = (Varnode *)0;
+  Varnode *laterRead = (Varnode *)0;
+  bool alignment = false;
+  Varnode *entry = env.fd->findVarnodeInput(4,env.arch->translate->getRegister("ESP").getAddr());
+  ASSERT(entry != (Varnode *)0);
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead()) continue;
+    if (op->code() == CPUI_RETURN && op->numInput() == 2) returned = op->getIn(1);
+    if (op->code() == CPUI_LOAD && op->getAddr() == Address(ram,0x1015)) laterRead = op->getOut();
+    if (op->code() == CPUI_INT_AND && op->getIn(1)->isConstant() && op->getIn(1)->getOffset() == 0xfffffff0)
+      alignment = alignment || tasm31DependsOn(op->getIn(0),entry);
+  }
+  ASSERT(alignment);
+  ASSERT(returned != (Varnode *)0);
+  ASSERT_EQUALS(returned->getSize(),4);
+  ASSERT(call->getOut() != (Varnode *)0);
+  ASSERT(laterRead != (Varnode *)0);
+  ASSERT(tasm31DependsOn(returned,call->getOut()));
+  ASSERT(tasm31DependsOn(returned,laterRead));
+  checkIncompleteCallWarning(env,spec,!observed);
+}
