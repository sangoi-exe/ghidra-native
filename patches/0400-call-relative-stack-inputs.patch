+static void setVariadicPrefix(SegmentedEnvironment &env,FuncProto &contract) {
+  istringstream declaration("uint4 audited_varargs(uint4 first,...);");
+  PrototypePieces pieces;
+  parse_protopieces(pieces,declaration,env.arch);
+  contract.setInternal(pieces.model,env.arch->types->getTypeVoid());
+  contract.setPieces(pieces);
+  ASSERT(contract.isInputLocked());
+  ASSERT(contract.isDotdotdot());
+  ASSERT_EQUALS(contract.numParams(),1);
+}
