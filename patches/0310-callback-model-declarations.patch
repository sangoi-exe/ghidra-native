+TEST(callback_model_declarations) {
+  IdentityEnvironment env;
+  IdentityTypes types(env.arch);
+  TypeFactory *factory = env.arch->types;
+  IdentityPrinter printer(env.arch);
+  printer.setMaxLineSize(200);
+  PrototypePieces signature;
+  signature.model = env.arch->getModel("__cdecl16far");
+  signature.outtype = types.word;
+  signature.intypes.push_back(factory->getTypePointer(2,types.cases[3],1));
+  signature.innames.push_back("input");
+  signature.firstVarArgSlot = -1;
+  TypeCode *anonymous = factory->getTypeCode(signature);
+  Datatype *pointer = factory->getTypePointer(4,anonymous,1);
+  ASSERT_EQUALS(printer.declaration(pointer),"IdentityWord (__cdecl16far *value)(const struct Alias *)");
+  ASSERT_EQUALS(printer.declaration(anonymous),"IdentityWord __cdecl16far value(const struct Alias *)");
+  Datatype *qualifiedPointer = factory->getQualifiedType(pointer,Datatype::qualifier_const);
+  Datatype *nestedPointer = factory->getQualifiedType(factory->getTypePointer(2,qualifiedPointer,1),Datatype::qualifier_volatile);
+  ASSERT_EQUALS(printer.declaration(nestedPointer),"IdentityWord (__cdecl16far *const *volatile value)(const struct Alias *)");
+  ASSERT_EQUALS(printer.declaration(factory->getTypeArray(2,pointer)),"IdentityWord (__cdecl16far *value [2])(const struct Alias *)");
+  printer.setConvention(false);
+  ASSERT_EQUALS(printer.declaration(pointer),"IdentityWord (*value)(const struct Alias *)");
+  printer.setConvention(true);
+  signature.model = env.arch->defaultfp;
+  ASSERT_EQUALS(signature.model->printInDecl(),false);
+  ASSERT_EQUALS(printer.declaration(factory->getTypePointer(2,factory->getTypeCode(signature),1)),"IdentityWord (*value)(const struct Alias *)");
+  Datatype *namedPointer = factory->getTypePointer(4,types.callback,1);
+  ASSERT_EQUALS(printer.declaration(namedPointer),"Callback *value");
+  ASSERT_EQUALS(printer.declaration(types.callback),"Callback value");
+  printer.expand(types.callback);
+  ASSERT_EQUALS(printer.declaration(namedPointer),"IdentityWord (__cdecl16far *value)(const struct Alias *)");
+  ASSERT_EQUALS(printer.declaration(types.callback),"IdentityWord __cdecl16far value(const struct Alias *)");
+  ASSERT_EQUALS(printer.declaration(types.cases[15]),"CallbackAlias value");
+  ASSERT_EQUALS(printer.declaration(factory->getTypePointer(4,types.cases[15],1)),"CallbackAlias *value");
+  ASSERT_EQUALS(printer.declaration(types.nearCallback),"Callback value");
+}
