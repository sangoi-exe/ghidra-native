   arch->print->setOutputStream((ostream *)0);
 }

+static void checkConditionalStackStore(const string &bytes)
+
+{
+  SegmentedEnvironment::initialize();
+  istringstream image(string(R"(<binaryimage arch="x86:LE:16:Protected Mode:default">
+<bytechunk space="ram" offset="0x1000" readonly="true">)") + bytes + R"(</bytechunk>
+</binaryimage>)");
+  DocumentStorage store;
+  Document *doc = store.parseDocument(image);
+  store.registerTag(doc->getRoot());
+  unique_ptr<Architecture> arch(ArchitectureCapability::getCapability("xml")->buildArchitecture("", "", &cout));
+  arch->init(store);
+  AddrSpace *ram = arch->getDefaultCodeSpace();
+  AddrSpace *stack = arch->getStackSpace();
+  Funcdata *fd = arch->symboltab->getGlobalScope()->addFunction(Address(ram,0x1000),"conditional_stack_store")->getFunction();
+  arch->allacts.getCurrent()->reset(*fd);
+  ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
+  ostringstream output;
+  arch->print->setOutputStream(&output);
+  arch->print->docFunction(fd);
+  arch->print->setOutputStream((ostream *)0);
+  // BX selects entry SP-0x10 or SP+0x20. Storing 3 makes the returned sum 4 or 5, never 3.
+  Varnode *negativeValue = (Varnode *)0;
+  Varnode *positiveValue = (Varnode *)0;
+  PcodeOp *returnOp = (PcodeOp *)0;
+  for(PcodeOpTree::const_iterator iter=fd->beginOpAll();iter!=fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead()) continue;
+    if (op->code() == CPUI_RETURN)
+      returnOp = op;
+    if (op->code() != CPUI_INDIRECT) continue;
+    PcodeOp *effect = PcodeOp::getOpFromConst(op->getIn(1)->getAddr());
+    if (effect->code() != CPUI_STORE || effect->getAddr() != Address(ram,0x101c)) continue;
+    Varnode *value = op->getOut();
+    if (value->getSpace() != stack || value->getSize() != 2) continue;
+    if (value->getOffset() == 0xfff0)
+      negativeValue = value;
+    if (value->getOffset() == 0x20)
+      positiveValue = value;
+  }
+  ASSERT(negativeValue != (Varnode *)0);
+  ASSERT(positiveValue != (Varnode *)0);
+  ASSERT(returnOp != (PcodeOp *)0);
+  ASSERT_EQUALS(returnOp->numInput(),2);
+  ASSERT(returnOp->getIn(1)->isWritten());
+  PcodeOp *sum = returnOp->getIn(1)->getDef();
+  ASSERT_EQUALS(sum->code(),CPUI_INT_ADD);
+  ASSERT((sum->getIn(0) == negativeValue && sum->getIn(1) == positiveValue) ||
+      (sum->getIn(0) == positiveValue && sum->getIn(1) == negativeValue));
+  string text = output.str();
+  ASSERT(text.find("aiStack_10[0] = 1;") != string::npos);
+  ASSERT(text.find("iStack0020 = 2;") != string::npos);
+  ASSERT(text.find("segmentop(unaff_SS, piVar1) = 3;") != string::npos);
+  ASSERT(text.find("return aiStack_10[0] + iStack0020;") != string::npos);
+}
+
+TEST(segmented_conditional_stack_store_negative) {
+  checkConditionalStackStore("558bec83ec10c746f20100c7462202008d5ef2837e040075038d5e2236c70703008b46f2034622c9c3");
+}
+
+TEST(segmented_conditional_stack_store_positive) {
+  checkConditionalStackStore("558bec83ec10c746f20100c7462202008d5e22837e040075038d5ef236c70703008b46f2034622c9c3");
+}
