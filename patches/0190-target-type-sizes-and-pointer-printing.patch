+TEST(target_fundamental_sizes) {
+  SegmentedEnvironment env;
+  TypeFactory *factory = env.arch->types;
+  ASSERT_EQUALS(factory->getSizeOfChar(),1);
+  ASSERT_EQUALS(factory->getSizeOfWChar(),2);
+  ASSERT_EQUALS(factory->getSizeOfShort(),2);
+  ASSERT_EQUALS(factory->getSizeOfInt(),2);
+  ASSERT_EQUALS(factory->getSizeOfLong(),4);
+  ASSERT_EQUALS(factory->getSizeOfLongLong(),4);
+  ASSERT_EQUALS(factory->getSizeOfFloat(),4);
+  ASSERT_EQUALS(factory->getSizeOfDouble(),8);
+  ASSERT_EQUALS(factory->getSizeOfLongDouble(),10);
+  ASSERT_EQUALS(factory->getSizeOfPointer(),2);
+  ASSERT_EQUALS(factory->getSizeOfAltPointer(),4);
+}
+
+TEST(target_fundamental_size_defaults) {
+  SegmentedEnvironment env;
+  TypeFactory factory(env.arch);
+  istringstream omitted("<data_organization><integer_size value=\"2\"/></data_organization>");
+  XmlDecode omittedDecoder(env.arch);
+  omittedDecoder.ingestStream(omitted);
+  factory.decodeDataOrganization(omittedDecoder);
+  factory.setupSizes();
+  ASSERT_EQUALS(factory.getSizeOfShort(),2);
+  ASSERT_EQUALS(factory.getSizeOfLongLong(),8);
+  ASSERT_EQUALS(factory.getSizeOfFloat(),4);
+  ASSERT_EQUALS(factory.getSizeOfDouble(),8);
+  ASSERT_EQUALS(factory.getSizeOfLongDouble(),16);
+
+  // Distinct local values prove that every field is decoded rather than replaced by a fallback.
+  istringstream explicitSizes("<data_organization><short_size value=\"1\"/><long_long_size value=\"16\"/><float_size value=\"2\"/><double_size value=\"4\"/><long_double_size value=\"8\"/></data_organization>");
+  XmlDecode explicitDecoder(env.arch);
+  explicitDecoder.ingestStream(explicitSizes);
+  factory.decodeDataOrganization(explicitDecoder);
+  factory.setupSizes();
+  ASSERT_EQUALS(factory.getSizeOfShort(),1);
+  ASSERT_EQUALS(factory.getSizeOfLongLong(),16);
+  ASSERT_EQUALS(factory.getSizeOfFloat(),2);
+  ASSERT_EQUALS(factory.getSizeOfDouble(),4);
+  ASSERT_EQUALS(factory.getSizeOfLongDouble(),8);
+
+  // Reloading core types clears data-types, not the compiler specification's organization.
+  istringstream coreTypes("<coretypes/>");
+  XmlDecode coreDecoder(env.arch);
+  coreDecoder.ingestStream(coreTypes);
+  factory.decodeCoreTypes(coreDecoder);
+  factory.clearNoncore();
+  factory.setupSizes();
+  ASSERT_EQUALS(factory.getSizeOfShort(),1);
+  ASSERT_EQUALS(factory.getSizeOfLongLong(),16);
+  ASSERT_EQUALS(factory.getSizeOfFloat(),2);
+  ASSERT_EQUALS(factory.getSizeOfDouble(),4);
+  ASSERT_EQUALS(factory.getSizeOfLongDouble(),8);
+}
+
+class PointerLayerPrintC : public PrintC {
+  OpToken nearPointer;
+  OpToken farPointer;
+protected:
+  virtual void pushPointerType(const TypePointer *ct) {
+    pushOp(ct->getSize() == 2 ? &nearPointer : &farPointer,(const PcodeOp *)0);
+  }
+public:
+  PointerLayerPrintC(Architecture *arch) : PrintC(arch), nearPointer(ptr_expr), farPointer(ptr_expr) {
+    nearPointer.print1 = "near *";
+    farPointer.print1 = "far *";
+  }
+};
+
+template<typename Printer> class PointerDeclarationPrinter : public Printer {
+public:
+  PointerDeclarationPrinter(Architecture *arch) : Printer(arch) {
+    this->initializeFromArchitecture();
+  }
+  string declaration(const Datatype *ct,bool noident = false) {
+    ostringstream output;
+    this->clear();
+    this->setOutputStream(&output);
+    this->pushTypeStart(ct,noident);
+    this->pushAtom(typename Printer::Atom(noident ? "" : "value",Printer::syntax,EmitMarkup::no_color));
+    this->pushTypeEnd(ct);
+    this->recurse();
+    this->emit->flush();
+    this->setOutputStream((ostream *)0);
+    return output.str();
+  }
+};
+
+TEST(pointer_type_layer_printing) {
+  SegmentedEnvironment env;
+  TypeFactory *factory = env.arch->types;
+  Datatype *word = factory->getBase(2,TYPE_UINT,"word");
+  Datatype *farPointer = factory->getTypePointer(4,word,1);
+  Datatype *mixedPointer = factory->getTypePointer(2,farPointer,1);
+  Datatype *pointerToArray = factory->getTypePointer(2,factory->getTypeArray(3,word),1);
+  Datatype *arrayOfPointers = factory->getTypeArray(3,farPointer);
+  PrototypePieces prototype;
+  prototype.model = env.arch->defaultfp;
+  prototype.outtype = word;
+  prototype.firstVarArgSlot = -1;
+  TypeCode *function = factory->getTypeCode(prototype);
+  Datatype *functionPointer = factory->getTypePointer(4,function,1);
+  PointerDeclarationPrinter<PrintC> plain(env.arch);
+  PointerDeclarationPrinter<PointerLayerPrintC> qualified(env.arch);
+  ASSERT_EQUALS(plain.declaration(mixedPointer),"word **value");
+  ASSERT_EQUALS(qualified.declaration(mixedPointer),"word far *near *value");
+  ASSERT_EQUALS(plain.declaration(mixedPointer,true),"word **");
+  ASSERT_EQUALS(qualified.declaration(mixedPointer,true),"word far *near *");
+  ASSERT_EQUALS(plain.declaration(pointerToArray),"word (*value) [3]");
+  ASSERT_EQUALS(qualified.declaration(pointerToArray),"word (near *value) [3]");
+  ASSERT_EQUALS(plain.declaration(arrayOfPointers),"word *value [3]");
+  ASSERT_EQUALS(qualified.declaration(arrayOfPointers),"word far *value [3]");
+  ASSERT_EQUALS(plain.declaration(functionPointer),"word (*value)(void)");
+  ASSERT_EQUALS(qualified.declaration(functionPointer),"word (far *value)(void)");
+  ASSERT(function->getPrototype()->hasMatchingModel(prototype.model));
+}

