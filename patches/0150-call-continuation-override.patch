+const string Override::CallContinuation::NAME = "call_continuation";
+
+void Override::CallContinuation::performOverride(const Address &addr,Funcdata &data) const
+
+{
+  PcodeOp *op = data.findPrimaryBranch(addr,false,true,false,false);
+  if (op == (PcodeOp *)0 || !op->isDead())
+    throw LowlevelError("Could not apply CALL continuation override");
+  // Keep the decoded CALL and its pushed return address; only redirect analyzed continuation.
+  PcodeOp *branch = data.newOp(1,addr);
+  data.opSetOpcode(branch,CPUI_BRANCH);
+  data.opSetInput(branch,data.newCodeRef(resumeAddress),0);
+  data.opDeadInsertAfter(branch,op);
+}
+
+void Override::CallContinuation::encode(Encoder &encoder,const Address &addr) const
+
+{
+  encoder.openElement(ELEM_CALLDEST);
+  encoder.writeString(ATTRIB_TYPE, NAME);
+  addr.encode(encoder);
+  resumeAddress.encode(encoder);
+  encoder.closeElement(ELEM_CALLDEST);
+}
+
+void Override::CallContinuation::printRaw(ostream &s,const Address &addr) const
+
+{
+  s << "override CALL continuation at " << addr << " to resume at " << resumeAddress << endl;
+}
