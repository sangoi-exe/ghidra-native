 } // End namespace ghidra
diff --git a/src/unittests/testsegmented.cc b/src/unittests/testsegmented.cc
--- a/src/unittests/testsegmented.cc
+++ b/src/unittests/testsegmented.cc
@@ -527,4 +527,103 @@
   checkQualifiedPrototypes("Real Mode");
 }

+TEST(call_continuation_override) {
+  SegmentedEnvironment::initialize();
+  // The caller supplies a qualified resume; these decoded bytes test the operation, not helper/prefix qualification.
+  for(int4 length=7;length>=6;--length) {
+    istringstream image(string(R"(<binaryimage arch="x86:LE:16:Protected Mode:default">
+<bytechunk space="ram" offset="0x1000de2c" readonly="true">e8c1d6)") +
+        (length == 7 ? "07" : "06") + R"(00000000000040b83412c3</bytechunk>
+</binaryimage>)");
+    DocumentStorage store;
+    Document *doc = store.parseDocument(image);
+    store.registerTag(doc->getRoot());
+    unique_ptr<Architecture> arch(ArchitectureCapability::getCapability("xml")->buildArchitecture("", "", &cout));
+    arch->init(store);
+    AddrSpace *ram = arch->getDefaultCodeSpace();
+    Address callAddress(ram,0x1000de2c);
+    Address adjacentReturn(ram,0x1000de2f);
+    Address resume(ram,adjacentReturn.getOffset() + 1 + length);
+    Address target(ram,0x1000b4f0);
+    Scope *global = arch->symboltab->getGlobalScope();
+    global->addFunction(target,"inline_consumer");
+    Funcdata *fd = global->addFunction(callAddress,"inline_caller")->getFunction();
+    istringstream helperDeclaration("extern void __cdecl16near inline_consumer(void);");
+    parse_C(arch.get(),helperDeclaration);
+    istringstream callerDeclaration("extern uint2 __cdecl16near inline_caller(void);");
+    parse_C(arch.get(),callerDeclaration);
+    ASSERT_EQUALS(arch->translate->instructionLength(callAddress),3);
+
+    Override original;
+    original.insertDestinationOverride(callAddress,resume,Override::CallContinuation::NAME);
+    ostringstream encoded;
+    XmlEncode encoder(encoded);
+    original.encode(encoder,arch.get());
+    istringstream input(encoded.str());
+    XmlDecode decoder(arch.get());
+    decoder.ingestStream(input);
+    fd->getOverride().decode(decoder,arch.get());
+
+    fd->startProcessing();
+    ASSERT_EQUALS(fd->numCalls(),1);
+    FuncCallSpecs *spec = fd->getCallSpecs(0);
+    ASSERT_EQUALS(spec->getEntryAddress(),target);
+    ASSERT(!spec->isNoReturn());
+    PcodeOp *call = spec->getOp();
+    ASSERT_EQUALS(call->code(),CPUI_CALL);
+    ASSERT_EQUALS(call->getAddr(),callAddress);
+    PcodeOp *branch = call->nextOp();
+    ASSERT(branch != (PcodeOp *)0);
+    ASSERT_EQUALS(branch->code(),CPUI_BRANCH);
+    ASSERT_EQUALS(branch->getAddr(),callAddress);
+    ASSERT_EQUALS(branch->getIn(0)->getAddr(),resume);
+    ASSERT_EQUALS(call->getParent()->sizeOut(),1);
+    ASSERT_EQUALS(call->getParent()->getOut(0)->getStart(),resume);
+    Varnode *returnValue = (Varnode *)0;
+    bool pushedAdjacentReturn = false;
+    bool sawResume = false;
+    int4 returns = 0;
+    for(PcodeOpTree::const_iterator iter=fd->beginOpAll();iter!=fd->endOpAll();++iter) {
+      PcodeOp *op = (*iter).second;
+      ASSERT(op->getAddr() < adjacentReturn || resume <= op->getAddr());
+      if (op->getAddr() == resume)
+        sawResume = true;
+      if (op->getAddr() == callAddress && op->code() == CPUI_COPY) {
+        Varnode *value = op->getIn(0);
+        if (value->isConstant() && value->getSize() == 2 && value->getOffset() == 0xde2f)
+          returnValue = op->getOut();
+      }
+      if (op->getAddr() == callAddress && op->code() == CPUI_STORE && returnValue != (Varnode *)0) {
+        // Raw instruction inputs have not yet been linked by heritage.
+        Varnode *value = op->getIn(2);
+        if (value->getAddr() == returnValue->getAddr() && value->getSize() == returnValue->getSize())
+          pushedAdjacentReturn = true;
+      }
+      if (op->code() == CPUI_RETURN) {
+        ASSERT_EQUALS(op->getAddr(),Address(ram,0x1000de3a));
+        ++returns;
+      }
+    }
+    ASSERT(pushedAdjacentReturn);
+    ASSERT(sawResume);
+    ASSERT_EQUALS(returns,1);
+    ASSERT_EQUALS(arch->translate->instructionLength(callAddress),3);
+
+    arch->clearAnalysis(fd);
+    arch->allacts.getCurrent()->reset(*fd);
+    ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
+    ASSERT_EQUALS(fd->numCalls(),1);
+    ASSERT_EQUALS(fd->getCallSpecs(0)->getEntryAddress(),target);
+    ASSERT(!fd->getCallSpecs(0)->isNoReturn());
+    ostringstream output;
+    arch->print->setOutputStream(&output);
+    arch->print->docFunction(fd);
+    string text = output.str();
+    ASSERT(text.find("inline_consumer();") != string::npos);
+    ASSERT(text.find("return 0x1234;") != string::npos);
+    ASSERT(text.find("halt_") == string::npos);
+    arch->print->setOutputStream((ostream *)0);
+  }
+}
+
 } // End namespace ghidra
