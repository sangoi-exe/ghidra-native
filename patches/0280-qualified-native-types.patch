+#include "architecture.hh"
+#include "libdecomp.hh"
+#include "printc.hh"
+#include "test.hh"
+
+namespace ghidra {
+
+class QualifiedTypeEnvironment {
+public:
+  Architecture *arch;
+  QualifiedTypeEnvironment(void) {
+    startDecompilerLibrary(getenv("SLEIGHHOME"));
+    istringstream input("<binaryimage arch=\"x86:LE:16:Protected Mode:default\"><bytechunk space=\"ram\" offset=\"0x1000\" readonly=\"true\">cb</bytechunk></binaryimage>");
+    DocumentStorage store;
+    Document *document = store.parseDocument(input);
+    store.registerTag(document->getRoot());
+    arch = ArchitectureCapability::getCapability("xml")->buildArchitecture("","",&cout);
+    arch->init(store);
+  }
+  ~QualifiedTypeEnvironment(void) { delete arch; }
+};
+
+class QualifiedDeclarationPrinter : public PrintC {
+public:
+  QualifiedDeclarationPrinter(Architecture *arch) : PrintC(arch) { initializeFromArchitecture(); }
+  string declaration(const Datatype *type,bool abstract = false) {
+    ostringstream output;
+    clear();
+    setOutputStream(&output);
+    pushTypeStart(type,abstract);
+    pushAtom(Atom(abstract ? "" : "value",syntax,EmitMarkup::no_color));
+    pushTypeEnd(type);
+    recurse();
+    emit->flush();
+    setOutputStream((ostream *)0);
+    return output.str();
+  }
+};
+
+TEST(qualified_type_identity) {
+  QualifiedTypeEnvironment env;
+  TypeFactory *factory = env.arch->types;
+  Datatype *word = factory->getBase(2,TYPE_UINT,"word");
+  uint8 id = word->getId();
+  Datatype *constant = factory->getQualifiedType(word,Datatype::qualifier_const);
+  Datatype *vol = factory->getQualifiedType(word,Datatype::qualifier_volatile);
+  Datatype *both = factory->getQualifiedType(constant,Datatype::qualifier_volatile);
+  ASSERT_NOT_EQUALS(constant,word);
+  ASSERT_NOT_EQUALS(constant,vol);
+  ASSERT_NOT_EQUALS(constant->getId(),id);
+  ASSERT_NOT_EQUALS(vol->getId(),id);
+  ASSERT_EQUALS(word->getId(),id);
+  ASSERT_EQUALS(word->getQualifiers(),0);
+  ASSERT_EQUALS(factory->findByName("word"),word);
+  ASSERT_EQUALS(factory->getQualifiedType(word,Datatype::qualifier_const),constant);
+  ASSERT_EQUALS(factory->getQualifiedType(vol,Datatype::qualifier_const),both);
+  ASSERT_EQUALS(both->getUnqualified(),word);
+  ASSERT_EQUALS(both->getQualifiers(),(uint4)Datatype::qualifier_mask);
+  ASSERT_EQUALS(factory->resizeInteger(constant,4)->getQualifiers(),constant->getQualifiers());
+  TypeEnum *enumeration = factory->getTypeEnum("Mode");
+  factory->setEnumValues({{1,"enabled"}},enumeration);
+  TypeEnum *qualifiedEnum = (TypeEnum *)factory->getQualifiedType(enumeration,Datatype::qualifier_const);
+  ASSERT(qualifiedEnum->isEnumType());
+  ASSERT(qualifiedEnum->hasNamedValue(1));
+  ASSERT_EQUALS(qualifiedEnum->getUnqualified(),enumeration);
+  Datatype *character = factory->getTypeChar(1);
+  Datatype *qualifiedChar = factory->getQualifiedType(character,Datatype::qualifier_const);
+  ASSERT(qualifiedChar->isASCII());
+  ASSERT_EQUALS(qualifiedChar->getSubMeta(),character->getSubMeta());
+  ASSERT_NOT_EQUALS(constant->compareDependency(*word),0);
+  ASSERT_NOT_EQUALS(constant->compare(*word,10),0);
+  TypePointer *plainPointer = factory->getTypePointer(2,word,1);
+  TypePointer *pointee = factory->getTypePointer(2,vol,1);
+  TypePointer *pointer = (TypePointer *)factory->getQualifiedType(plainPointer,Datatype::qualifier_volatile);
+  ASSERT_EQUALS(pointer->getMetatype(),TYPE_PTR);
+  ASSERT_EQUALS(pointer->getPtrTo(),word);
+  ASSERT_EQUALS(factory->resizePointer(pointer,4)->getQualifiers(),pointer->getQualifiers());
+  ASSERT_EQUALS(pointee->getPtrTo(),vol);
+  ASSERT_NOT_EQUALS(pointer,pointee);
+  ASSERT_NOT_EQUALS(pointer->compareDependency(*plainPointer),0);
+  ASSERT_EQUALS(factory->getTypePointer(2,word,1),plainPointer);
+  Datatype *alias = factory->getTypedef(constant,"ConstWord",0,0);
+  ASSERT(alias->isConst());
+  ASSERT_EQUALS(alias->getTypedef(),constant);
+  ASSERT_EQUALS(alias->getUnqualified(),alias);
+  ASSERT_EQUALS(factory->getQualifiedType(alias,Datatype::qualifier_const),alias);
+  Datatype *volatileAlias = factory->getQualifiedType(alias,Datatype::qualifier_volatile);
+  ASSERT(volatileAlias->isConst());
+  ASSERT(volatileAlias->isVolatile());
+  ASSERT_EQUALS(volatileAlias->getUnqualified(),alias);
+}
+
+TEST(qualified_type_declarators) {
+  QualifiedTypeEnvironment env;
+  TypeFactory *factory = env.arch->types;
+  Datatype *word = factory->getBase(2,TYPE_UINT,"word");
+  Datatype *constant = factory->getQualifiedType(word,Datatype::qualifier_const);
+  Datatype *vol = factory->getQualifiedType(word,Datatype::qualifier_volatile);
+  TypePointer *plainPointer = factory->getTypePointer(2,word,1);
+  Datatype *constPointer = factory->getQualifiedType(plainPointer,Datatype::qualifier_const);
+  Datatype *pointer = factory->getQualifiedType(factory->getTypePointer(2,vol,1),Datatype::qualifier_const);
+  QualifiedDeclarationPrinter printer(env.arch);
+  ASSERT_EQUALS(printer.declaration(word),"word value");
+  ASSERT_EQUALS(printer.declaration(factory->getTypePointer(2,factory->getQualifiedType(factory->getTypeVoid(),Datatype::qualifier_const),1)),"const void *value");
+  ASSERT_EQUALS(printer.declaration(constant),"const word value");
+  ASSERT_EQUALS(printer.declaration(vol),"volatile word value");
+  ASSERT_EQUALS(printer.declaration(pointer),"volatile word *const value");
+  ASSERT_EQUALS(printer.declaration(pointer,true),"volatile word *const ");
+  ASSERT_EQUALS(printer.declaration(factory->getTypePointer(2,constPointer,1)),"word *const *value");
+  ASSERT_EQUALS(printer.declaration(factory->getTypeArray(3,constPointer)),"word *const value [3]");
+  Datatype *array = factory->getQualifiedType(factory->getTypeArray(3,word),Datatype::qualifier_const);
+  ASSERT_EQUALS(((TypeArray *)array)->getBase(),constant);
+  ASSERT_EQUALS(printer.declaration(array),"const word value [3]");
+  ASSERT_EQUALS(printer.declaration(factory->getTypePointer(2,array,1)),"const word (*value) [3]");
+  Datatype *alias = factory->getTypedef(constant,"ConstWord",0,0);
+  ASSERT_EQUALS(printer.declaration(alias),"ConstWord value");
+  ASSERT_EQUALS(printer.declaration(factory->getQualifiedType(alias,Datatype::qualifier_volatile)),"volatile ConstWord value");
+  Datatype *pointerAlias = factory->getTypedef(plainPointer,"WordPointer",0,0);
+  ASSERT_EQUALS(printer.declaration(factory->getQualifiedType(pointerAlias,Datatype::qualifier_const)),"const WordPointer value");
+  PrototypePieces signature;
+  signature.model = env.arch->defaultfp;
+  signature.outtype = constant;
+  signature.intypes.push_back(factory->getTypePointer(2,vol,1));
+  signature.innames.push_back("input");
+  signature.firstVarArgSlot = -1;
+  TypeCode *code = factory->getTypeCode(signature);
+  TypePointer *callback = factory->getTypePointer(2,code,1);
+  Datatype *constCallback = factory->getQualifiedType(callback,Datatype::qualifier_const);
+  ASSERT_EQUALS(((TypePointer *)constCallback)->getPtrTo(),code);
+  ASSERT_EQUALS(printer.declaration(constCallback),"const word (*const value)(volatile word *)");
+  ASSERT_EQUALS(printer.declaration(factory->getQualifiedType(factory->getTypeStruct("Record"),Datatype::qualifier_mask)),"const volatile Record value");
+}
