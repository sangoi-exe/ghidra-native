+template<typename Encode,typename Decode> static void qualifiedCodecRoundTrip(void) {
+  QualifiedTypeEnvironment source;
+  TypeFactory *factory = source.arch->types;
+  Datatype *word = factory->getBase(2,TYPE_UINT,"word");
+  Datatype *vol = factory->getQualifiedType(word,Datatype::qualifier_volatile);
+  Datatype *alias = factory->getTypedef(vol,"VolatileWord",0,0);
+  Datatype *qualifiedAlias = factory->getQualifiedType(alias,Datatype::qualifier_const);
+  Datatype *pointer = factory->getQualifiedType(factory->getTypePointer(2,qualifiedAlias,1),Datatype::qualifier_volatile);
+  TypeStruct *record = factory->getTypeStruct("Record");
+  Datatype *qualifiedRecord = factory->getQualifiedType(record,Datatype::qualifier_const);
+  vector<TypeField> fields;
+  fields.push_back(TypeField(0,0,"next",factory->getTypePointer(2,qualifiedRecord,1)));
+  factory->setFields(fields,{},record,2,2,0);
+  PrototypePieces signature;
+  signature.model = source.arch->defaultfp;
+  signature.outtype = qualifiedAlias;
+  signature.intypes.push_back(pointer);
+  signature.innames.push_back("input");
+  signature.firstVarArgSlot = -1;
+  TypeCode *code = factory->getTypeCode(signature);
+  Datatype *callback = factory->getQualifiedType(factory->getTypePointer(2,code,1),Datatype::qualifier_const);
+  vector<Datatype *> cases = {vol,alias,qualifiedAlias,pointer,qualifiedRecord,factory->getQualifiedType(factory->getTypeArray(3,word),Datatype::qualifier_const),callback};
+  ostringstream output;
+  Encode encoder(output);
+  encoder.openElement(ELEM_TYPEGRP);
+  word->encode(encoder);
+  alias->encode(encoder);
+  record->encode(encoder);
+  for(Datatype *type : cases) {
+    type->encode(encoder);
+    type->encodeRef(encoder);
+  }
+  encoder.closeElement(ELEM_TYPEGRP);
+  QualifiedTypeEnvironment restored;
+  TypeFactory *target = restored.arch->types;
+  istringstream input(output.str());
+  Decode decoder(restored.arch);
+  decoder.ingestStream(input);
+  uint4 element = decoder.openElement(ELEM_TYPEGRP);
+  Datatype *restoredWord = target->decodeType(decoder);
+  Datatype *restoredAlias = target->decodeType(decoder);
+  Datatype *restoredRecord = target->decodeType(decoder);
+  for(Datatype *type : cases) {
+    Datatype *actual = target->decodeType(decoder);
+    ASSERT_EQUALS(target->decodeType(decoder),actual);
+    ASSERT_EQUALS(actual->getMetatype(),type->getMetatype());
+    ASSERT_EQUALS(actual->getQualifiers(),type->getQualifiers());
+    ASSERT_EQUALS(actual->getName(),type->getName());
+    ASSERT_EQUALS(actual->getId(),type->getId());
+    ASSERT_EQUALS(actual->getSize(),type->getSize());
+    ASSERT_EQUALS(actual->isIncomplete(),false);
+    if (type == vol) ASSERT_EQUALS(actual->getUnqualified(),restoredWord);
+    if (type == alias) ASSERT_EQUALS(actual,restoredAlias);
+    if (type == qualifiedAlias) ASSERT_EQUALS(actual->getUnqualified(),restoredAlias);
+    if (type == qualifiedRecord) {
+      ASSERT_EQUALS(actual->getUnqualified(),restoredRecord);
+      ASSERT_EQUALS(actual->numDepend(),1);
+      ASSERT_EQUALS(((TypePointer *)actual->getDepend(0))->getPtrTo(),actual);
+    }
+    QualifiedDeclarationPrinter sourcePrinter(source.arch);
+    QualifiedDeclarationPrinter restoredPrinter(restored.arch);
+    ASSERT_EQUALS(restoredPrinter.declaration(actual),sourcePrinter.declaration(type));
+  }
+  ASSERT_EQUALS(restoredWord->getQualifiers(),0);
+  ASSERT_EQUALS(target->findByName("word"),restoredWord);
+  decoder.closeElement(element);
+  ostringstream saved;
+  Encode savedEncoder(saved);
+  savedEncoder.openElement(ELEM_DATA);
+  factory->encode(savedEncoder);
+  for(Datatype *type : cases)
+    type->encodeRef(savedEncoder);
+  savedEncoder.closeElement(ELEM_DATA);
+  QualifiedTypeEnvironment savedEnvironment;
+  istringstream savedInput(saved.str());
+  Decode savedDecoder(savedEnvironment.arch);
+  savedDecoder.ingestStream(savedInput);
+  uint4 dataElement = savedDecoder.openElement(ELEM_DATA);
+  TypeFactory *savedFactory = savedEnvironment.arch->types;
+  savedFactory->decode(savedDecoder);
+  for(Datatype *type : cases) {
+    Datatype *actual = savedFactory->decodeType(savedDecoder);
+    ASSERT_EQUALS(actual->getQualifiers(),type->getQualifiers());
+    ASSERT_EQUALS(actual->getName(),type->getName());
+    ASSERT_EQUALS(actual->getSize(),type->getSize());
+    ASSERT_EQUALS(actual->isIncomplete(),false);
+    QualifiedDeclarationPrinter originalPrinter(source.arch);
+    QualifiedDeclarationPrinter actualPrinter(savedEnvironment.arch);
+    ASSERT_EQUALS(actualPrinter.declaration(actual),originalPrinter.declaration(type));
+  }
+  savedDecoder.closeElement(dataElement);
+}
+
+TEST(qualified_type_xml_roundtrip) { qualifiedCodecRoundTrip<XmlEncode,XmlDecode>(); }
+TEST(qualified_type_packed_roundtrip) { qualifiedCodecRoundTrip<PackedEncode,PackedDecode>(); }
+
+TEST(qualified_type_incomplete_completion) {
+  QualifiedTypeEnvironment env;
+  TypeFactory *factory = env.arch->types;
+  Datatype *word = factory->getBase(2,TYPE_UINT,"word");
+  TypeStruct *record = factory->getTypeStruct("Record");
+  Datatype *qualified = factory->getQualifiedType(record,Datatype::qualifier_const);
+  Datatype *alias = factory->getTypedef(qualified,"RecordAlias",0,0);
+  Datatype *qualifiedAlias = factory->getQualifiedType(alias,Datatype::qualifier_volatile);
+  TypePointer *pointer = factory->getTypePointer(2,qualified,1);
+  ASSERT(qualified->isIncomplete());
+  ASSERT(alias->isIncomplete());
+  vector<TypeField> fields = {TypeField(0,0,"value",word)};
+  factory->setFields(fields,{},record,2,2,0);
+  for(Datatype *type : {qualified,alias,qualifiedAlias}) {
+    ASSERT_EQUALS(type->isIncomplete(),false);
+    ASSERT_EQUALS(type->getSize(),2);
+    ASSERT_EQUALS(type->numDepend(),1);
+    ASSERT_EQUALS(type->getDepend(0),word);
+  }
+  ASSERT_EQUALS(factory->getQualifiedType(record,Datatype::qualifier_const),qualified);
+  ASSERT_EQUALS(factory->getTypePointer(2,qualified,1),pointer);
+  ASSERT_EQUALS(pointer->getSubMeta(),factory->getTypePointer(2,record,1)->getSubMeta());
+  TypeUnion *un = factory->getTypeUnion("Choice");
+  Datatype *qualifiedUnion = factory->getQualifiedType(un,Datatype::qualifier_volatile);
+  Datatype *unionAlias = factory->getTypedef(qualifiedUnion,"ChoiceAlias",0,0);
+  factory->setFields(fields,un,2,2,0);
+  ASSERT_EQUALS(qualifiedUnion->isIncomplete(),false);
+  ASSERT_EQUALS(unionAlias->isIncomplete(),false);
+  ASSERT_EQUALS(qualifiedUnion->getDepend(0),word);
+  ASSERT_EQUALS(unionAlias->getDepend(0),word);
+}
