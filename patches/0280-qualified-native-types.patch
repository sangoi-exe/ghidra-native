+/// Add qualifiers at one declaration layer, preserving the concrete class and canonical owner.
+Datatype *TypeFactory::getQualifiedType(Datatype *ct,uint4 qualifiers)
+
+{
+  if ((qualifiers & ~((uint4)Datatype::qualifier_mask)) != 0)
+    throw LowlevelError("Unsupported data-type qualifiers");
+  if (qualifiers != 0 && ct->getMetatype() == TYPE_CODE)
+    throw LowlevelError("Function types cannot be const or volatile");
+  qualifiers |= ct->getQualifiers();
+  if (qualifiers == ct->getQualifiers()) return ct;
+  Datatype *base = ct->getUnqualified();
+  Datatype *element = (Datatype *)0;
+  if (base->getMetatype() == TYPE_ARRAY)
+    element = getQualifiedType(((TypeArray *)base)->arrayof,qualifiers);
+  Datatype *candidate = base->clone();
+  candidate->flags = (candidate->flags & ~(uint4)(Datatype::coretype | Datatype::qualifier_mask)) | qualifiers;
+  candidate->qualifiedBase = base;
+  if (base->id != 0)
+    candidate->id = Datatype::hashSize(base->id,qualifiers);
+  if (element != (Datatype *)0)
+    ((TypeArray *)candidate)->arrayof = element;
+  Datatype *res = findNoName(*candidate);
+  if (res != (Datatype *)0) {
+    delete candidate;
+    return res;
+  }
+  insert(candidate);
+  if (candidate->isIncomplete())
+    incompleteTypedef.push_back(candidate);
+  return candidate;
 }
 
