+static void checkProjectedCallEffect(const string &regname,int4 offset,bool preserved,bool protectedGuard = false,bool callOutput = false,bool pending = false) {
+  SegmentedEnvironment env(true,"x86:LE:16:Protected Mode:default","e81000cb");
+  ASSERT_EQUALS(env.fd->numCalls(),1);
+  FuncCallSpecs *fc = env.fd->getCallSpecs(0);
+  fc->setInternal(env.arch->getModel("__cdecl16far"),env.arch->types->getTypeVoid());
+  if (!pending) {
+    ActionExtraPopSetup setup("base",env.arch->getStackSpace());
+    setup.apply(*env.fd);
+  }
+  ASSERT_EQUALS(fc->getEffectiveExtraPop(),pending ? ProtoModel::extrapop_unknown : 4);
+  PcodeOp *call = fc->getOp();
+  VarnodeData storage = env.arch->translate->getRegister(regname);
+  Address address(storage.space,storage.offset);
+  Varnode *input = env.fd->setInputVarnode(env.fd->newVarnode(storage.size,address));
+  input->setConsume((uintb)0xffff << (8*offset));
+  PcodeOp *guard = env.op(CPUI_INDIRECT,{input,env.fd->newVarnodeIop(call)});
+  env.fd->newVarnodeOut(storage.size,address,guard);
+  if (protectedGuard) guard->setNoIndirectCollapse();
+  if (callOutput) env.fd->newVarnodeOut(2,address+offset,call);
+  PcodeOp *slice = env.op(CPUI_SUBPIECE,{guard->getOut(),env.constant(4,offset)},env.arch->types->getBase(2,TYPE_UINT));
+  PcodeOp *use = env.op(CPUI_COPY,{slice->getOut()},env.arch->types->getBase(2,TYPE_UINT));
+  ASSERT_EQUALS(fc->hasEffectTranslate(address,storage.size),EffectRecord::unknown_effect);
+  RulePullsubIndirect rule("base");
+  ASSERT_EQUALS(rule.applyOp(slice,*env.fd),1);
+  Varnode *result = use->getIn(0)->getDef()->getIn(0);
+  ASSERT_EQUALS(result->getDef()->code(),preserved ? CPUI_SUBPIECE : CPUI_INDIRECT);
+  if (preserved) {
+    ASSERT_EQUALS(result->getDef()->getIn(0),input);
+    ASSERT_EQUALS(result->getDef()->getIn(1)->getOffset(),offset);
+  }
+  else {
+    ASSERT_EQUALS(PcodeOp::getOpFromConst(result->getDef()->getIn(1)->getAddr()),call);
+  }
+}
+
+TEST(segmented_projected_unaffected_call_effect) {
+  checkProjectedCallEffect("ESP",0,true);
+  checkProjectedCallEffect("ESI",0,true);
+}
+
+TEST(segmented_projected_unknown_upper_call_effect) {
+  checkProjectedCallEffect("ESP",2,false);
+}
+
+TEST(segmented_projected_pending_cleanup) {
+  checkProjectedCallEffect("ESP",0,false,false,false,true);
+  checkProjectedCallEffect("ESI",0,true,false,false,true);
+}
+
+TEST(segmented_projected_protected_call_effect) {
+  checkProjectedCallEffect("ESP",0,false,true);
+  checkProjectedCallEffect("ESP",0,false,false,true);
+}
