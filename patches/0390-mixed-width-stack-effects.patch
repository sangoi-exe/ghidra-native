+TEST(segmented_projected_aggregate_source_slice) {
+  for(bool reuse : {false,true}) {
+    SegmentedEnvironment env(true,"x86:LE:16:Protected Mode:default","e81000cb");
+    ASSERT_EQUALS(env.fd->numCalls(),1);
+    FuncCallSpecs *fc = env.fd->getCallSpecs(0);
+    fc->setInternal(env.arch->getModel("__cdecl16far"),env.arch->types->getTypeVoid());
+    Datatype *word = env.arch->types->getBase(2,TYPE_UINT);
+    Datatype *byte = env.arch->types->getBase(1,TYPE_UINT);
+    Varnode *base = env.op(CPUI_COPY,{env.constant(4,0x44332211)},env.arch->types->getBase(4,TYPE_UINT))->getOut();
+    base->setConsume(0xffff);
+    Varnode *existing = (Varnode *)0;
+    if (reuse) existing = env.op(CPUI_SUBPIECE,{base,env.constant(4,0)},word)->getOut();
+    PcodeOp *guard = env.op(CPUI_INDIRECT,{base,env.fd->newVarnodeIop(fc->getOp())});
+    env.fd->newVarnodeOut(4,env.arch->translate->getRegister("ESI").getAddr(),guard);
+    PcodeOp *high = env.op(CPUI_SUBPIECE,{guard->getOut(),env.constant(4,1)},byte);
+    PcodeOp *low = env.op(CPUI_SUBPIECE,{guard->getOut(),env.constant(4,0)},word);
+    RulePullsubIndirect rule("base");
+    ASSERT_EQUALS(rule.applyOp(high,*env.fd),1);
+    ASSERT_EQUALS(low->code(),CPUI_COPY);
+    Varnode *selected = low->getIn(0);
+    if (reuse) ASSERT_EQUALS(selected,existing);
+    ASSERT_EQUALS(selected->getSize(),2);
+    PcodeOp *slice = selected->getDef();
+    ASSERT_EQUALS(slice->code(),CPUI_SUBPIECE);
+    ASSERT_EQUALS(slice->getIn(0),base);
+    ASSERT_EQUALS(slice->getIn(1)->getOffset(),0);
+    ASSERT_EQUALS(high->getIn(0),selected);
+    ASSERT_EQUALS(high->getIn(1)->getOffset(),1);
+    uintb value = slice->getOpcode()->getBehavior()->evaluateBinary(2,4,0x44332211,slice->getIn(1)->getOffset());
+    ASSERT_EQUALS(value,0x2211);
+    ASSERT_EQUALS(high->getOpcode()->getBehavior()->evaluateBinary(1,2,value,high->getIn(1)->getOffset()),0x22);
+  }
+}
