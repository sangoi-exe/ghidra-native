+  ASSERT_EQUALS(*fd->beginLoc(2,address),first->getOut());
+  ASSERT_EQUALS(fd->findCoveringInput(2,address),input);
+  ActionStackPtrFlow action("base",arch->getStackSpace());
+  action.reset(*fd);
+  action.apply(*fd);
+  ASSERT_EQUALS(root->code(),CPUI_SUBPIECE);
+  ASSERT_EQUALS(root->getIn(0),input);
+  ASSERT_EQUALS(first->getIn(0),root->getOut());
+  ASSERT_EQUALS(first->getIn(1)->getOffset(),0xfffc);
+  ASSERT_EQUALS(second->getIn(0),root->getOut());
+  ASSERT_EQUALS(second->getIn(1)->getOffset(),0xfff8);
+  ASSERT(fd->findVarnodeInput(2,address) == (Varnode *)0);
+}
