+static void checkProjectedCleanupMarker(bool lateKnown) {
+  SegmentedEnvironment env(true,"x86:LE:16:Protected Mode:default","e81000cb");
+  ASSERT_EQUALS(env.fd->numCalls(),1);
+  FuncCallSpecs *fc = env.fd->getCallSpecs(0);
+  fc->setInternal(env.arch->getModel("__stdcall16far"),env.arch->types->getTypeVoid());
+  ASSERT_EQUALS(fc->getExtraPop(),ProtoModel::extrapop_unknown);
+  ActionExtraPopSetup setup("base",env.arch->getStackSpace());
+  setup.apply(*env.fd);
+  ASSERT_EQUALS(fc->getEffectiveExtraPop(),ProtoModel::extrapop_unknown);
+  PcodeOp *marker = (PcodeOp *)0;
+  for(PcodeOpTree::const_iterator iter=env.fd->beginOpAll();iter!=env.fd->endOpAll();++iter) {
+    PcodeOp *candidate = (*iter).second;
+    if (candidate->code() == CPUI_INDIRECT && candidate->getIn(1)->getSpace()->getType() == IPTR_IOP &&
+        PcodeOp::getOpFromConst(candidate->getIn(1)->getAddr()) == fc->getOp()) marker = candidate;
+  }
+  ASSERT(marker != (PcodeOp *)0);
+  ASSERT_EQUALS(marker->getOut()->getSize(),2);
+  if (lateKnown) {
+    FuncProto restriction;
+    restriction.copy(*fc);
+    restriction.setExtraPop(4);
+    vector<Varnode *> inputs,outputs;
+    ASSERT(fc->lateRestriction(restriction,inputs,outputs));
+    ASSERT(!env.fd->hasRestartPending());
+    ASSERT_EQUALS(fc->getExtraPop(),4);
+    ASSERT_EQUALS(fc->getEffectiveExtraPop(),ProtoModel::extrapop_unknown);
+  }
+  Varnode *input = env.fd->setInputVarnode(env.fd->newVarnode(2,marker->getOut()->getAddr()));
+  input->setConsume(0xff);
+  env.fd->opSetInput(marker,input,0);
+  PcodeOp *slice = env.op(CPUI_SUBPIECE,{marker->getOut(),env.constant(4,0)},env.arch->types->getBase(1,TYPE_UINT));
+  PcodeOp *use = env.op(CPUI_COPY,{slice->getOut()},env.arch->types->getBase(1,TYPE_UINT));
+  ASSERT_EQUALS(fc->hasEffectTranslate(marker->getOut()->getAddr(),1),EffectRecord::unaffected);
+  RulePullsubIndirect rule("base");
+  ASSERT_EQUALS(rule.applyOp(slice,*env.fd),1);
+  Varnode *result = use->getIn(0)->getDef()->getIn(0);
+  ASSERT_EQUALS(result->getDef()->code(),CPUI_INDIRECT);
+  ASSERT_EQUALS(PcodeOp::getOpFromConst(result->getDef()->getIn(1)->getAddr()),fc->getOp());
+  ActionStackPtrFlow flow("base",env.arch->getStackSpace());
+  flow.reset(*env.fd);
+  flow.apply(*env.fd);
+  ASSERT_EQUALS(marker->code(),lateKnown ? CPUI_INT_ADD : CPUI_INDIRECT);
+  ASSERT_EQUALS(fc->getEffectiveExtraPop(),lateKnown ? 4 : ProtoModel::extrapop_unknown);
+  if (lateKnown) {
+    ASSERT_EQUALS(marker->getIn(0),input);
+    ASSERT_EQUALS(marker->getIn(1)->getOffset(),4);
+  }
+}
+
+TEST(segmented_projected_unknown_cleanup_marker) {
+  checkProjectedCleanupMarker(false);
+}
+
+TEST(segmented_projected_late_known_cleanup_marker) {
+  checkProjectedCleanupMarker(true);
+}
