+// Full captured caller: equality is checked on SSA values, not merged high variables or printed C.
+static void checkCapturedFarCallerStackEffect(bool supplied) {
+  WideEnvironment environment("669c6660668bf46633c08cc866a3ee028cd066a3f202b8280066a312038bc466a3f6029affff00006633c08cc866a30a038bc466a30e0366c706e60202000000668be66661669dcb",0x300000000ULL,"x86:LE:16:Protected Mode:default",true);
+  Architecture *arch = environment.arch;
+  AddrSpace *ram = arch->getDefaultCodeSpace();
+  Funcdata *fd = arch->symboltab->getGlobalScope()->addFunction(Address(ram,0x300000000ULL),"far_measure")->getFunction();
+  if (supplied) {
+    FuncProto *prototype = new FuncProto();
+    prototype->setInternal(arch->getModel("__cdecl16far"),arch->types->getTypeVoid());
+    prototype->setInputLock(true);
+    prototype->setOutputLock(true);
+    prototype->setModelLock(true);
+    fd->getOverride().insertProtoOverride(Address(ram,0x300000023ULL),prototype);
+  }
+  arch->allacts.getCurrent()->reset(*fd);
+  ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
+  ASSERT_EQUALS(fd->numCalls(),1);
+  FuncCallSpecs *fc = fd->getCallSpecs(0);
+  ASSERT_EQUALS(fc->getOp()->code(),CPUI_CALLIND);
+  ASSERT_EQUALS(fc->isOverride(),supplied);
+  ASSERT_EQUALS(fc->getModelName(),supplied ? "__cdecl16far" : "__stdcall16near");
+  ASSERT_EQUALS(fc->getExtraPop(),supplied ? 4 : ProtoModel::extrapop_unknown);
+  ASSERT_EQUALS(fc->getEffectiveExtraPop(),supplied ? 4 : ProtoModel::extrapop_unknown);
+  Varnode *before = (Varnode *)0;
+  Varnode *after = (Varnode *)0;
+  Varnode *epilogue = (Varnode *)0;
+  Varnode *callEntry = (Varnode *)0;
+  for(PcodeOpTree::const_iterator iter=fd->beginOpAll();iter!=fd->endOpAll();++iter) {
+    PcodeOp *op = (*iter).second;
+    if (op->isDead()) continue;
+    if (op->code() == CPUI_STORE && op->getAddr() == Address(ram,0x30000001fULL)) before = op->getIn(2);
+    if (op->code() == CPUI_STORE && op->getAddr() == Address(ram,0x300000033ULL)) after = op->getIn(2);
+    if (op->code() == CPUI_SEGMENTOP && op->getAddr() == Address(ram,0x300000043ULL)) epilogue = op->getIn(2);
+    if (op->code() == CPUI_STORE && op->getAddr() == Address(ram,0x300000023ULL) &&
+        op->getIn(2)->isConstant() && op->getIn(2)->getSize() == 2 && op->getIn(2)->getOffset() == 0x28) {
+      ASSERT_EQUALS(op->getIn(1)->getDef()->code(),CPUI_SEGMENTOP);
+      callEntry = op->getIn(1)->getDef()->getIn(2);
+    }
+  }
+  ASSERT(before != (Varnode *)0);
+  ASSERT(after != (Varnode *)0);
+  ASSERT_EQUALS(before->getDef()->code(),CPUI_INT_ZEXT);
+  ASSERT_EQUALS(after->getDef()->code(),CPUI_INT_ZEXT);
+  Varnode *root = (Varnode *)0;
+  auto checkOffset = [&root](Varnode *value,uintb expected) {
+    ASSERT_EQUALS(value->getSize(),2);
+    ASSERT(value->isWritten());
+    PcodeOp *op = value->getDef();
+    if (op->code() == CPUI_CAST) {
+      value = op->getIn(0);
+      ASSERT_EQUALS(value->getSize(),2);
+      ASSERT(value->isWritten());
+      op = value->getDef();
+    }
+    ASSERT(op->code() == CPUI_INT_ADD || op->code() == CPUI_INT_SUB);
+    ASSERT_EQUALS(op->getIn(0)->getSize(),2);
+    ASSERT(op->getIn(1)->isConstant());
+    uintb offset = op->getIn(1)->getOffset();
+    if (op->code() == CPUI_INT_SUB) offset = -offset;
+    ASSERT_EQUALS(offset & 0xffff,expected);
+    if (root == (Varnode *)0) root = op->getIn(0);
+    else ASSERT_EQUALS(op->getIn(0),root);
+  };
+  checkOffset(before->getDef()->getIn(0),0xffdc);
+  ASSERT(callEntry != (Varnode *)0);
+  checkOffset(callEntry,0xffd8);
+  if (supplied) {
+    checkOffset(after->getDef()->getIn(0),0xffdc);
+  }
+  else {
+    Varnode *value = after->getDef()->getIn(0);
+    ASSERT_EQUALS(value->getSize(),2);
+    ASSERT(value->isWritten());
+    PcodeOp *guard = value->getDef();
+    if (guard->code() == CPUI_CAST) {
+      value = guard->getIn(0);
+      ASSERT_EQUALS(value->getSize(),2);
+      ASSERT(value->isWritten());
+      guard = value->getDef();
+    }
+    ASSERT_EQUALS(guard->code(),CPUI_INDIRECT);
+    ASSERT(!guard->isIndirectCreation());
+    ASSERT_EQUALS(guard->getIn(1)->getSpace()->getType(),IPTR_IOP);
+    ASSERT_EQUALS(PcodeOp::getOpFromConst(guard->getIn(1)->getAddr()),fc->getOp());
+    checkOffset(guard->getIn(0),0xffd8);
+  }
+  ASSERT(root->isWritten());
+  ASSERT_EQUALS(root->getDef()->code(),CPUI_SUBPIECE);
+  ASSERT(root->getDef()->getIn(0)->isInput());
+  ASSERT_EQUALS(root->getDef()->getIn(0)->getSize(),4);
+  ASSERT_EQUALS(root->getDef()->getIn(1)->getOffset(),0);
+  VarnodeData esp = arch->translate->getRegister("ESP");
+  ASSERT_EQUALS(root->getDef()->getIn(0)->getAddr(),Address(esp.space,esp.offset));
+  ASSERT_EQUALS(root->getDef()->getIn(0),fd->findCoveringInput(2,root->getAddr()));
+  ASSERT(epilogue != (Varnode *)0);
+  checkOffset(epilogue,0xfff8);
+}
