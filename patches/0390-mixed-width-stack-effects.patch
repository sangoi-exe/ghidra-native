+  PcodeOp *second = narrow->getIn(0)->getDef();
+  ASSERT_EQUALS(second->code(),CPUI_INDIRECT);
+  ASSERT_EQUALS(second->getOut()->getSize(),1);
+  ASSERT(second->noIndirectCollapse());
+  ASSERT_EQUALS(PcodeOp::getOpFromConst(second->getIn(1)->getAddr()),fc->getOp());
+}
