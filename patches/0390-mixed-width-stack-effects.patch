+TEST(segmented_stack_solved_output_unknown_companion) {
+  for(bool stackCompanion : {true,false}) {
+    SegmentedEnvironment env(true,"x86:LE:16:Protected Mode:default","e81000e81000cb");
+    ASSERT_EQUALS(env.fd->numCalls(),2);
+    FuncCallSpecs *first = env.fd->getCallSpecs(0);
+    FuncCallSpecs *second = env.fd->getCallSpecs(1);
+    first->setInternal(env.arch->getModel("__stdcall16near"),env.arch->types->getTypeVoid());
+    second->setInternal(env.arch->getModel("__stdcall16near"),env.arch->types->getTypeVoid());
+    const VarnodeData &sp(env.arch->getStackSpace()->getSpacebase(0));
+    Address address(sp.space,sp.offset);
+    Varnode *root = env.fd->setInputVarnode(env.fd->newVarnode(sp.size,address));
+    PcodeOp *unknown = env.op(CPUI_INDIRECT,{root,env.fd->newVarnodeIop(first->getOp())});
+    if (stackCompanion) env.fd->newVarnodeOut(sp.size,address,unknown);
+    else env.fd->newUniqueOut(sp.size,unknown);
+    PcodeOp *solved = env.op(CPUI_INDIRECT,{unknown->getOut(),env.fd->newVarnodeIop(second->getOp())});
+    env.fd->newVarnodeOut(sp.size,address,solved);
+    PcodeOp *merge = env.op(CPUI_MULTIEQUAL,{root,solved->getOut()});
+    env.fd->newVarnodeOut(sp.size,address,merge);
+    ActionStackPtrFlow flow("base",env.arch->getStackSpace());
+    flow.reset(*env.fd);
+    flow.apply(*env.fd);
+    ASSERT_EQUALS(unknown->code(),CPUI_INDIRECT);
+    ASSERT_EQUALS(first->getExtraPop(),ProtoModel::extrapop_unknown);
+    ASSERT_EQUALS(second->getExtraPop(),ProtoModel::extrapop_unknown);
+    ASSERT_EQUALS(first->getEffectiveExtraPop(),ProtoModel::extrapop_unknown);
+    ASSERT_EQUALS(second->getEffectiveExtraPop(),ProtoModel::extrapop_unknown);
+    for(PcodeOp *op : {solved,merge}) {
+      ASSERT_EQUALS(op->code(),CPUI_INT_ADD);
+      ASSERT_EQUALS(op->getIn(0),root);
+      ASSERT(op->getIn(1)->isConstant());
+      ASSERT_EQUALS(op->getIn(1)->getOffset(),0);
+    }
+  }
+}
