+  env.fd->opHeritage();
+  Datatype *word = env.arch->types->getBase(2,TYPE_UINT);
+  Datatype *byte = env.arch->types->getBase(1,TYPE_UINT);
+  Address address = env.arch->translate->getRegister("ESI").getAddr();
+  Varnode *input = env.fd->setInputVarnode(env.fd->newVarnode(4,address));
+  Varnode *base = env.op(CPUI_COPY,{input},env.arch->types->getBase(4,TYPE_UINT))->getOut();
+  base->setConsume(0xffff);
+  Varnode *existing = env.op(CPUI_SUBPIECE,{base,env.constant(4,0)},word)->getOut();
+  existing->setConsume(0xff);
+  ASSERT_EQUALS(RulePullsubMulti::findSubpiece(base,2,0),existing);
+  PcodeOp *guard = env.op(CPUI_INDIRECT,{base,env.fd->newVarnodeIop(fc->getOp())});
+  env.fd->newVarnodeOut(4,address,guard);
+  guard->setNoIndirectCollapse();
+  PcodeOp *copy = env.op(CPUI_SUBPIECE,{guard->getOut(),env.constant(4,0)},word);
+  PcodeOp *narrow = env.op(CPUI_SUBPIECE,{copy->getOut(),env.constant(4,0)},byte);
+  env.op(CPUI_COPY,{narrow->getOut()},byte);
+  RulePullsubIndirect rule("base");
+  ASSERT_EQUALS(rule.applyOp(copy,*env.fd),1);
+  ASSERT_EQUALS(copy->code(),CPUI_COPY);
+  PcodeOp *first = copy->getIn(0)->getDef();
+  ASSERT_EQUALS(first->code(),CPUI_INDIRECT);
+  ASSERT_EQUALS(first->getIn(0),existing);
+  ASSERT(first->noIndirectCollapse());
