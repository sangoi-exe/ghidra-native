+// These exact local fixture facts retain the source-qualified call/body contract, not Windows loader behavior.
+class TasmCurrentImage : public LoadImageXml {
+  bool callPreserved;
+public:
+  TasmCurrentImage(const Element *image,bool preserved) : LoadImageXml("tasm-current",image),callPreserved(preserved) {}
+  virtual bool getInstructionField(const InstructionField &field) const {
+    if (field.bigEndian || field.bitOffset != 0 || field.bitSize != 16 || field.size != 2) return false;
+    uintb source = field.source.getOffset();
+    return source == 0x10000000f696ULL || source == 0x10000000f698ULL ||
+        source == 0x10000000f6b1ULL || source == 0x10000000f6b3ULL;
+  }
+  virtual bool getInitialReference(const Address &storage,int4 size,InitialReferenceUse use,Address &target) const {
+    if (size != 4 || use != complete_pointer_reference ||
+        (storage.getOffset() != 0x10000000f696ULL && storage.getOffset() != 0x10000000f6b1ULL))
+      return false;
+    target = Address(storage.getSpace(),0x0f900000074bULL);
+    return true;
+  }
+  virtual bool isCallPreservedStorage(const Address &storage,int4 size) const {
+    if (!callPreserved || storage.getSpace()->getName() != "ram") return false;
+    uintb source = storage.getOffset();
+    return (size == 2 && (source == 0x10000000f696ULL || source == 0x10000000f698ULL ||
+        source == 0x10000000f6b1ULL || source == 0x10000000f6b3ULL)) ||
+        (size == 4 && (source == 0x10000000f696ULL || source == 0x10000000f6b1ULL));
+  }
+  virtual void getReadonly(RangeList &list) const {
+    LoadImageXml::getReadonly(list);
+    AddrSpace *ram = list.getFirstRange()->getSpace();
+    list.removeRange(ram,0x10000000f696ULL,0x10000000f699ULL);
+    list.removeRange(ram,0x10000000f6b1ULL,0x10000000f6b4ULL);
+  }
+};
