+  MemoryPageOverlay memory(ram,8,4096,&image);
+  MemoryPageOverlay registers(arch->getSpaceByName("register"),8,4096,(MemoryBank *)0);
+  MemoryPageOverlay unique(arch->getUniqueSpace(),8,4096,(MemoryBank *)0);
+  MemoryState state(const_cast<Translate *>(arch->translate));
+  state.setMemoryBank(&memory);
+  state.setMemoryBank(&registers);
+  state.setMemoryBank(&unique);
+  BreakTableCallBack breaks(const_cast<Translate *>(arch->translate));
+  WitnessEmulator emulator(arch,&state,&breaks,{{0x1567,1},{0x155f,2}});
+  state.setValue("CS",0x1567);
+  state.setValue("DS",0x155f);
+  state.setValue(ram,0x100000a15ULL,2,0xb37a);
