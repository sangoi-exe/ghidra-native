+  Scope *global = arch->symboltab->getGlobalScope();
+  global->addFunction(Address(arch->getDefaultCodeSpace(),protectedCoordinate(0x2345,0x5678)),"far_target");
+  Funcdata *consumer = global->addFunction(Address(arch->getDefaultCodeSpace(),protectedCoordinate(0x3456,0x2000)),"consume_callback")->getFunction();
+  PrototypePieces input;
+  input.model = arch->getModel("__cdecl16far");
+  input.outtype = arch->types->getTypeVoid();
+  input.intypes = {pointer};
+  input.innames = {"callback"};
+  input.firstVarArgSlot = -1;
+  consumer->getFuncProto().setPieces(input);
+  Funcdata *fd = global->addFunction(Address(arch->getDefaultCodeSpace(),protectedCoordinate(0x1234,0x1000)),"pass_callback")->getFunction();
+  PrototypePieces caller;
+  caller.model = arch->getModel("__cdecl16far");
+  caller.outtype = arch->types->getTypeVoid();
+  caller.firstVarArgSlot = -1;
+  fd->getFuncProto().setPieces(caller);
+  arch->allacts.getCurrent()->reset(*fd);
+  ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
+  ASSERT_EQUALS(fd->numCalls(),1);
+  PcodeOp *call = fd->getCallSpecs(0)->getOp();
+  ASSERT_EQUALS(call->numInput(),2);
+  ASSERT_EQUALS(call->getIn(1)->getSize(),4);
+  ASSERT(call->getIn(1)->isConstant());
+  ASSERT_EQUALS(call->getIn(1)->getOffset(),0x23455678);
+  ostringstream text;
+  arch->print->setOutputStream(&text);
+  arch->print->docFunction(fd);
+  arch->print->setOutputStream((ostream *)0);
+  ASSERT(text.str().find("consume_callback(far_target)") != string::npos);
+}
