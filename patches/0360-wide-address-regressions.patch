+// Register values and payload were measured on Windows 3.11 Enhanced Mode under KVM with SS D/B clear.
+static void checkProtectedLeave(const string &bytes,uintb expectedEsp,uintb expectedEbp) {
+  WideEnvironment environment(bytes+"90",protectedCoordinate(1,0x1000));
+  Architecture *arch = environment.arch;
+  AddrSpace *ram = arch->getDefaultDataSpace();
+  MemoryImage image(ram,8,4096,arch->loader);
+  MemoryPageOverlay memory(ram,8,4096,&image);
+  MemoryPageOverlay registers(arch->getSpaceByName("register"),8,4096,(MemoryBank *)0);
+  MemoryPageOverlay unique(arch->getUniqueSpace(),8,4096,(MemoryBank *)0);
+  MemoryState state(const_cast<Translate *>(arch->translate));
+  state.setMemoryBank(&memory);
+  state.setMemoryBank(&registers);
+  state.setMemoryBank(&unique);
+  BreakTableCallBack breaks(const_cast<Translate *>(arch->translate));
+  WitnessEmulator emulator(arch,&state,&breaks,{{0x1567,1},{0x155f,2}});
+  state.setValue("CS",0x1567);
+  state.setValue("DS",0x155f);
+  state.setValue("SS",0x155f);
+  state.setValue("ESP",0x8001177c);
+  state.setValue("EBP",0xda5b178c);
+  // INSTR.EXE has stack/data ordinal2; the captured runtime SS is155f. This is explicit witness normalization.
+  uintb cell = protectedCoordinate(2,0x178c);
+  state.setValue(ram,cell,4,0xa1b2c3d4);
+  Address entry(ram,protectedCoordinate(1,0x1000));
+  emulator.setExecuteAddress(entry);
+  emulator.setHalt(false);
+  int4 steps = 0;
+  while (emulator.getExecuteAddress() == entry && steps++ < 100)
+    emulator.executeCurrentOp();
+  ASSERT_EQUALS(emulator.getExecuteAddress(),entry+bytes.size()/2);
+  uintb esp = state.getValue("ESP");
+  uintb ebp = state.getValue("EBP");
+  if (esp != expectedEsp || ebp != expectedEbp) {
+    ostringstream error;
+    error << hex << "LEAVE " << bytes << ": ESP=0x" << esp << ", EBP=0x" << ebp;
+    error << "; measured ESP=0x" << expectedEsp << ", EBP=0x" << expectedEbp;
+    throw LowlevelError(error.str());
+  }
+  ASSERT_EQUALS(emulator.reads.size(),1);
+  ASSERT_EQUALS(emulator.reads[0],Address(ram,cell));
+  ASSERT_EQUALS(state.getValue("CS"),0x1567);
+  ASSERT_EQUALS(state.getValue("DS"),0x155f);
+  ASSERT_EQUALS(state.getValue("SS"),0x155f);
+}
