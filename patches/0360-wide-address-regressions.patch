+TEST(protected_wide_pointer_constants) {
+  WideEnvironment environment("cb");
+  Architecture *arch = environment.arch;
+  AddrSpace *ram = arch->getDefaultDataSpace();
+  Address entry(ram,protectedCoordinate(0x1234,0x1000));
+  TrackedContext ds;
+  ds.loc = arch->translate->getRegister("DS");
+  ds.val = 0x4567;
+  arch->context->createSet(entry,entry+1).push_back(ds);
+  uintb encoding;
+  ASSERT_EQUALS(arch->resolveConstant(ram,0x5678,2,entry,encoding),Address(ram,protectedCoordinate(0x4567,0x5678)));
+  ASSERT_EQUALS(encoding,0x45675678);
+  ASSERT_EQUALS(arch->resolveConstant(ram,0x23455678,4,entry,encoding),Address(ram,protectedCoordinate(0x2345,0x5678)));
+  ASSERT_EQUALS(encoding,0x23455678);
+  uintb coordinate = protectedCoordinate(0x2345,0x12345678);
+  ASSERT_EQUALS(arch->resolveConstant(ram,coordinate,6,entry,encoding),Address(ram,coordinate));
+  ASSERT_EQUALS(encoding,coordinate);
+  Datatype *word = arch->types->getBase(2,TYPE_UINT);
+  arch->symboltab->getGlobalScope()->addSymbol("wide_global",word,Address(ram,coordinate),Address());
+  TypeSpacebase *spacebase = arch->types->getTypeSpacebase(ram,Address());
+  ASSERT_EQUALS(spacebase->getAddress(coordinate,6,entry),Address(ram,coordinate));
+  int8 remainder;
+  ASSERT_EQUALS(spacebase->getSubType(coordinate,&remainder),word);
+  ASSERT_EQUALS(remainder,0);
+
+  uintb raw = 0x23455678;
+  arch->symboltab->getGlobalScope()->addSymbol("far_global",word,Address(ram,protectedCoordinate(0x2345,0x5678)),Address());
+  Funcdata *fd = arch->symboltab->getGlobalScope()->addFunction(entry,"constant_pointer")->getFunction();
+  fd->setHighLevel();
+  fd->startTypeRecovery();
+  BlockBasic block(fd);
+  TypePointer *farPointer = arch->types->getTypePointer(4,word,1);
+  Varnode *constant = fd->newConstant(4,raw);
+  constant->updateType(farPointer,true,true);
+  PcodeOp *copy = fd->newOp(1,entry);
+  fd->opSetOpcode(copy,CPUI_COPY);
+  fd->opSetInput(copy,constant,0);
+  fd->newUniqueOut(4,copy)->updateType(farPointer,true,true);
+  fd->opInsertEnd(copy,&block);
+  ActionConstantPtr action("base");
+  action.reset(*fd);
+  action.apply(*fd);
+  ASSERT_EQUALS(copy->code(),CPUI_COPY);
+  ASSERT_EQUALS(copy->getIn(0)->getOffset(),raw);
+  ASSERT_EQUALS(copy->getIn(0)->getSize(),4);
+}
