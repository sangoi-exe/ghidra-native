+class WideEnvironment {
+public:
+  Architecture *arch;
+  WideEnvironment(const string &bytes,uintb entry = protectedCoordinate(0x1234,0x1000),const string &language = "x86:LE:16:Protected Mode:default",bool farWitness = false) {
+    startDecompilerLibrary(getenv("SLEIGHHOME"));
+    ostringstream xml;
+    xml << "<binaryimage arch=\"" << language << "\"><bytechunk space=\"ram\" offset=\"0x" << hex << entry;
+    xml << "\" readonly=\"true\">" << bytes << "</bytechunk></binaryimage>";
+    istringstream input(xml.str());
+    DocumentStorage store;
+    Document *document = store.parseDocument(input);
+    store.registerTag(document->getRoot());
+    arch = farWitness ? new FarWitnessArchitecture() : ArchitectureCapability::getCapability("xml")->buildArchitecture("","",&cout);
+    arch->init(store);
+  }
+  ~WideEnvironment(void) { delete arch; }
+};
