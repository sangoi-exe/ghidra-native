+// SELCHAIN measured CS1567, DS155f ->1567, unchanged RPL/ZF0 and equal CS/DS reads of b37a at code1:0a15.
+TEST(protected_wide_captured_selector_chain) {
+  string bytes = "2ea1150a8cc8b9030063c88ed8a1150a90";
+  WideEnvironment environment(bytes,0x100001000ULL);
