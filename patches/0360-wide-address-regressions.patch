+static uintb protectedCoordinate(uintb selector,uintb offset) {
+  return (selector << 32) | offset;
+}
+
+class FarWitnessImage : public LoadImageXml {
+public:
+  FarWitnessImage(const Element *image) : LoadImageXml("far-witness",image) {}
+  virtual bool getInstructionField(const InstructionField &field) const {
+    if (field.bigEndian || field.bitOffset != 0 || field.bitSize != field.size*8) return false;
+    return field.size == 2 && (field.source.getOffset() == 0x300000024ULL || field.source.getOffset() == 0x300000026ULL);
+  }
+};
+
+class FarWitnessArchitecture : public XmlArchitecture {
+  virtual void buildLoader(DocumentStorage &store) {
+    collectSpecFiles(*errorstream);
+    loader = new FarWitnessImage(store.getTag("binaryimage"));
+  }
+public:
+  FarWitnessArchitecture(void) : XmlArchitecture("","",&cout) {}
+};
