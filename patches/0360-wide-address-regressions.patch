+TEST(protected_wide_direct_far_call_and_return) {
+  for(bool returning : {false,true}) {
+    WideEnvironment environment(returning ? "66cb" : "66679a785634124523");
+    Architecture *arch = environment.arch;
+    AddrSpace *ram = arch->getDefaultDataSpace();
+    MemoryImage image(ram,8,4096,arch->loader);
+    MemoryPageOverlay memory(ram,8,4096,&image);
+    MemoryPageOverlay registers(arch->getSpaceByName("register"),8,4096,(MemoryBank *)0);
+    MemoryPageOverlay unique(arch->getUniqueSpace(),8,4096,(MemoryBank *)0);
+    MemoryState state(const_cast<Translate *>(arch->translate));
+    state.setMemoryBank(&memory);
+    state.setMemoryBank(&registers);
+    state.setMemoryBank(&unique);
+    BreakTableCallBack breaks(const_cast<Translate *>(arch->translate));
+    WideEmulator emulator(arch,&state,&breaks);
+    state.setValue("CS",0x1234);
+    state.setValue("SS",0x6789);
+    state.setValue("ESP",0xabcd0004);
+    if (returning) {
+      state.setValue(ram,protectedCoordinate(0x6789,4),4,0x12345678);
+      state.setValue(ram,protectedCoordinate(0x6789,8),2,0x2345);
+    }
+    emulator.setExecuteAddress(Address(ram,protectedCoordinate(0x1234,0x1000)));
+    emulator.setHalt(false);
+    int4 steps = 0;
+    while (!emulator.getHalt() && steps++ < 100)
+      emulator.executeCurrentOp();
+    ASSERT(emulator.getHalt());
+    ASSERT_EQUALS(emulator.transfer,returning ? CPUI_RETURN : CPUI_CALL);
+    ASSERT_EQUALS(emulator.target,Address(ram,protectedCoordinate(0x2345,0x12345678)));
+    ASSERT_EQUALS(state.getValue("CS"),0x2345);
+    ASSERT_EQUALS(state.getValue("ESP"),returning ? 0xabcd000c : 0xabcdfffc);
+    if (!returning) {
+      ASSERT_EQUALS(state.getValue(ram,protectedCoordinate(0x6789,0xfffc),4),0x1009);
+      ASSERT_EQUALS(state.getValue(ram,protectedCoordinate(0x6789,0),2),0x1234);
+    }
+  }
+}
