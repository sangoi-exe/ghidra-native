+// Frozen FARRET: caller1557/file3, callee154f/file4, SS1547/file5; continuation0028 and SP1754 ->1750 ->1754.
+TEST(protected_wide_captured_far_transfer_and_return) {
+  for(bool returning : {false,true}) {
+    WideEnvironment environment(returning ? "cb" : "9a00004f15",returning ? 0x400000000ULL : 0x300000023ULL,"x86:LE:16:Protected Mode:default",!returning);
+    Architecture *arch = environment.arch;
+    AddrSpace *ram = arch->getDefaultDataSpace();
+    MemoryImage image(ram,8,4096,arch->loader);
+    MemoryPageOverlay memory(ram,8,4096,&image);
+    MemoryPageOverlay registers(arch->getSpaceByName("register"),8,4096,(MemoryBank *)0);
+    MemoryPageOverlay unique(arch->getUniqueSpace(),8,4096,(MemoryBank *)0);
+    MemoryState state(const_cast<Translate *>(arch->translate));
+    state.setMemoryBank(&memory);
+    state.setMemoryBank(&registers);
+    state.setMemoryBank(&unique);
+    BreakTableCallBack breaks(const_cast<Translate *>(arch->translate));
+    WitnessEmulator emulator(arch,&state,&breaks,{{0x1557,3},{0x154f,4},{0x1547,5}});
+    state.setValue("CS",returning ? 0x154f : 0x1557);
+    state.setValue("SS",0x1547);
+    state.setValue("SP",returning ? 0x1750 : 0x1754);
+    if (!returning) {
+      // Witness comparison inputs, not independently dumped loader bytes.
+      state.setValue(ram,0x300000024ULL,2,0);
+      state.setValue(ram,0x300000026ULL,2,0x154f);
+    }
+    if (returning) {
+      state.setValue(ram,0x500001750ULL,2,0x28);
+      state.setValue(ram,0x500001752ULL,2,0x1557);
+    }
+    emulator.setExecuteAddress(Address(ram,returning ? 0x400000000ULL : 0x300000023ULL));
+    emulator.setHalt(false);
+    int4 steps = 0;
+    while (!emulator.getHalt() && steps++ < 100) emulator.executeCurrentOp();
+    ASSERT(emulator.getHalt());
+    ASSERT_EQUALS(emulator.transfer,returning ? CPUI_RETURN : CPUI_CALLIND);
+    ASSERT_EQUALS(emulator.target,Address(ram,returning ? 0x300000028ULL : 0x400000000ULL));
+    ASSERT_EQUALS(state.getValue("CS"),returning ? 0x1557 : 0x154f);
+    ASSERT_EQUALS(state.getValue("SP"),returning ? 0x1754 : 0x1750);
+    ASSERT_EQUALS(state.getValue(ram,0x500001750ULL,2),0x28);
+    ASSERT_EQUALS(state.getValue(ram,0x500001752ULL,2),0x1557);
+  }
+}
