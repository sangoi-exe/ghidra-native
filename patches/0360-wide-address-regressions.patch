+// Only captured cases use this adapter, with an explicit independently observed selector-to-file-segment mapping.
+class WitnessEmulator : public EmulatePcodeCache {
+  Architecture *arch;
+  bool started;
+  map<uintb,uintb> observedSegments;
+  void executeSegment(SegmentOp *segment,int4 first) {
+    vector<uintb> inputs;
+    inputs.push_back(memstate->getValue(currentOp->getInput(first)));
+    inputs.push_back(memstate->getValue(currentOp->getInput(first+1)));
+    auto found = observedSegments.find(inputs[0]);
+    if (found == observedSegments.end())
+      throw LowlevelError("No captured selector mapping for witness execution");
+    Address base(segment->getSpace(),protectedCoordinate(found->second,0));
+    memstate->setValue(currentOp->getOutput(),segment->composeReference(base,inputs[1]).getOffset());
+  }
+protected:
+  virtual void executeCallother(void) {
+    SegmentOp *segment = arch->getSegmentOp(arch->getDefaultDataSpace());
+    ASSERT(segment != (SegmentOp *)0);
+    ASSERT_EQUALS(currentOp->getInput(0)->offset,segment->getIndex());
+    executeSegment(segment,1);
+    fallthruOp();
+  }
+  virtual void executeSegmentOp(void) {
+    executeSegment(arch->getSegmentOp(currentOp->getInput(0)->getSpaceFromConst()),1);
+  }
+public:
+  Address target;
+  OpCode transfer;
+  vector<Address> reads;
+  WitnessEmulator(Architecture *g,MemoryState *state,BreakTable *breaks,const map<uintb,uintb> &observed)
+    : EmulatePcodeCache(const_cast<Translate *>(g->translate),state,breaks),arch(g),started(false),observedSegments(observed),transfer(CPUI_MAX) {}
+  virtual void setExecuteAddress(const Address &address) {
+    if (!started) {
+      EmulatePcodeCache::setExecuteAddress(address);
+      started = true;
+      return;
+    }
+    target = address;
+    transfer = currentOp->getOpcode();
+    setHalt(true);
+  }
+protected:
+  virtual void executeLoad(void) {
+    reads.push_back(Address(currentOp->getInput(0)->getSpaceFromConst(),memstate->getValue(currentOp->getInput(1))));
+    EmulateMemory::executeLoad();
+  }
+};
+
+struct WidePcode {
+  OpCode opcode;
+  VarnodeData output;
+  bool hasOutput;
+  vector<VarnodeData> inputs;
+};
+
+class WidePcodeEmit : public PcodeEmit {
+public:
+  vector<WidePcode> ops;
+  virtual void dump(const Address &address,OpCode opcode,VarnodeData *out,VarnodeData *inputs,int4 size) {
+    WidePcode op = {};
+    op.opcode = opcode;
+    op.hasOutput = out != (VarnodeData *)0;
+    if (op.hasOutput) op.output = *out;
+    op.inputs.assign(inputs,inputs+size);
+    ops.push_back(op);
+  }
+};
