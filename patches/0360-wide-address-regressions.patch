+static uintb protectedCoordinate(uintb selector,uintb offset) {
+  return (selector << 32) | offset;
+}
+
+class WideEnvironment {
+public:
+  Architecture *arch;
+  WideEnvironment(const string &bytes,uintb entry = protectedCoordinate(0x1234,0x1000)) {
+    startDecompilerLibrary(getenv("SLEIGHHOME"));
+    ostringstream xml;
+    xml << "<binaryimage arch=\"x86:LE:16:Protected Mode:default\"><bytechunk space=\"ram\" offset=\"0x" << hex << entry;
+    xml << "\" readonly=\"true\">" << bytes << "</bytechunk></binaryimage>";
+    istringstream input(xml.str());
+    DocumentStorage store;
+    Document *document = store.parseDocument(input);
+    store.registerTag(document->getRoot());
+    arch = ArchitectureCapability::getCapability("xml")->buildArchitecture("","",&cout);
+    arch->init(store);
+  }
+  ~WideEnvironment(void) { delete arch; }
+};
+
+// The generic emulator lacks segment userops and eagerly decodes callees. Delegate the former to the real architecture and stop at the actual transfer.
+class WideEmulator : public EmulatePcodeCache {
+  Architecture *arch;
+  bool started;
+  void executeSegment(SegmentOp *segment,int4 first) {
+    vector<uintb> inputs;
+    inputs.push_back(memstate->getValue(currentOp->getInput(first)));
+    inputs.push_back(memstate->getValue(currentOp->getInput(first+1)));
+    memstate->setValue(currentOp->getOutput(),segment->execute(inputs));
+  }
+protected:
+  virtual void executeCallother(void) {
+    SegmentOp *segment = arch->getSegmentOp(arch->getDefaultDataSpace());
+    ASSERT(segment != (SegmentOp *)0);
+    ASSERT_EQUALS(currentOp->getInput(0)->offset,segment->getIndex());
+    executeSegment(segment,1);
+    fallthruOp();
+  }
+  virtual void executeSegmentOp(void) {
+    executeSegment(arch->getSegmentOp(currentOp->getInput(0)->getSpaceFromConst()),1);
+  }
+public:
+  Address target;
+  OpCode transfer;
+  vector<Address> reads;
+  WideEmulator(Architecture *g,MemoryState *state,BreakTable *breaks)
+    : EmulatePcodeCache(const_cast<Translate *>(g->translate),state,breaks),arch(g),started(false),transfer(CPUI_MAX) {}
+  virtual void setExecuteAddress(const Address &address) {
+    if (!started) {
+      EmulatePcodeCache::setExecuteAddress(address);
+      started = true;
+      return;
+    }
+    target = address;
+    transfer = currentOp->getOpcode();
+    setHalt(true);
+  }
+protected:
+  virtual void executeLoad(void) {
+    reads.push_back(Address(currentOp->getInput(0)->getSpaceFromConst(),memstate->getValue(currentOp->getInput(1))));
+    EmulateMemory::executeLoad();
+  }
+};
+
+static void checkFarMemoryCall(const string &bytes,bool operand32,bool address32,uintb cellOffset,uintb ds,uintb targetOffset,uintb targetSelector,bool stackAddress = false) {
+  WideEnvironment environment(bytes);
+  Architecture *arch = environment.arch;
+  AddrSpace *ram = arch->getDefaultDataSpace();
+  MemoryImage image(ram,8,4096,arch->loader);
+  MemoryPageOverlay memory(ram,8,4096,&image);
+  MemoryPageOverlay registers(arch->getSpaceByName("register"),8,4096,(MemoryBank *)0);
+  MemoryPageOverlay unique(arch->getUniqueSpace(),8,4096,(MemoryBank *)0);
+  MemoryState state(const_cast<Translate *>(arch->translate));
+  state.setMemoryBank(&memory);
+  state.setMemoryBank(&registers);
+  state.setMemoryBank(&unique);
+  BreakTableCallBack breaks(const_cast<Translate *>(arch->translate));
+  WideEmulator emulator(arch,&state,&breaks);
+  state.setValue("CS",0x1234);
+  state.setValue("DS",ds);
+  state.setValue("SS",0x6789);
+  state.setValue("ESP",0xabcd0004);
+  state.setValue("EAX",cellOffset);
+  state.setValue("EBP",cellOffset);
+  state.setValue("BX",cellOffset);
+  int4 offsetSize = operand32 ? 4 : 2;
+  uintb cell = protectedCoordinate(stackAddress ? 0x6789 : ds,address32 ? cellOffset : cellOffset & 0xffff);
+  state.setValue(ram,(ds << 16) | (cellOffset & 0xffff),offsetSize,0x1111);
+  state.setValue(ram,protectedCoordinate(ds,0x2000),offsetSize,0x2222);
+  state.setValue(ram,cell,offsetSize,targetOffset);
+  state.setValue(ram,cell+offsetSize,2,targetSelector);
+  uintb stack = protectedCoordinate(0x6789,0);
+  state.setValue(ram,stack,4,0xfeedface);
+  emulator.setExecuteAddress(Address(ram,protectedCoordinate(0x1234,0x1000)));
+  emulator.setHalt(false);
+  int4 steps = 0;
+  while (!emulator.getHalt() && steps++ < 100)
+    emulator.executeCurrentOp();
+  ASSERT(emulator.getHalt());
+  ASSERT_EQUALS(emulator.transfer,CPUI_CALLIND);
+  ASSERT_EQUALS(emulator.target,Address(ram,protectedCoordinate(targetSelector,targetOffset)));
+  ASSERT_EQUALS(emulator.reads.size(),2);
+  ASSERT_EQUALS(emulator.reads[0],Address(ram,cell));
+  ASSERT_EQUALS(emulator.reads[1],Address(ram,cell+offsetSize));
+  ASSERT_EQUALS(state.getValue("CS"),targetSelector);
+  ASSERT_EQUALS(state.getValue("ESP"),operand32 ? 0xabcdfffc : 0xabcd0000);
+  uintb returnAddress = protectedCoordinate(0x6789,operand32 ? 0xfffc : 0);
+  ASSERT_EQUALS(state.getValue(ram,returnAddress,offsetSize),0x1000 + bytes.size()/2);
+  ASSERT_EQUALS(state.getValue(ram,stack+(operand32 ? 0 : 2),2),0x1234);
+  ASSERT_EQUALS(state.getValue("DS"),ds);
+}
