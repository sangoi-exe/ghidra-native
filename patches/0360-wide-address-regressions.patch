+// These are local construction/width controls, not invented machine selector mappings.
+TEST(protected_wide_callf_memory_construction) {
+  for(const string &bytes : {"ff1f","67ff18","66ff1f","6667ff18","6667ff5d00","6667ff1c24","66673eff5d00"}) {
+    WideEnvironment environment(bytes);
+    Architecture *arch = environment.arch;
+    WidePcodeEmit emit;
+    arch->translate->oneInstruction(emit,Address(arch->getDefaultCodeSpace(),protectedCoordinate(0x1234,0x1000)));
+    VarnodeData cs = arch->translate->getRegister("CS");
+    VarnodeData memorySegment = arch->translate->getRegister(bytes == "6667ff5d00" || bytes == "6667ff1c24" ? "SS" : "DS");
+    int4 loads = 0;
+    int4 stores = 0;
+    int4 calls = 0;
+    int4 restores = 0;
+    bool addressing = false;
+    for(const WidePcode &op : emit.ops) {
+      if (op.opcode == CPUI_LOAD) {
+        ASSERT_EQUALS(op.output.size,loads == 0 && bytes.substr(0,2) == "66" ? 4 : 2);
+        ++loads;
+      }
+      if (op.opcode == CPUI_STORE) {
+        ASSERT_EQUALS(op.inputs[1].size,6);
+        ASSERT_EQUALS(op.inputs[2].size,stores != 0 && bytes.substr(0,2) == "66" ? 4 : 2);
+        ++stores;
+      }
+      if (op.opcode == CPUI_CALLOTHER && op.inputs[1].space == memorySegment.space && op.inputs[1].offset == memorySegment.offset)
+        addressing = true;
+      if (op.opcode == CPUI_CALLIND) {
+        ASSERT_EQUALS(op.inputs[0].size,6);
+        ++calls;
+      }
+      if (calls != 0 && op.hasOutput && op.output.space == cs.space && op.output.offset == cs.offset) {
+        ASSERT_EQUALS(op.opcode,CPUI_COPY);
+        ASSERT_EQUALS(op.inputs[0].space,arch->getUniqueSpace());
+        ++restores;
+      }
+    }
+    ASSERT_EQUALS(loads,2);
+    ASSERT_EQUALS(stores,2);
+    ASSERT_EQUALS(calls,1);
+    ASSERT_EQUALS(restores,1);
+    ASSERT(addressing);
+  }
+}
