+TEST(protected_wide_offset32_is_not_far_pointer) {
+  WideEnvironment environment("558bec6667ff185dcb");
+  Architecture *arch = environment.arch;
+  Funcdata *fd = arch->symboltab->getGlobalScope()->addFunction(Address(arch->getDefaultCodeSpace(),protectedCoordinate(0x1234,0x1000)),"wide_indirect")->getFunction();
+  arch->allacts.getCurrent()->reset(*fd);
+  ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
+  ASSERT_EQUALS(fd->numCalls(),1);
+  ASSERT_EQUALS(fd->getCallSpecs(0)->getOp()->getIn(0)->getSize(),6);
+  int4 conversions = 0;
+  for(auto iter = fd->beginOpAll();iter != fd->endOpAll();++iter) {
+    PcodeOp *op = iter->second;
+    if (op->isDead() || op->code() != CPUI_SEGMENTOP || op->getIn(2)->getSize() != 4) continue;
+    ASSERT_NOT_EQUALS(op->getIn(2)->getTypeReadFacing(op)->getMetatype(),TYPE_PTR);
+    ASSERT_EQUALS(op->getOut()->getSize(),6);
+    ++conversions;
+  }
+  ASSERT(conversions >= 2);
+}
