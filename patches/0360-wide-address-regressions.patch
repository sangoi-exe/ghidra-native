+TEST(protected_wide_typed_far_callback) {
+  WideEnvironment environment("558becff5e065dcb");
+  Architecture *arch = environment.arch;
+  Datatype *word = arch->types->getBase(2,TYPE_UINT);
+  PrototypePieces callback;
+  callback.model = arch->getModel("__stdcall16far");
+  callback.modelDeclared = true;
+  callback.outtype = word;
+  callback.firstVarArgSlot = -1;
+  TypeCode *code = arch->types->getTypeCode(callback);
+  TypePointer *pointer = arch->types->getTypePointer(4,code,1);
+  PrototypePieces caller;
+  caller.model = arch->getModel("__cdecl16far");
+  caller.outtype = word;
+  caller.intypes = {pointer};
+  caller.innames = {"callback"};
+  caller.firstVarArgSlot = -1;
+  Address entry(arch->getDefaultCodeSpace(),protectedCoordinate(0x1234,0x1000));
+  Funcdata *fd = arch->symboltab->getGlobalScope()->addFunction(entry,"invoke_callback")->getFunction();
+  fd->getFuncProto().setPieces(caller);
+  arch->allacts.getCurrent()->reset(*fd);
+  ASSERT(arch->allacts.getCurrent()->perform(*fd) >= 0);
+  ASSERT_EQUALS(fd->numCalls(),1);
+  FuncCallSpecs *call = fd->getCallSpecs(0);
+  ASSERT_EQUALS(call->getModelName(),"__stdcall16far");
+  ASSERT_EQUALS(call->getOp()->code(),CPUI_CALLIND);
+  Varnode *target = call->getOp()->getIn(0);
+  ASSERT_EQUALS(target->getSize(),6);
+  ASSERT(target->isWritten());
+  ASSERT_EQUALS(target->getDef()->code(),CPUI_SEGMENTOP);
+  ASSERT_EQUALS(target->getTypeReadFacing(call->getOp())->getMetatype(),TYPE_PTR);
+  TypePointer *coordinate = (TypePointer *)target->getTypeReadFacing(call->getOp());
+  ASSERT_EQUALS(coordinate->getPtrTo()->getMetatype(),TYPE_CODE);
+  const FuncProto *prototype = ((TypeCode *)coordinate->getPtrTo())->getPrototype();
+  ASSERT_EQUALS(prototype->getModelName(),"__stdcall16far");
+  ASSERT(prototype->isModelDeclared());
+  ASSERT_EQUALS(fd->getFuncProto().getParam(0)->getSize(),4);
+  ASSERT_EQUALS(pointer->getPtrTo(),code);
+}
