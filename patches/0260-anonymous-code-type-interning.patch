+template<typename Encode,typename Decode> static void assertNamedCodeReferences(void) {
+  SegmentedEnvironment original;
+  TypeFactory *factory = original.arch->types;
+  PrototypePieces signature;
+  signature.model = original.arch->getModel("__cdecl16near");
+  signature.outtype = factory->getBase(2,TYPE_INT);
+  signature.intypes.push_back(factory->getBase(2,TYPE_UINT));
+  signature.innames.push_back("value");
+  signature.firstVarArgSlot = -1;
+  Datatype *named = factory->setName(factory->getTypeCode(signature),"NamedCallback");
+  Datatype *alias = factory->getTypedef(factory->getTypePointer(2,named,1),"CallbackAlias",0,0);
+  ostringstream output;
+  Encode encoder(output);
+  encoder.openElement(ELEM_TYPEGRP);
+  named->encode(encoder);
+  named->encode(encoder);
+  alias->encode(encoder);
+  named->encodeRef(encoder);
+  alias->encodeRef(encoder);
+  encoder.closeElement(ELEM_TYPEGRP);
+
+  SegmentedEnvironment restored;
+  TypeFactory *restoredFactory = restored.arch->types;
+  istringstream input(output.str());
+  Decode decoder(restored.arch);
+  decoder.ingestStream(input);
+  uint4 element = decoder.openElement(ELEM_TYPEGRP);
+  Datatype *actual = restoredFactory->decodeType(decoder);
+  ASSERT_EQUALS(actual->getName(),named->getName());
+  ASSERT_EQUALS(actual->getId(),named->getId());
+  ASSERT_EQUALS(actual->isIncomplete(),false);
+  ASSERT_EQUALS(restoredFactory->decodeType(decoder),actual);
+  Datatype *actualAlias = restoredFactory->decodeType(decoder);
+  ASSERT_EQUALS(actualAlias->getName(),alias->getName());
+  ASSERT_EQUALS(actualAlias->getTypedef()->getMetatype(),TYPE_PTR);
+  ASSERT_EQUALS(((TypePointer *)actualAlias->getTypedef())->getPtrTo(),actual);
+  ASSERT_EQUALS(actualAlias->isIncomplete(),false);
+  ASSERT_EQUALS(restoredFactory->decodeType(decoder),actual);
+  ASSERT_EQUALS(restoredFactory->decodeType(decoder),actualAlias);
+  decoder.closeElement(element);
+}
+
+TEST(named_code_reference_roundtrip) {
+  assertNamedCodeReferences<XmlEncode,XmlDecode>();
+  assertNamedCodeReferences<PackedEncode,PackedDecode>();
 }

