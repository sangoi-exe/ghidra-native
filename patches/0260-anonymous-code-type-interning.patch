+template<typename Encode,typename Decode> static void assertAnonymousCodeInterning(void) {
+  SegmentedEnvironment env;
+  TypeFactory *factory = env.arch->types;
+  PrototypePieces signature;
+  signature.model = env.arch->getModel("__cdecl16near");
+  signature.outtype = factory->getBase(2,TYPE_INT);
+  signature.firstVarArgSlot = -1;
+  TypeCode *fixed = factory->getTypeCode(signature);
+  signature.firstVarArgSlot = 0;
+  TypeCode *unspecified = factory->getTypeCode(signature);
+  ASSERT(fixed != unspecified);
+  signature.firstVarArgSlot = -1;
+  signature.intypes.push_back(factory->getTypePointer(2,factory->getBase(2,TYPE_UINT),1));
+  signature.innames.push_back("value");
+  TypeCode *parameterized = factory->getTypeCode(signature);
+  Datatype *cases[] = {parameterized,factory->getTypePointer(2,parameterized,1),factory->getTypePointer(4,parameterized,1),fixed,unspecified};
+  for(Datatype *original : cases) {
+    ostringstream output;
+    Encode encoder(output);
+    original->encodeRef(encoder);
+    Datatype *decoded[2];
+    for(int4 i=0;i<2;++i) {
+      istringstream input(output.str());
+      Decode decoder(env.arch);
+      decoder.ingestStream(input);
+      decoded[i] = factory->decodeType(decoder);
+    }
+    vector<Datatype *> owned;
+    factory->dependentOrder(owned);
+    ASSERT_EQUALS(std::count(owned.begin(),owned.end(),decoded[0]),1);
+    ASSERT_EQUALS(std::count(owned.begin(),owned.end(),decoded[1]),1);
+    ASSERT_EQUALS(decoded[0],decoded[1]);
+    ASSERT_EQUALS(decoded[0],original);
+    Datatype *code = decoded[0];
+    if (code->getMetatype() == TYPE_PTR)
+      code = ((TypePointer *)code)->getPtrTo();
+    ASSERT_EQUALS(code->getMetatype(),TYPE_CODE);
+    ASSERT_EQUALS(code->isIncomplete(),false);
+    const FuncProto *prototype = ((TypeCode *)code)->getPrototype();
+    ASSERT_EQUALS(prototype->getOutputType(),signature.outtype);
+    ASSERT_EQUALS(prototype->numParams(),code == fixed || code == unspecified ? 0 : 1);
+    ASSERT_EQUALS(prototype->isDotdotdot(),code == unspecified);
+    if (prototype->numParams() == 1) {
+      ASSERT_EQUALS(prototype->getParam(0)->getType(),signature.intypes[0]);
+      ASSERT_EQUALS(prototype->getParam(0)->getName(),"value");
+    }
+  }
+}
+
+TEST(anonymous_code_xml_canonical_identity) {
+  assertAnonymousCodeInterning<XmlEncode,XmlDecode>();
+}
+
+TEST(anonymous_code_packed_canonical_identity) {
+  assertAnonymousCodeInterning<PackedEncode,PackedDecode>();
+}
