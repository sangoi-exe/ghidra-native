+#include "sleigh.hh"
+#include "test.hh"
+
+namespace ghidra {
+
+class RelocatedFieldImage : public LoadImage {
+public:
+  vector<uint1> bytes;
+  bool supplyValue;
+  bool supplyTarget;
+  bool supplyFullValue;
+  uintb valueSource;
+  int4 valueSize;
+  mutable vector<pair<InstructionField,InstructionFieldUse> > queries;
+  RelocatedFieldImage(const vector<uint1> &data)
+    : LoadImage("relocated-fields"),bytes(data),supplyValue(true),supplyTarget(true),supplyFullValue(false),
+      valueSource(0x100000916ULL),valueSize(2) {}
+  virtual void loadFill(uint1 *ptr,int4 size,const Address &address) {
+    for(int4 i=0;i<size;++i) {
+      uintb index = address.getOffset() + i - 0x100000913ULL;
+      ptr[i] = index < bytes.size() ? bytes[index] : 0x90;
+    }
+  }
+  virtual bool getInstructionField(const InstructionField &field,InstructionFieldUse use,Address &target) const {
+    queries.push_back(make_pair(field,use));
+    if (field.bitOffset != 0 || field.bitSize != field.size * 8 || field.bigEndian)
+      return false;
+    if (use == machine_value) {
+      if (supplyFullValue && field.source.getOffset() == 0x100000914ULL && field.size == 4)
+        return true;
+      return supplyValue && field.source.getOffset() == valueSource && field.size == valueSize;
+    }
+    if (!supplyTarget || field.source.getOffset() != 0x100000914ULL || field.size != 4)
+      return false;
+    target = Address(field.source.getSpace(),0x100000994ULL);
+    return true;
+  }
+  virtual string getArchType(void) const { return "x86"; }
+  virtual void adjustVma(long adjust) {}
+};
+
+struct FieldPcode {
+  OpCode opcode;
+  VarnodeData output;
+  bool hasOutput;
+  vector<VarnodeData> inputs;
+};
+
+class FieldPcodeEmit : public PcodeEmit {
+public:
+  vector<FieldPcode> ops;
+  virtual void dump(const Address &address,OpCode opcode,VarnodeData *output,VarnodeData *inputs,int4 size) {
+    FieldPcode op = {};
+    op.opcode = opcode;
+    op.hasOutput = output != (VarnodeData *)0;
+    if (op.hasOutput)
+      op.output = *output;
+    op.inputs.assign(inputs,inputs+size);
+    ops.push_back(op);
+  }
+};
+
+class FieldAssemblyEmit : public AssemblyEmit {
+public:
+  string body;
+  virtual void dump(const Address &address,const string &mnemonic,const string &text) { body = text; }
+};
+
+class FieldTranslation {
+public:
+  RelocatedFieldImage image;
+  ContextInternal context;
+  Sleigh sleigh;
+  FieldTranslation(const vector<uint1> &bytes) : image(bytes),sleigh(&image,&context) {
+    AttributeId::initialize();
+    ElementId::initialize();
+    istringstream xml(string("<sleigh>") + getenv("SLEIGHHOME") + "/x86-16-protected.sla</sleigh>");
+    DocumentStorage store;
+    Document *document = store.parseDocument(xml);
+    store.registerTag(document->getRoot());
+    sleigh.initialize(store);
+    sleigh.setContextDefault("addrsize",0);
+    sleigh.setContextDefault("opsize",0);
+    sleigh.setContextDefault("protectedMode",1);
+  }
+  Address entry(void) { return Address(sleigh.getDefaultCodeSpace(),0x100000913ULL); }
+};
+
+static const FieldPcode &fieldRegisterWrite(const FieldPcodeEmit &emit,const VarnodeData &reg) {
+  for(const FieldPcode &op : emit.ops) {
+    if (op.hasOutput && op.output.space == reg.space && op.output.offset == reg.offset && op.output.size == reg.size)
+      return op;
+  }
+  throw LowlevelError("Missing register write");
+}
+
+// INSTR.EXE at physical 0xb13 has 9a ff ff 00 00; ne.reloc.1.10 supplies the separate source and target facts.
+TEST(relocated_field_far_call) {
+  for(const vector<uint1> &bytes : vector<vector<uint1> >{
+      {0x9a,0xff,0xff,0,0}, {0x9a,0x94,9,1,0}, {0x9a,0x94,9,0x67,0x15}}) {
+    FieldTranslation translation(bytes);
+    FieldPcodeEmit emit;
+    ASSERT_EQUALS(translation.sleigh.instructionLength(translation.entry()),5);
+    FieldAssemblyEmit assembly;
+    ASSERT_EQUALS(translation.sleigh.printAssembly(assembly,translation.entry()),5);
+    ASSERT(translation.image.queries.empty());
+    ASSERT_EQUALS(translation.sleigh.oneInstruction(emit,translation.entry()),5);
+    const FieldPcode &cs = fieldRegisterWrite(emit,translation.sleigh.getRegister("CS"));
+    ASSERT_EQUALS(cs.opcode,CPUI_COPY);
+    ASSERT_EQUALS(cs.inputs.size(),1);
+    ASSERT_EQUALS(cs.inputs[0].space,translation.sleigh.getDefaultCodeSpace());
+    ASSERT_EQUALS(cs.inputs[0].offset,0x100000916ULL);
+    ASSERT_EQUALS(cs.inputs[0].size,2);
+    int4 calls = 0;
+    int4 stores = 0;
+    for(const FieldPcode &op : emit.ops) {
+      if (op.opcode == CPUI_CALL) {
+        ++calls;
+        ASSERT_EQUALS(op.inputs[0].space,translation.sleigh.getDefaultCodeSpace());
+        ASSERT_EQUALS(op.inputs[0].offset,0x100000994ULL);
+        ASSERT_EQUALS(op.inputs[0].size,6);
+      }
+      if (op.opcode == CPUI_STORE) {
+        ++stores;
+        ASSERT_EQUALS(op.inputs[2].size,2);
+      }
+    }
+    ASSERT_EQUALS(calls,1);
+    ASSERT_EQUALS(stores,2);
+    ASSERT_EQUALS(translation.sleigh.getRegister("SP").size,2);
+    bool fullSource = false;
+    for(const auto &query : translation.image.queries) {
+      if (query.second == code_reference && query.first.source.getOffset() == 0x100000914ULL && query.first.size == 4)
+        fullSource = true;
+    }
+    ASSERT(fullSource);
+  }
+}
+
+TEST(relocated_field_unrelated_constants) {
+  FieldTranslation translation({0x9a,2,0,2,0,0xb8,2,0});
+  FieldPcodeEmit emit;
+  translation.sleigh.oneInstruction(emit,translation.entry());
+  int4 decrementConstants = 0;
+  for(const FieldPcode &op : emit.ops) {
+    if (op.opcode == CPUI_INT_SUB && op.inputs[1].space == translation.sleigh.getConstantSpace() && op.inputs[1].offset == 2)
+      ++decrementConstants;
+  }
+  ASSERT_EQUALS(decrementConstants,2);
+  emit.ops.clear();
+  translation.sleigh.oneInstruction(emit,translation.entry()+5);
+  const FieldPcode &ax = fieldRegisterWrite(emit,translation.sleigh.getRegister("AX"));
+  ASSERT_EQUALS(ax.inputs[0].space,translation.sleigh.getConstantSpace());
+  ASSERT_EQUALS(ax.inputs[0].offset,2);
+  ASSERT_EQUALS(ax.inputs[0].size,2);
+}
