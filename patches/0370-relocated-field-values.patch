+  translation.image.supplyTarget = false;
+  translation.image.supplyFullValue = true;
+  FieldPcodeEmit emit;
+  bool refused = false;
+  try {
+    translation.sleigh.oneInstruction(emit,translation.entry());
+  } catch(LowlevelError &error) {
+    refused = error.explain.find("independent target") != string::npos;
+  }
+  ASSERT(refused);
+  ASSERT(emit.ops.empty());
+}
+
+} // End namespace ghidra
