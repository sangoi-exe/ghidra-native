+void SleighBuilder::applyFieldBinding(const VarnodeTpl *vntpl,VarnodeData &vn,InstructionFieldUse use)
+
+{
+  const ConstTpl &offset = vntpl->getOffset();
+  if (offset.getType() != ConstTpl::handle)
+    return;
+  const FieldBinding &binding = walker->getFieldBinding(offset.getHandleIndex());
+  if (binding.fields.empty())
+    return;
+  LoadImage *loader = walker->getParserContext()->getLoadImage();
+  vector<InstructionField> fields(binding.fields);
+  sort(fields.begin(),fields.end(),[](const InstructionField &a,const InstructionField &b) { return a.source < b.source; });
+  InstructionField combined = fields.front();
+  bool contiguous = true;
+  for(const InstructionField &field : fields) {
+    if (field.source.getSpace() != combined.source.getSpace() || combined.source + combined.size < field.source)
+      contiguous = false;
+    if (field.bitOffset != 0 || field.bitSize != field.size * 8 || field.bigEndian != combined.bigEndian)
+      contiguous = false;
+    if (contiguous) {
+      int4 end = (field.source.getOffset() - combined.source.getOffset()) + field.size;
+      if (end > combined.size)
+        combined.size = end;
+    }
+  }
+  combined.bitSize = combined.size * 8;
+  Address target;
+  bool supplied = contiguous && loader->getInstructionField(combined,use,target);
+  if (supplied && use == code_reference) {
+    if (offset.getSelect() != ConstTpl::v_offset || target.isInvalid())
+      throw LowlevelError("Unrepresentable relocated code-reference field");
+    vn.space = target.getSpace();
+    vn.offset = target.getOffset();
+    return;
+  }
+  if (use == code_reference || !binding.direct || !contiguous) {
+    if (use == code_reference && contiguous) {
+      Address unused;
+      if (loader->getInstructionField(combined,machine_value,unused))
+        supplied = true;
+    }
+    for(const InstructionField &field : fields) {
+      Address unused;
+      if (loader->getInstructionField(field,machine_value,unused))
+        supplied = true;
+    }
+    if (supplied)
+      throw LowlevelError("Relocated field requires an independent target or a direct machine-value use");
+    return;
+  }
+  if (!supplied)
+    return;
+  if (offset.getSelect() != ConstTpl::v_offset || vn.space != const_space || vn.size != (uint4)combined.size)
+    throw LowlevelError("Unrepresentable relocated machine-value field");
+  vn.space = combined.source.getSpace();
+  vn.offset = combined.source.getOffset();
+}
